                                    <CellContents>
                                      <Textbox Name="PROMEDIO_ATENCION3">
                                        <CanGrow>true</CanGrow>
                                        <KeepTogether>true</KeepTogether>
                                        <Paragraphs>
                                          <Paragraph>
                                            <TextRuns>
                                              <TextRun>
                                                <Value>=
Switch(Parameters!TipoPromedio.Value=1,
(right("0" &amp; int((Avg(Fields!SG_CA_LL.Value))/3600),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_CA_LL.Value)) Mod 3600)/60),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_CA_LL.Value)) Mod 3600) Mod 60),2)),
Parameters!TipoPromedio.Value=2,
right("0"&amp; Mid(int((Sum(Fields!SG_AS_LL.Value)/Count(IIF(Fields!CP_NUME_LLAMADA.Value&gt;0,1,0)))/3600).ToString(),1,2),2) &amp; ":" 
&amp; right("0"&amp; Mid(int(((Sum(Fields!SG_AS_LL.Value)/Count(IIF(Fields!CP_NUME_LLAMADA.Value&gt;0,1,0))) Mod 3600)/60),1,2),2) &amp; ":" 
&amp; right("0"&amp; Mid(int(((Sum(Fields!SG_AS_LL.Value)/Count(IIF(Fields!CP_NUME_LLAMADA.Value&gt;0,1,0))) Mod 3600) Mod 60),1,2),2),
Parameters!TipoPromedio.Value=3,
(right("0" &amp; int((Avg(Fields!SG_CA_TE.Value))/3600),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_CA_TE.Value)) Mod 3600)/60),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_CA_TE.Value)) Mod 3600) Mod 60),2)),
Parameters!TipoPromedio.Value=4,
(right("0" &amp; int((Avg(Fields!SG_AS_TE.Value))/3600),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_AS_TE.Value)) Mod 3600)/60),2) &amp; ":" 
&amp; right("0" &amp; int(((Avg(Fields!SG_AS_TE.Value)) Mod 3600) Mod 60),2))

)</Value>
                                                <Style>
