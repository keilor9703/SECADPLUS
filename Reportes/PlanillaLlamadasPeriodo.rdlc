&amp; right("0" &amp; int((Sum(Fields!EM_LLEGA_SEG.Value)/IIf(Count(Fields!EM_HORA_ASIGNA.Value)&gt;0,Count(Fields!EM_HORA_ASIGNA.Value),1)) Mod 3600) Mod 60,2)</Value>
