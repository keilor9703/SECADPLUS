  <oracle.manageddataaccess.client>
    <version number="4.121.2.0">
      <settings>
        <setting name="PerformanceCounters" value="4095" />
      </settings>
    </version>
    <version number="*">
      <dataSources>
        <dataSource alias="SampleDataSource" descriptor="(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=ORCL))) " />        
      </dataSources>
      <edmMappings>
        <edmNumberMapping>
          <add NETType="bool" MinPrecision="1" MaxPrecision="1" DBType="Number" />
          <add NETType="byte" MinPrecision="2" MaxPrecision="2" DBType="Number" />
          <add NETType="int16" MinPrecision="3" MaxPrecision="4" DBType="Number" />
          <add NETType="int32" MinPrecision="5" MaxPrecision="9" DBType="Number" />
          <add NETType="int64" MinPrecision="10" MaxPrecision="19" DBType="Number" />
        </edmNumberMapping>
      </edmMappings>
    </version>    
  </oracle.manageddataaccess.client> 
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="CONEXIONPORTNSNAME" value="NO" /><!--Control para que la aplicación utilice la cadena de conexion por TNSNAME que debe ser nombrado como DIRECTO-->
    <add key="CierreSesion" value="900" /><!--Tiempo en segundos de inactividad para cerrar la sesión-->    
    <add key="CantidadDeConexiones" value="200" /><!--Cantidad de conexiones maximas del pool de conexiones-->
    <add key="CantidadDeConexionesMinimo" value="60" /><!--Cantidad de conexiones minimas del pool de conexiones-->
    <add key="TiempoVidaConexion" value="14400" /><!--tiempo en segundos de vida de la conexion en el pool-->
    <add key="Incremento" value="20" /><!--Incremento de conexiones por demanda-->
    <add key="Decremento" value="2" /><!--Decremento de conexiones obsoletas-->
    <add key="OIDServidor" value="oud.policia.gov.co:389" /><!--Ruta del servidor para la utenticación por OID-->
    <add key="SitioGrabacion" value="9711" /><!--Sitio de grabación por defecto-->
    <add key="ConexionPorDefecto" value="SECAD123" /><!--Conexión a base de datos por defecto-->
    <add key="ServerName" value="SECADPLUS" /><!--Nombre del servico-->
    <add key="RespuestaNotificaciones" value="5000" /><!--Tiempo en milisegundos para la acutalización de notificaciones-->
    <add key="RangoConsultaNotificaciones" value="1440" /><!--Rango de tiempo en minutos para consultar notificaciones-->
    <add key="ActivarValidacionDNS" value="SI" /><!--Control para habilitar la identificación de nombre de máquina a tráves del DNS-->
    <add key="MapaBasePrincipal" value="streets" /><!--Control para habilitar la identificación de nombre de máquina a tráves del DNS-->
    <add key="MapaBaseSecundario" value="hybrid" /><!--Control para habilitar la identificación de nombre de máquina a tráves del DNS-->
    <add key="UsaICP" value="false" />
    <add key="UsaIVS" value="true" />
    <add key="UsaeLTE" value="true" />
    <add key="UsaSR" value="false" />
    <add key="Key" value="eSRNHg3qAzyACxQr+jIlMw==" />
