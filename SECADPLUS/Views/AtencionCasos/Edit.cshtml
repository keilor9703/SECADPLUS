@model SECADEntities.SECAD.CADCASOS_CANAL

@{
    ViewBag.Title = "Editar Caso";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/FormularioJs")
    @Scripts.Render("~/bundle/InputsJs")
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/ChosenJs")
}
<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Editar Caso:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                @using (Html.BeginForm("Edit", "AtencionCasos", FormMethod.Post, new { @class = "form-compact" }))
                {
                    <div class="panel-body">

                        <fieldset class="content-group">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.Hidden("CADCANA_FUERZ_ID")
                            @Html.Hidden("CADCANA_CODIGO")
                            @Html.Hidden("antiguoCodigo")
                            <div class="row">
                                <div class="col-md-12 col-lg-1 col-md-offset-2">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Caso:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.TextBoxFor(model => model.CADCASO_CODIGO, htmlAttributes: new { @class = "form-control ", placeholder = "Seleccione caso", @readonly = true })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-6">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Descripción:</label>
                                        <div class="row">
                                            <div class="input-group">
                                                @Html.TextBox("DESCRIPCION", null, htmlAttributes: new { @class = "form-control ", placeholder = "Seleccione caso", @readonly = true })
                                                <span class="input-group-btn">
                                                    <button type="button" onclick="cargarCasos('edita')" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                            title="" data-placement="bottom" data-original-title="Clic para buscar">
                                                        <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                    </button>
                                                </span>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.CADCASO_CODIGO, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla"
                                        onclick="window.location.href ='@Url.Action("Index", new { idFuerza = Model.CADCANA_FUERZ_ID, idCanal = Model.CADCANA_CODIGO })'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                        value="Edit">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <!-- /formulario -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
<!-- Modal Casos -->
<div id="ModalCasos" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Casos</h5>
            </div>
            <div class="modal-body form-compact">
                <table id="tablaCasosDH" class="table table-hover table-xxs datatable-basic modal_table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Caso -->
<script type="text/javascript">

    var urlTablaCasos = '@Url.Action("GetCasos", "AtencionCasos")';
</script>

@Scripts.Render("~/bundle/AtencionCasosJs")