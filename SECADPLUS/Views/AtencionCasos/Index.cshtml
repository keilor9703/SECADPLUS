@using SECADPLUS.Models.Extendidas;
@model List<ExtCasosCanal>

@{
    ViewBag.Title = "Referencie los Casos que atenderá este canal de despacho";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/FormularioJs")
    @Scripts.Render("~/bundle/InputsJs")
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/ChosenJs")
}

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row  form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Proceso Automático:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            @*<li><a data-action="collapse"></a></li>*@
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                <form class="form-compact" action="#">
                    <div class="panel-body">
                        @*<div class="col-md-12">*@
                        <div class="col-xs-12 col-md-8">
                            <h5>Referencie los Casos que atenderá este canal de despacho: @ViewBag.CANAL</h5>
                        </div>
                        <div class="col-xs-12 col-md-4 button_sitios_grabacion">
                            <button type="button" class="btn btn-success btn-xs" onclick="Procesar()">
                                <b><i class="glyphicon glyphicon-import"></i></b>Procesar
                            </button>
                        </div>
                        @*</div>*@

                        @Html.Hidden("idFuerza")
                        @Html.Hidden("idCanal")
                        <div class="row">
                            <div class="col-md-4 col-md-offset-2">
                                <div class="input-group">
                                    @Html.TextBox("CADCASO_CODIGO_DESDE", null, htmlAttributes: new { @class = "form-control ", placeholder = "Seleccione caso", @readonly = true })
                                    <span class="input-group-btn">
                                        <button type="button" onclick="cargarCasos('desde')" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                title="" data-placement="bottom" data-original-title="Clic para buscar">
                                            <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                        </button>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group">
                                    @Html.TextBox("CADCASO_CODIGO_HASTA", null, htmlAttributes: new { @class = "form-control ", placeholder = "Seleccione caso", @readonly = true })
                                    <span class="input-group-btn">
                                        <button type="button" onclick="cargarCasos('hasta')" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                title="" data-placement="bottom" data-original-title="Clic para buscar">
                                            <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
                <!-- /formulario -->
                <div class="panel-heading">
                    <h5 class="panel-title">Proceso Manual:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo"
                                        onclick="IrCrearManual(_idFuerza, _idCanal) ">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaCasos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td></td>
                                <td>
                                    <ul class="icons-list">
                                        <li class="dropdown">
                                            <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat
                                                                dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                                                <i class="icon-menu9"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-left">
                                                <li>
                                                    <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                                            title="" data-placement="bottom" data-original-title="Clic para editar"
                                                            onclick="window.location.href ='@Url.Action("Edit", new { id = item.CADCASO_CODIGO, idFuerza = item.CADCANA_FUERZ_ID, idCanal = item.CADCANA_CODIGO })'">
                                                        <i class="glyphicon glyphicon-edit"></i> Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                                            title="" data-placement="bottom" data-original-title="Clic para eliminar"
                                                            onclick="EliminarRegistroGeneral('@Url.Action("Eliminar", "AtencionCasos", new { id = item.CADCASO_CODIGO, idFuerza = item.CADCANA_FUERZ_ID, idCanal = item.CADCANA_CODIGO })')">
                                                        @*onclick="window.location.href ='@Url.Action("Delete", new { id = item.CADCASO_CODIGO, idFuerza = item.CADCANA_FUERZ_ID, idCanal = item.CADCANA_CODIGO })'">*@
                                                        <i class="icon-trash"></i> Eliminar
                                                    </button>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.DESCRIPCION)</td>
                                <td>@Html.DisplayFor(modelItem => item.CADCASO_CODIGO)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
    <div class="panel-footer">
        <div class="row">
            <div class="col-xs-6 col-md-6 text-left">
                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                        data-original-title="Clic para regresar a la tabla"
                        onclick="window.location.href ='@Url.Action("Index","Canales", new { fuerzaId = @ViewBag.idFuerza })'">
                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Casos -->
<div id="ModalCasos" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Casos</h5>
            </div>
            <div class="modal-body form-compact">
                <table id="tablaCasosDH" class="table table-hover table-xxs datatable-basic modal_table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Caso -->
<!-- Área de contenido -->
<script type="text/javascript">
        @*var _idCaso = '@ViewBag.COD_CASO';
        var _nomCaso = '@ViewBag.NOM_CASO';*@

    var _idFuerza = @ViewBag.idFuerza;
    var _idCanal = @ViewBag.idCanal;

    var urlTablaCasos = '@Url.Action("GetCasos", "AtencionCasos")';

    var urlCasos = '@Url.Action("GetCasos", "AtencionCasos")';
    var urlCrear = '@Url.Action("Create", "AtencionCasos")';
    var urlProcesar = '@Url.Action("ProcesarCasosCanal", "AtencionCasos")';
    var urlIndex = '@Url.Action("Index", "AtencionCasos")';
</script>
@Scripts.Render("~/bundle/AtencionCasosJs")