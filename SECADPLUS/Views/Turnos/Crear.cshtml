@model SECADEntities.SecadEntities.CADTURNO
@section scripts{    
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
}
<div class="content">
    @Html.Partial("_Mensajes")
    <div id="resultadoAjax"></div>
    <div class="row">
        <!-- Formulario -->
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h5 class="panel-title">Creación Turno</h5>
                <div class="heading-elements">
                    <ul class="icons-list ">
                        <li><a data-action="collapse"></a></li>
                    </ul>
                </div>
            </div>
            @using (Html.BeginForm("Crear", "Turnos", FormMethod.Post, new { @class = "" }))
            {
                <div class="panel-body">

                    <fieldset class="content-group">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.SITIO_GRABA, new {  Value = ViewBag.SITIO })
                        @Html.HiddenFor(model => model.TURNO, new { Value = 0 })
                        @Html.HiddenFor(model => model.CADFUERZ_ID, new { Value = ViewBag.ENTIDAD, id= "hdEntidad" })
                        <input type="hidden" id="hdHorasTurno" value="@ViewBag.HorasFuerza" />
                        <input type="hidden" id="hdSitioNombre" name="SitioNombre" value="@ViewBag.SITIONOMBRE" />
                        <input type="hidden" id="hdEntidadNombre" name="EntidadNombre" value="@ViewBag.ENTIDADNOMBRE"  />
                        <div class="row form-compact">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                @Html.LabelFor(model => model.TURNO, "Turno", htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12 ">
                                    @Html.TextBoxFor(model => model.TURNO, new { @class = "form-control", @readonly = true })
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                @Html.LabelFor(model => model.CLASE_TURNO, htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12 ">
                                    @Html.DropDownList("CLASE_TURNO", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                    @Html.ValidationMessageFor(model => model.CLASE_TURNO, "", new { @class = "text-danger text-size-mini" })
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                @Html.LabelFor(model => model.TIPO_TURNO, htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-md-12 ">
                                    @Html.DropDownList("TIPO_TURNO", null, string.Empty, new { @class = "chosen-select", id="ddlTipoTurno" })
                                    @Html.ValidationMessageFor(model => model.TIPO_TURNO, "", new { @class = "text-danger text-size-mini" })
                                </div>
                            </div>
                            
                        </div>

                        <div class="row">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                <div class="form-group col-lg-12 form-compact">
                                    @Html.LabelFor(model => model.HORA_INICIA, htmlAttributes: new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="icon-calendar"></i></span>
                                        @Html.EditorFor(model => model.HORA_INICIA, new { htmlAttributes = new { @class = "form-control FechaHora", id = "fecha_inicia" } })                                        
                                    </div>
                                    @Html.ValidationMessageFor(model => model.HORA_INICIA, "", new { @class = "text-danger text-size-mini" })
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                <div class="form-group col-lg-12 form-compact">
                                    @Html.LabelFor(model => model.HORA_TERMINA, htmlAttributes: new { @class = "control-label" })
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="icon-calendar"></i></span>
                                        @Html.EditorFor(model => model.HORA_TERMINA, new { htmlAttributes = new { @class = "form-control FechaHora", id = "fecha_termina" } })
                                        
                                    </div>
                                    @Html.ValidationMessageFor(model => model.HORA_TERMINA, "", new { @class = "text-danger text-size-mini" })
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                @Html.LabelFor(model => model.CONSIGNAS, htmlAttributes: new { @class = "control-label col-md-6" })
                                <div class="col-md-12">
                                    @Html.TextAreaFor(model => model.CONSIGNAS, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.CONSIGNAS, "", new { @class = "text-danger text-size-mini", rows=4 })
                                </div>
                            </div>
                        </div>
                        <div class="row form-compact">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                
                                <div class="form-group col-lg-12">
                                    @Html.LabelFor(model => model.DIA_INICIA, htmlAttributes: new { @class = "control-label" })
                                @Html.EditorFor(model => model.DIA_INICIA, new { htmlAttributes = new { @class = "form-control", id = "txtDiaInicia", @readonly="ReadOnly" } })
                                @Html.ValidationMessageFor(model => model.DIA_INICIA, "", new { @class = "text-danger text-size-mini" })                                    
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                
                                <div class="form-group col-lg-12">
                                    @Html.LabelFor(model => model.DIA_TERMINA, htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(model => model.DIA_TERMINA, new { htmlAttributes = new { @class = "form-control", id = "txtDiaTermina", @readonly = "ReadOnly" } })
                                    @Html.ValidationMessageFor(model => model.DIA_TERMINA, "", new { @class = "text-danger text-size-mini" })
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-xs-6 col-md-6text-left">
                            @Html.ActionLink("Regresar", "Turnos", new { intSitioGrabacion = ViewBag.SITIO, strNombre = ViewBag.SITIONOMBRE, intEntidad=ViewBag.ENTIDAD, strEntidad=ViewBag.ENTIDADNOMBRE }, new { @class = "btn bg-teal", data_popup = "tooltip", title = "", data_placement = "bottom", data_original_title = "Clic para finalizar" })
                        </div>
                        <div class="col-xs-6 col-md-6 text-right">
                            <button class="btn bg-teal" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para guardar cambios">
                                <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- /formulario -->
    </div>
</div>
@section PostScripts{
    @Scripts.Render("~/bundle/TurnosJs")
    <script>

        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////


        var urlObtenerSiguienteFecha = "@Url.Action("ObtenerSiguienteFecha", "Turnos")";
        InicializarElementos("CREAR");
    </script>
}
