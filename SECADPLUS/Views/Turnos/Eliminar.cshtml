@model SECADEntities.SecadEntities.CADTURNO
@{
    ViewBag.Title = "Delete";
}
@Html.Partial("_Mensajes")
@if (Model != null)
{
    <h3>¿Esta seguro de eliminar el registro?</h3>
    <div>
        <h4>@Html.DisplayFor(model => model.TURNO) @ViewBag.SITIONOMBRE</h4>
        @using (Html.BeginForm("Delete", "TURNOS", new { intSitio = Model.SITIO_GRABA, lgConsecutivo = Model.TURNO, strSitio = ViewBag.SITIONOMBRE, intEntidad = ViewBag.ENTIDAD, strEntidad = ViewBag.ENTIDADNOMBRE }, FormMethod.Post, new { @class = "form_secad", @id = "form_eliminar" }))
        {
            @Html.AntiForgeryToken()
        }
    </div>

}
