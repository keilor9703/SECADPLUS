@{
    ViewBag.Title = "Minutas";
}
<link href="~/Content/Cargando.css" rel="stylesheet" />

@section PostScripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/TablasJs")

    <script>
        AplicarChosen();

        $("#ddlUnidad").change(function () {
            var valor = document.getElementById("ddlUnidad").value;
            CargarMinutaGv("tblMinutaSivicc",valor);
        })

        function AplicarChosen() {
            $(".chosen-select").chosen({ allow_single_deselect: false, width: "100%" });
            $("#ddlUnidad").click(
                function (e) {
                    e.preventDefault();
                    return;
                }
            );
        }

        $(document).ajaxStart(function () {
            $("#Process").show();
        });
        $(document).ajaxStop(function () {
            $("#Process").hide();
        });

        function CargarMinutaGv(tablaId, UnidadId) {

            var datos = { "UnidadId": UnidadId };
            var UrlConsultarMinuta = "@Url.Action("F_GetMinuta", "Sivicc")";

            if ($.fn.dataTable.isDataTable("#" + tablaId)) {
                $("#" + tablaId).DataTable().destroy();
            }
            $("#" + tablaId).DataTable({
                "ajax": {
                    url: UrlConsultarMinuta,
                    type: "POST",
                    datatype: "json",
                    data: { 'UnidadId': UnidadId }
                },
                "columns": [
                    { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) { return ''; } },
                    { "data": "Funcionario", "name": "Funcionario", className: "celdaJust" },
                    { "data": "Turno", "name": "Turno", className: "celdaCenter" },
                    { "data": "Unidad", "name": "Unidad", className: "celdaCenter" },
                    { "data": "TipoMinuta", "name": "TipoMinuta", className: "celdaJust" },
                    { "data": "Inicio", "name": "Inicio", className: "celdaCenter" },
                    { "data": "Fin", "name": "Fin", className: "celdaJust" },
                    { "data": "Cuadrante", "name": "Cuadrante", className: "celdaCenter" },

                    { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) {   return ''; } },
                        { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) { return ''; } },
                        { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) { return ''; } }
                ],
                "rowCallback": function (row, data, index) {

                    if (data.Arma == 0) {
                        $(row).find('td:eq(8)').addClass('iconArmano');
                        //$(row).find('td:eq(8)').attr('onclick', 'AbrirModalArma(' + "'" + data.MinutaEmplId + "'" + ')');
                        //$(row).find('td:eq(8)').attr('onclick', 'AbrirModalArma(' + data.MinutaEmplId + ')');
                    }
                    else {
                        $(row).find('td:eq(8)').addClass('iconArma');
                        //$(row).find('td:eq(8)').attr('onclick', 'AbrirModalArma(' + "'" + data.MinutaEmplId + "'" + ')');
                        $(row).find('td:eq(8)').attr('onclick', 'AbrirModalArma(' + data.MinutaEmplId + ')');
                    }

                    if (data.Veh == 0) {
                        $(row).find('td:eq(9)').addClass('ValidaAsignacion icon icon-truck');
                        $(row).find('td:eq(9)').attr('onclick', 'AbrirModalVehiculo(' + data.MinutaEmplId + ')');                        
                    }
                    else {
                        $(row).find('td:eq(9)').addClass('icon icon-truck');//AbrirModalVehiculo
                    }

                    if (data.Comunica == 0) {
                        $(row).find('td:eq(10)').addClass('iconComunicano');
                    }
                    else {
                        $(row).find('td:eq(10)').addClass('iconComuni');//AbrirModalComunicaciones
                        $(row).find('td:eq(10)').attr('onclick', 'AbrirModalComunicaciones(' + data.MinutaEmplId + ')');
                    }

                },

                    responsive: true,
                    rowReorder: true,
                    autoWidth: false,
                    dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
                    language: glOpcionesIdioma,
                });
                $('.dataTables_filter input[type=search]').attr('placeholder', 'Buscar...');
                $('.dataTables_length select').select2({
                    minimumResultsForSearch: Infinity,
                    width: 'auto'
                });
        }

        function AbrirModalArma(armaId) {
            //$("#datoCuadrante").html("<span>" + armaId +"</span>");
            //$("#abrirModalArma").modal("show");
            var valor = armaId;
            CargarArmasEmplGv("tblArmasSivicc", valor);
            $("#abrirModalArma").modal("show");
        };

        function CargarArmasEmplGv(tablaId, P_MinEmplId) {

            var datos = { "P_MinEmplId": P_MinEmplId };
            var UrlConsultarMinuta = "@Url.Action("F_GetArmasEmpl", "Sivicc")";

