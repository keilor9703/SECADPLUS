                },
                "columns": [
                    { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) { return ''; } },
                    { "data": "TipoElemento", "name": "TipoElemento", className: "celdaJust" },
                    { "data": "Marca", "name": "Marca", className: "celdaCenter" },
                    { "data": "Modelo", "name": "Modelo", className: "celdaCenter" },
                    { "data": "Sigla", "name": "Sigla", className: "celdaJust" },
                    { "data": "Placa", "name": "Placa", className: "celdaCenter" },
                    { "data": "Estado", "name": "Estado", className: "celdaJust" },
                    { "data": "IdInventario", "name": "IdInventario", className: "celdaCenter" }
                ],
                "rowCallback": function (row, data, index) {
                },
                    responsive: true,
                    rowReorder: true,
                    autoWidth: false,
                    dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
                    language: glOpcionesIdioma,
                });
                $('.dataTables_filter input[type=search]').attr('placeholder', 'Buscar...');
                $('.dataTables_length select').select2({
                    minimumResultsForSearch: Infinity,
                    width: 'auto'
                });
        }

        function AbrirModalComunicaciones(armaId) {
            var valor = armaId;
            CargarComunicacionesEmplGv("tblComunicacionesSivicc", valor);
            $("#abrirModalComunicaciones").modal("show");
        };

        function CargarComunicacionesEmplGv(tablaId, P_MinEmplId) {

            var datos = { "P_MinEmplId": P_MinEmplId };
            var UrlConsultarMinuta = "@Url.Action("F_GetComunicaEmpl", "Sivicc")";

            if ($.fn.dataTable.isDataTable("#" + tablaId)) {
                $("#" + tablaId).DataTable().destroy();
            }
            $("#" + tablaId).DataTable({
                "ajax": {
                    url: UrlConsultarMinuta,
                    type: "POST",
                    datatype: "json",
                    data: { 'P_MinEmplId': P_MinEmplId }
                },
                "columns": [
                    { "data": null, className: "celdaCenter", "width": "1%", "render": function (data, type, row) { return ''; } },
                    { "data": "TipoElemento", "name": "TipoElemento", className: "celdaJust" },
                    { "data": "Marca", "name": "Marca", className: "celdaCenter" },
                    { "data": "Modelo", "name": "Modelo", className: "celdaCenter" },
                    { "data": "Serie", "name": "Serie", className: "celdaJust" },
                    { "data": "Estado", "name": "Estado", className: "celdaCenter" },
                    { "data": "IdInventario", "name": "IdInventario", className: "celdaJust" }
                ],
                "rowCallback": function (row, data, index) {
                },
                    responsive: true,
                    rowReorder: true,
                    autoWidth: false,
                    dom: '<"datatable-header"fl><"datatable-scroll"t><"datatable-footer"ip>',
                    language: glOpcionesIdioma,
                });
                $('.dataTables_filter input[type=search]').attr('placeholder', 'Buscar...');
                $('.dataTables_length select').select2({
                    minimumResultsForSearch: Infinity,
                    width: 'auto'
                });
        }

    </script>

}
<div class="content">


    <div class="panel panel-flat" style="border-radius: 17px 17px 0px 0px !important;">
        <div class="panel-heading" style="background-image: url(../img/FondoVerdeT.png); border-radius: 17px 17px 0px 0px !important;">
            <h5 class="panel-title" style="color:white">Seleccione Unidad</h5>
            <div class="heading-elements" style="color:white">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
        <div class="panel-body">
            @Html.AntiForgeryToken()

            <div class="col-md-12">
                <div class="form-horizontal">
                    <div class="form-group">
                        <label class="control-label col-md-2 label_gecop">Estación de Policía:</label>
                        <div class="col-md-4">
                            @Html.DropDownList("ddlUnidad", null, htmlAttributes: new { @class = "form-control chosen-select althei", style = "width: 100%;", @id = "ddlUnidad", @tabindex = 3 })
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div class="panel panel-flat" style="border-radius: 17px 17px 0px 0px !important;">
        <div class="panel-heading" style="background-image: url(../img/FondoVerdeT.png); border-radius: 17px 17px 0px 0px !important;">
            <h5 class="panel-title" style="color:white">Minuta SIVICC</h5>
            <div class="heading-elements" style="color:white">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
        <div class="panel-body">
            @Html.AntiForgeryToken()

            <div class="col-md-12">
                <table class="table table-hover table-xxs datatable-basic" id="tblMinutaSivicc">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Funcionario</th>
                            <th>Turno</th>
                            <th>Unidad</th>
                            <th>Tipo Minuta</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th>Cuadrante</th>
                            <th>AR</th>
                            <th>VEH</th>
                            <th>COM</th>

                        </tr>
                    </thead>
                </table>

            </div>
        </div>
    </div>

</div>

<div id="Process">
    <div class="loader_sis">
        <div class="loader_dialoge">
            <div class="loader_containere text-center">
                <div class="loadere"></div>
                <h4 class="text-white">Ejeutando consulta, espere...</h4>
            </div>
        </div>
    </div>
    <div class="loader_backe"></div>
</div>

<!--MODAL ARMA-->
<div class="modal fade" id="abrirModalArma" style="border-radius: 17px 17px 0px 0px !important;">
