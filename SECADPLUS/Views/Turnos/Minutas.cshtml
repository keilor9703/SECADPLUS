                });
        }

        function AbrirModalVehiculo(armaId) {
            var valor = armaId;
            CargarVehiculoEmplGv("tblVehiculoSivicc", valor);
            $("#abrirModalVehiculo").modal("show");
        };

        function CargarVehiculoEmplGv(tablaId, P_MinEmplId) {

            var datos = { "P_MinEmplId": P_MinEmplId };
