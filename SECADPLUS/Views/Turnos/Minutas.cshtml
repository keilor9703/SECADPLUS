                <h4 class="modal-title">Armamento</h4>
                <button type="button" class="close" data-dismiss="modal">X</button>
            </div>

            <!-- cuerpo del diálogo -->
            <div class="modal-body">
                @*<div id="datoCuadrante"></div>*@
                @*Contenido del diálogo.*@
                <div class="panel panel-flat" style="border-radius: 17px 17px 0px 0px !important;">
                    <div class="panel-heading" style="background-image: url(../img/FondoVerdeT.png); border-radius: 17px 17px 0px 0px !important;">
                        <h5 class="panel-title" style="color:white">Detalle</h5>
