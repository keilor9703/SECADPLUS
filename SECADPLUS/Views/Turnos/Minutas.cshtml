                                        <th>Calibre</th>
                                        <th>Serie</th>
                                        <th>Estado</th>
                                        <th>Id Inventario</th>

                                    </tr>
                                </thead>
                            </table>

                        </div>
                    </div>
                </div>
            </div>

            <!-- pie del diálogo -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>
