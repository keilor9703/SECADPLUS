@*@model IEnumerable<SECADEntities.SECAD.CADEQUIPOS>*@
@using SECADEntities.SECAD;
@model Tuple<List<CADEQUIPOS>, List<CADCONEXION>>

@{
    ViewBag.Title = "Equipos de Computo del Sitio de Grabación";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Equipos de Computo del Sitio de Grabación:</h5>
                    <div class="computo_input">
                        @Html.Editor("DESCRIPCION", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    </div>

                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo equipo de computo"
                                        onclick="window.location.href ='@Url.Action("Create", new { id = @ViewBag.idSitio, nom = @ViewBag.DESCRIPCION })'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo equipo
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaEquipos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Sitio de Grabación</th>
                            <th>Identificación</th>
                            <th>Descripción</th>
                            <th>Acd</th>
                            <th>Conexion Form</th>
                            <th>Ubicación</th>
                            <th>Serie</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>

    <div class="row  form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Equipos Conectados</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">
                            
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaConexiones">
                    <thead>
                        <tr>
                            <th></th>
                            @*<th>Acciones</th>*@
                            <th>Sitio de Grabación</th>
                            <th>Equipo</th>
                            <th>Usuario Conectado</th>
                            <th>Sesion Id</th>
                            <th>Fecha</th>
                            <th>Fecha Hasta</th>
                            <th>Vigente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            Html.RenderPartial("_resultadoConexiones", Model.Item2);
                        }
                    </tbody>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xs-6 col-md-6 text-left">
            <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                    data-original-title="Clic para regresar a la tabla"
                    onclick="window.location.href ='@Url.Action("Index","SitiosGrabacion")'">
                <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
            </button>
        </div>
    </div>
</div>
<!-- /área de contenido -->
<script type="text/javascript">
    var _idSitio = @ViewBag.idSitio;
    var _nom = '@ViewBag.DESCRIPCION';

    var urlTabla = '@Url.Action("GetEquiposComputo", "EquiposSitioGrabacion")'+ "?id=" + _idSitio + "&nom=" + _nom;
    var urlConexiones ='@Url.Action("GetConexionesEquipos", "EquiposSitioGrabacion")'
    var urlVigente ='@Url.Action("EditaConexionVigente", "EquiposSitioGrabacion")'

</script>

@section PostScripts{
    @Scripts.Render("~/bundle/CheckSwitchJs");
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/EquiposSitioGrabacionJs")
}