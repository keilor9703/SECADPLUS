@model IEnumerable<SECADEntities.SecadEntities.CADNETROLPERFIL>

@{
    ViewBag.Title = "Index";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")

}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Asociación de perfiles a roles</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip" onclick="location.href='@Url.Action("Create", "RolPerfil")'"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo Registro">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo Registro
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <table class="table table-hover table-xxs datatable-basic" id="tablaRolPerfil">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>
                                Rol
                            </th>
                            <th>
                                Perfil
                            </th>
                            <th>
                                Fecha de creaci&oacute;n
                            </th>
                            <th>
                                Estado

                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td></td>
                                <td>
                                    <ul class="icons-list">
                                        <li class="dropdown">
                                            <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat dropdown-toggle"
                                                    data-toggle="dropdown" aria-expanded="true">
                                                <i class="icon-menu9"></i>
                                            </button>
                                            <ul class="dropdown-menu secad two_btn dropdown-menu-left">
                                                <li>
                                                    <button class="btn btn-default " type="button"
                                                            data-toggle="modal" data-target="#modal_form_horizontal" data-popup="tooltip" onclick="location.href='@Url.Action( "Edit", new { rol_id=item.ROL_ID, perfil_id = item.PERFIL_ID  })'"
                                                            data-placement="bottom" data-original-title="Clic para editar">
                                                        <i class="glyphicon glyphicon-edit"></i> Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="btn btn-default " type="button" data-popup="tooltip" onclick="EliminarElemento('@Url.Action( "Eliminar", new { rol_id = item.ROL_ID, perfil_id = item.PERFIL_ID })')"
                                                            data-placement="bottom" data-original-title="Clic para eliminar">
                                                        <i class="icon-trash"></i> Eliminar
                                                    </button>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CADNETROLE.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.CADNETPERFIL.PERFIL_NOMBRE)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.FECHA_CREACION)
                                </td>
                                <td>
                                    @if (item.ESTADO == true)
                                    {
                                        <span class="label label-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Inactivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>
@section PostScripts{
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/PnotifyJs")

    <script>
        AplicarPluginTabla("tablaRolPerfil");
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
    @if (ViewData["MENSAJE"] != null)
    {
        <script>
            GenerarPnotifyAlert('@ViewData["MENSAJE"]', 'ERROR');            
        </script>

    }
}

