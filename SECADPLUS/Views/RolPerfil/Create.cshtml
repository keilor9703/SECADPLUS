@model SECADEntities.SecadEntities.CADNETROLPERFIL
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
}
<!-- Content area -->
<div class="content">
    <!-- Formulario 1 -->
    @Html.Partial("_Mensajes")
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Creación de Registro</h5>
            <div class="heading-elements">
                <ul class="icons-list ">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
@using (Html.BeginForm("Create", "RolPerfil", FormMethod.Post, new { @class = "form-compact" }))
            {
        <div class="panel-body">
            
                @Html.AntiForgeryToken()
                <fieldset class="content-group">
                    <div class="row">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group col-md-3 col-lg-3 obligatorio">                            
                            @Html.LabelFor(model => model.ROL_ID, "Rol", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-12 form-group">

                                @Html.DropDownList("ROL_ID", null, string.Empty, htmlAttributes: new { @class = "form-control chosen", @onchange="this.form.submit();" })
                                @Html.ValidationMessageFor(model => model.ROL_ID, "El campo Rol es Obligatorio", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group col-md-3 col-lg-3 obligatorio">
                            @Html.LabelFor(model => model.PERFIL_ID, "Perfil", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-12 form-group">
                                @Html.DropDownList("PERFIL_ID", null, string.Empty, htmlAttributes: new { @class = "form-control chosen" })
                                @Html.ValidationMessageFor(model => model.PERFIL_ID, "El campo Perfil es obligatorio", new { @class = "text-danger" })
                            </div>
                            
                        </div>     
                        <div class="form-group col-md-3 col-lg-3 obligatorio">
                            <div class="form-group">
                                @Html.LabelFor(model => model.ESTADO, htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-12">
                                    @Html.CheckBoxFor(model => model.ESTADO, htmlAttributes: new { @class = "switch checkbox checkbox-switch", data_size = "mini", data_on_color = "success", data_off_color = "danger", data_on_text = "ACTIVO", data_off_text = "INACTIVO", @checked = "checked" })
                                    @Html.ValidationMessageFor(model => model.ESTADO, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>                   
                    </div>  
                    
                </fieldset>
            
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-xs-6 col-md-6text-left">
                    <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                            data-original-title="Clic para regresar a la tabla" onclick="location.href='@Url.Action("Index")'">
                        <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                    </button>
                </div>
                <div class="col-xs-6 col-md-6 text-right">
                    <button class="btn bg-teal" data-popup="tooltip" name="btnGuardar" value="Guardar"
                            title="" data-placement="bottom" data-original-title="Clic para guardar cambios">
                        <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                    </button>
                </div>
            </div>
        </div>
            }
    </div>
    <!-- /formulario 1 -->
</div>
<!-- /content area -->
@section PostScripts{
    
    @Scripts.Render("~/bundle/CheckSwitchJs");
<script>
        $(function () {
            $(".chosen").chosen({ allow_single_deselect: true });
        });
</script>
}