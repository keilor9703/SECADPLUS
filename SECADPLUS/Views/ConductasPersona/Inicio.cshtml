@model SECADEntities.SecadEntities.CADCONDTURNOPER
@{
    ViewBag.Title = "Inicio";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
    }
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Personas Relacionadas con la Conducta</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">
                           
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row">                        
                        @using (Html.BeginForm("Crear", "ConductasPersona", FormMethod.Post, new { @class = "" , id="formPersonas"}))
                            {
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.SITIO_GRABA, new { @class = "form-control", Value = @ViewBag.SitioId })
                            @Html.HiddenFor(model => model.CONSECUTIVO, new { @class = "form-control", Value = 0, id="consecutivoPersona" })
                            @Html.HiddenFor(model => model.CADCONDTURNSITGR, new { @class = "form-control", Value = ViewBag.SitioId })
                            @Html.HiddenFor(model => model.CADCONDTURNTURNO, new { @class = "form-control", Value = ViewBag.Turno })
                            @Html.HiddenFor(model => model.CADCONDTURNCOND, new { @class = "form-control", Value = ViewBag.Conducta })
                            @Html.HiddenFor(model => model.MAQUINA_TRANSACCION, new { @class = "form-control" })
                            @Html.HiddenFor(model => model.FECHA_TRANSACCION, new { @class = "form-control" })
                            @Html.HiddenFor(model => model.USUA_TRANSACCION, new { @class = "form-control" })
                            <input type="hidden" value="@ViewBag.Entidad" name="hdEntidad" id="hdEntidad" />
                            <input type="hidden" value="@ViewBag.EntidadId" name="hdEntidadId" id="hdEntidadId" />
                            <input type="hidden" value="@ViewBag.Evento" name="hdEvento" id="hdEvento" />
                            <input type="hidden" value="@ViewBag.EventoMedio" name="hdEventoMedio" id="hdEventoMedio" />
                            <input type="hidden" value="@ViewBag.EventoFecha" name="hdFechaEvento" id="hdFechaEvento" />
                            <div class="">
                                @Html.AntiForgeryToken()
                                <fieldset class="content-group">
                                    <div class="row">
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.IDENTIFICACION, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.IDENTIFICACION, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.IDENTIFICACION, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.TIPO_ID, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.DropDownList("TIPO_ID", null, string.Empty, htmlAttributes: new { @class = "form-control chosen-select" })
                                                @Html.ValidationMessageFor(model => model.TIPO_ID, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.APELLIDOS, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.APELLIDOS, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.APELLIDOS, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.NOMBRES, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.NOMBRES, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.NOMBRES, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group ">
                                            @Html.LabelFor(model => model.GENERO, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.DropDownList("GENERO", null, string.Empty, htmlAttributes: new { @class = "form-control chosen-select" })
                                                @Html.ValidationMessageFor(model => model.GENERO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-4 col-md-4 text-left  ">
                                            @Html.LabelFor(model => model.INFRACCION, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="row col-md-12">
                                                <div class="col-md-3">@Html.EditorFor(model => model.INFRACCION, new { htmlAttributes = new { @class = "form-control ", @readonly = true, id = "txtInfraccion" } })</div>
                                                <div class="col-md-9"><input type="text" readonly id="txtInfDesc" class="form-control" value="@ViewBag.InfraccionDesc" /></div>
                                                @Html.ValidationMessageFor(model => model.INFRACCION, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-4 col-md-4 text-left form-group ">
                                            @Html.LabelFor(model => model.CONDCODIGO, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="row col-md-12">
                                                <div class="col-md-3">@Html.EditorFor(model => model.CONDCODIGO, new { htmlAttributes = new { @class = "form-control", @readonly = true, id = "txtConductas" } })</div>
                                                <div class="col-md-9"><input type="text" readonly id="txtCondDesc" class="form-control" value="@ViewBag.CondicionDesc"/></div>
                                                @Html.ValidationMessageFor(model => model.CONDCODIGO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group ">
                                            @Html.LabelFor(model => model.CADEVENNUMEEVENTO, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.HiddenFor(model => model.CADEVENSITIOGRABA, new { htmlAttributes = new { @class = "form-control", id = "hdSitio" } })
                                                @Html.EditorFor(model => model.CADEVENNUMEEVENTO, new { htmlAttributes = new { @class = "form-control", @readonly = true, id = "txtEvento" } })
                                                @Html.ValidationMessageFor(model => model.CADEVENNUMEEVENTO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.FECHA_CONDUCTA, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                <div class="input-group">
                                                    <span class="input-group-addon"><i class="icon-calendar"></i></span>
                                                    @Html.EditorFor(model => model.FECHA_CONDUCTA, new { htmlAttributes = new { @class = "form-control FechaHora", id = "fecha_conducta" } })
                                                </div>
                                                @Html.ValidationMessageFor(model => model.FECHA_CONDUCTA, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xs-2 col-md-2 text-left form-group ">
                                            @Html.LabelFor(model => model.MODOCONDUCTA, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.DropDownList("MODOCONDUCTA", null, string.Empty, htmlAttributes: new { @class = "form-control chosen-select" })
                                                @Html.ValidationMessageFor(model => model.MODOCONDUCTA, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group ">
                                            @Html.LabelFor(model => model.PARTCONDUCTA, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.DropDownList("PARTCONDUCTA", null, string.Empty, htmlAttributes: new { @class = "form-control chosen-select" })
                                                @Html.ValidationMessageFor(model => model.PARTCONDUCTA, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group obligatorio">
                                            @Html.LabelFor(model => model.RELACONDUCTA, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.DropDownList("RELACONDUCTA", null, string.Empty, htmlAttributes: new { @class = "form-control chosen-select" })
                                                @Html.ValidationMessageFor(model => model.RELACONDUCTA, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                        <div class="col-xs-2 col-md-2 text-left form-group ">
                                            @Html.LabelFor(model => model.OBSERVACIONES, htmlAttributes: new { @class = "control-label col-md-12" })
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.OBSERVACIONES, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.OBSERVACIONES, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </fieldset>
                            </div>
                           
                                <div class="row">
                                   
                                    <div class="col-xs-6 col-md-6 text-right">
                                        <button class="btn bg-teal" data-popup="tooltip"
                                                title="" data-placement="bottom" data-original-title="Clic para guardar cambios">
                                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                        </button>
                                    </div>
                                </div>
                          
                        }
                    </div>
                    <div class="row form-group col-md-12">
                        <table class="table table-hover table-xxs datatable-basic table-responsive" id="tablaPersonas">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>
                                        Identificación
                                    </th>
                                    <th>
                                        Tipo Id
                                    </th>
                                    <th>
                                        Apellidos
                                    </th>

                                    <th>
                                        Nombres
                                    </th>

                                    <th>
                                        Género
                                    </th>
                                    <th>
                                        Infracción
                                    </th>

                                    <th>
                                        Conducta
                                    </th>
                                    <th>
                                        Modo
                                    </th>
                                    <th>
                                        Número Evento
                                    </th>
                                    <th>
                                        Fecha Conducta
                                    </th>
                                    <th>
                                        Relación
                                    </th>
                                    <th>
                                        Participación
                                    </th>
                                    <th>
                                        Obervaciones
                                    </th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                    
                    
                    <div class="col-md-12">
                        <legend class="text-semibold">
                            Asignar A:
                            <a class="control-arrow" data-toggle="collapse" data-target="#panel1">
                                <i class="icon-circle-down2"></i>
                            </a>
                        </legend>
                        <div class="collapse in" id="panel1">                            
                            <button type="button" id="refrescarPersonas" class="btn btn-success btn-xs hidden" data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para Refrecar los registros">
                                <b><i class="icon-reload-alt position-left"></i></b>Refrescar Pantalla
                            </button>
                            
                            <div class="col-md-5 embed-responsive embed-responsive-4by3 iframe-personalizado hidden" id="contenedorFormMedio">
                                <hr />
                                <label class="text-danger">Cargando el formulario...</label>
                                <iframe src="" class="embed-responsive-item " id="frameMedio">
                                    <p>Tu navegador no soporta Iframes.</p>
                                </iframe>
                            </div>
                            <div class="col-md-7">
                                <table class="table table-hover table-xxs datatable-basic" id="tablaMedios">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Acciones</th>
                                            <th>
                                                Medio que Conoce
                                            </th>
                                            <th>
                                                Desc. Patrulla
                                            </th>
                                            <th>
                                                Nombres y Apellidos
                                            </th>
                                            <th>
                                                Cédula
                                            </th>
                                            <th>
                                                Nombres y Apellidos
                                            </th>
                                            <th>
                                                Fecha Conducta
                                            </th>
                                            <th>
                                                Pond.
                                            </th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-6 col-md-6 text-left">
            <button type="button" class="btn bg-teal " data-popup="tooltip" title="" data-placement="bottom"
                    data-original-title="Clic para regresar a las entidades" onclick='location.href=("@Url.Action("Turnos","Turnos",new { intSitioGrabacion = ViewBag.SitioId, strNombre = ViewBag.Sitio, intEntidad=ViewBag.EntidadId, strEntidad=ViewBag.Entidad, strConsulta="CONSULTAR",strMensaje="",intTurno=ViewBag.Turno, intSitioGrabacionTurno=ViewBag.SitioId, lgEvento=ViewBag.Evento, lgEventoMedio=ViewBag.EventoMedio })")'>
                <b><i class="icon-arrow-left12"></i></b>Regresar a Turnos
            </button>
        </div>
    </div>
</div>
<!-- ModalConductas modal Conductas-->
<div id="ModalConductas" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Conductas</h5>
            </div>
            <div class="modal-body ">
                <div id="modalAlertaDepto"></div>
                <div class="row form-compact">
                    <div class="col-md-12">
                        <table id="tblConductas" class="table table-hover table-xxs datatable-basic modal_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row form-compact">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning btn-xs" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /ModalConductas modal -->
<!-- ModalEventos modal Eventos-->
<div id="ModalEvento" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Evento</h5>
            </div>
            <div class="modal-body ">
                <div id="modalAlertaDepto"></div>
                <div class="row form-compact">
                    <div class="col-md-12">
                        <table id="tblEvento" class="table table-hover table-xxs datatable-basic modal_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>Número Evento</th>
                                    <th>Número Caso</th>
                                    <th>Hora Caso</th>
                                    <th>Dire Caso</th>
                                    <th>Ciudad</th>
                                    <th>Código Pedido</th>
                                    <th>Sitio Evento</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row form-compact">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning btn-xs" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /ModalEventos modal -->
<!-- ModalInfracciones modal Infracciones-->
<div id="ModalInfracciones" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Infracciones</h5>
            </div>
            <div class="modal-body ">
                <div id="modalAlertaDepto"></div>
                <div class="row form-compact">
                    <div class="col-md-12">
                        <table id="tblInfracciones" class="table table-hover table-xxs datatable-basic modal_table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div class="row form-compact">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning btn-xs" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /ModalInfracciones modal -->
@section PostScripts{

    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/ServiciosPrestadosJs")
    <script>


        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////



        var urlObtenerPersonas = "@Url.Action("ObtenerConductaPersonas", "ConductasPersona", new { intSitio = ViewBag.SitioId , lgTurno = ViewBag.Turno, lgConducta = ViewBag.Conducta, intEntidad= ViewBag.EntidadId })";
        var urlObtenerMediosPersona = "@Url.Action("ObtenerMediosPersona","ConductasPersona")";
        var urlEliminarPersona = "@Url.Action("EliminarPersona", "ConductasPersona")";
        var urlEliminarMedio = "@Url.Action("EliminarMedio", "MediosPersona")";
        var glConductas = "@ViewBag.Consulta";
        var glParametros = ["@ViewBag.SitioId"];
        var glEvento = @ViewBag.Evento, glEventoSitio = @ViewBag.SitioId, glEventoMedio = @ViewBag.EventoMedio, glEventFecha = "@ViewBag.EventoFecha";
        var glSitio = @ViewBag.SitioId, glTurno = @ViewBag.Turno, glEntidad=@ViewBag.EntidadId;
        var urlAgregarMedio = "@Url.Action("Crear", "MediosPersona", new { intSitio = @ViewBag.SitioId, lgTurno = ViewBag.Turno,  intEntidad = ViewBag.EntidadId, lgConsecutivo = "_CONSEC", lgEventoMedio = ViewBag.EventoMedio })";        
        var urlConsultarInfracciones = "@Url.Action("ObtenerInfracciones", "ConductasPersona")";
        var urlConsultarConductas = "@Url.Action("ObtenerConductas", "ConductasPersona")";
        var urlConsultarEvento = "@Url.Action("ObtenerEvento", "ConductasPersona")";
        var urlEditarPersona = "@Url.Action("Editar", "ConductasPersona")";
        var glFechaTurno = "@ViewBag.FechaTurno";
        ConsultarPersonas();
        AplicarDateTimePlugin();
            //AplicarChosen();
    </script>
    @if ( (Model!=null) && (!string.IsNullOrEmpty(Model.CONSECUTIVO.ToString())) && Model.CONSECUTIVO>0)
    {
        <script>
            CambiarRutaForm("EDITARPERSONA", @Model.CONSECUTIVO);
        </script>
    }
}