@{
    ViewBag.Title = "Revistas";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Datos de revistas realizadas:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear revista"
                                        onclick="window.location.href ='@Url.Action("Create")'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear revista
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tabla">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Consecutivo</th>
                            <th>Sitio Grabación</th>
                            <th>Fecha</th>
                            <th>Sitio</th>
                            <th>Patrulla</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->

@section PostScripts{
    @Scripts.Render("~/bundle/RevistasJs")

    <script>
        var globalSitio = @ViewBag.globalSitio;
        var globalFuerza = @ViewBag.globalFuerza;
        var globalUsuario = '@ViewBag.globalUsuario';
        @*var idConsecutivo = @ViewBag.idConsecutivo;
        var numeEvento = @ViewBag.numeEvento;*@

        var urlTabla = '@Url.Action("VerRevistas", "Revistas")';

        cargarTabla();
    </script>
}