@*@model SECADPLUS.Models.CadReferenciasSecad*@
<!--FIN RMR 13-06-2020 Adicion Referencias-->
@{
    ViewBag.Title = "Pendientes Despacho";
}

@section scripts{
    @Scripts.Render("~/bundle/FormularioJs")
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/ModalsJs")
}

<link href="/Scripts/Huawei/bootstrap-toggle/css/bootstrap-toggle.css" rel="stylesheet">
<script src="/Scripts/Huawei/bootstrap-toggle/js/bootstrap-toggle.min.js"></script>

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div id="exTab3">
                        <ul class="nav nav-tabs nav-tabs-highlight">
                            <li class="active" id="llamadas"><a href="#llamadasPendientes" id="tabPendientes" data-toggle="tab">Llamadas Pendientes</a></li>
                            <li><a href="#procesoEventos" data-toggle="tab" id="eventos">Eventos</a></li>
                            <li><a href="#cerrados" data-toggle="tab" id="cerrados">Cerrados</a></li>
                        </ul>

                        <div class="tab-content">
                            <!--------------------------------------TAB LLAMADAS RECIBIDAS------------------------------------->
                            <div class="tab-pane active" id="llamadasPendientes">
                                <fieldset>
                                    <!-- Panel Entidades -->
                                    <div class="col-md-12">
                                        <legend class="text-semibold">
                                            Entidades
                                            <a class="control-arrow" data-toggle="collapse" data-target="#panel1Llamadas">
                                                <i class="icon-circle-down2"></i>
                                            </a>
                                        </legend>
                                        <div class="collapse in" id="panel1Llamadas">
                                            <div class="col-xs-12 col-md-6 col-lg-3 space_down">
                                                <div class="form-compact">
                                                    <label>Entidades</label>
                                                    @Html.Editor("FUERZA_DESCRIPCION", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                            <div class="col-xs-12 col-md-6 col-lg-1 space_down">
                                                <div class="form-compact">
                                                    <label>&nbsp;</label>
                                                    @Html.Editor("FUERZA_ABREVIATURA", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                            <div class="col-xs-12 col-md-6 col-lg-3 space_down">
                                                <div class="form-compact">
                                                    <label>Jurisdicciones / Canales</label>
                                                    @Html.Editor("CANAL_DESCRIPCION", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                            <div class="col-xs-12 col-md-12 col-lg-5 space_down">
                                                <div class="row">
                                                    <div class="form-compact col-xs-12 col-md-12">
                                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                                            <label>
                                                                <input type="radio" class="styled" name="opcionesRbEstado" id="pend_sinEnv_enDesp" value="'P', 'S', 'E'" checked>
                                                                Pend/SinEnv/EnDesp.
                                                            </label>
                                                        </div>
                                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                                            <label>
                                                                <input type="radio" class="styled" name="opcionesRbEstado" id="seguimiento" value="'T'">
                                                                Seguimiento
                                                            </label>
                                                        </div>
                                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                                            <label>
                                                                <input type="radio" class="styled" name="opcionesRbEstado" id="inform" value="'I'">
                                                                Inform.
                                                            </label>
                                                        </div>
                                                        <div class="col-xs-12 col-sm-6 col-md-6">
                                                            <label>
                                                                <input type="radio" class="styled" name="opcionesRbEstado" id="pendRevisi" value="'R'">
                                                                Pend. Revisión
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Panel Entidades -->
                                    <!-- Panel Llamadas Recibidas por Jurisdicción-->
                                    <div class="col-md-12">
                                        <legend class="text-semibold">
                                            Llamadas recibidas por jurisdicciones
                                            <a class="control-arrow" data-toggle="collapse" data-target="#panel2Llamadas">
                                                <i class="icon-circle-down2"></i>
                                            </a>
                                        </legend>

                                        <div class="collapse in" id="panel2Llamadas">
                                            <table class="table table-hover table-bordered table-xxs datatable-basic" id="tablaRecibidas">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>Cod SECAD</th>
                                                        <th></th>
                                                        <th>Hora</th>
                                                        <th>No telefónico</th>
                                                        <th>Estado</th>
                                                        <th>Recurso</th>
                                                        <th>Evento</th>
                                                        <th>Rec.</th>
                                                        <th>Código1</th>
                                                        <th>Municipio</th>
                                                        <th>Dir. caso</th>
                                                        <th>Barrio</th>
                                                        <th>Prioridad</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                            <div class="row">
                                                <div class="col-xs-12 col-sm-6 col-md-8 space">
                                                    <div>
                                                        <label class="col-xs-12 col-md-3">Comentario incicial del caso</label>
                                                        <div class="col-xs-12 col-md-9">
                                                            <div class="row">
                                                                <textarea rows="2" class="form-control" id="textComentario" readonly="readonly"></textarea>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-xs-12 col-sm-6 col-md-4">
                                                    <label class="col-xs-5 col-md-4">Receptor:</label>
                                                    <span class="col-xs-7 col-md-8 label label-default" id="textReceptor">Receptor</span>
                                                </div>

                                                <div class="col-xs-12 col-sm-6 col-md-4 form-group text-center">
                                                    <button class="btn bg-teal btn-xs" type="button" data-popup="tooltip" title=""
                                                            data-placement="bottom" data-original-title="Clic deterner timer"
                                                            onclick="DeternerTimer()" id="btnDetener">
                                                        <i id="iTimer" class="icon-watch2 icon_size-md"></i>
                                                    </button>
                                                    <button class="btn bg-teal btn-xs" type="button" data-popup="tooltip" title=""
                                                            data-placement="bottom" data-original-title="Clic refrescar pantalla"
                                                            onclick="RefrescarPanatalla()">
                                                        <i class="icon-rotate-cw3 icon_size-md"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Panel Llamadas Recibidas por Jurisdicción-->
                                    <!-- Panel Llamadas en Recepción -->
                                    <div class="col-md-12">
                                        <legend class="text-semibold">
                                            Llamadas en recepción
                                            <a class="control-arrow" data-toggle="collapse" data-target="#panel3Llamadas">
                                                <i class="icon-circle-down2"></i>
                                            </a>
                                        </legend>
                                        <div class="collapse in" id="panel3Llamadas">
                                            <table class="table table-hover table-bordered table-xxs datatable-basic" id="tablaRecepcion">
                                                <thead>
                                                    <tr>
                                                        @*<th></th>*@
                                                        <th>No de llamada</th>
                                                        <th>Hora caso</th>
                                                        <th>No de teléfono</th>
                                                        <th>Municipio</th>
                                                        <th>Dir. Caso</th>
                                                        <th>Código1</th>
                                                        <th>Barrio</th>
                                                        <th>Comuna</th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>
                                    </div>
                                    <!-- Panel Llamadas en Recepción -->
                                </fieldset>
                            </div>
                            <!--------------------------------------TAB LLAMADAS RECIBIDAS------------------------------------->
                            <!--------------------------------------TAB EVENTOS           ------------------------------------->
                            <div class="tab-pane" id="procesoEventos">
                                <fieldset>
                                    <!-- Panel form 1 -->
                                    <div class="col-md-12">
                                        <legend class="text-semibold">
                                            Evento generado
                                            <a class="control-arrow" data-toggle="collapse" data-target="#panel1Eventos">
                                                <i class="icon-circle-down2"></i>
                                            </a>
                                        </legend>

                                        <div class="collapse in" id="panel1Eventos">
                                            <div class="col-xs-12 col-lg-3">
                                                <div class="row">
                                                    <div class="col-xs-6 col-lg-6 text-left">
                                                        <div class="form-compact">
                                                            <label class="col-md-12">Evento generado</label>
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-6 col-lg-6 text-center">
                                                        <div class="form-compact">
                                                            <button type="button" class="btn bg-teal btn-xs"
                                                                    data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para ver todos los eventos"
                                                                    onclick="CargaListadoEventos(true)">
                                                                Eventos Anteriores
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-xs-12 col-md-12 text-left">
                                                        <div class="row">
                                                            <div class="col-xs-12 col-md-12 space">
                                                                <div class="form-compact">
                                                                    <span class="col-xs-12 col-md-12 label bg-teal-300" id="textTurno">TURNO NO DISPONIBLE</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <table class="table table-hover table-xxs datatable-basic" id="tablaEventos">
                                                                    <thead>
                                                                        <tr>
                                                                            <th></th>
                                                                            <th>Ver</th>
                                                                            <th>No. Incidente</th>
                                                                            <th>Estado</th>
                                                                            <th>Fecha</th>
                                                                            <th>Usuario</th>
                                                                        </tr>
                                                                    </thead>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xs-12 col-lg-9">
                                                <div class="row">
                                                    <div class="col-lg-4">
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <div class="form-compact">
                                                                    <label class="col-md-12">Datos iniciales de la llamada</label>
                                                                    @Html.Hidden("textSitiGraba")
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4 eventosFont">Fecha y hora:</label>
                                                                <b><span class="col-xs-7 col-md-8 label bg-verde-borde eventosFont" id="textHoraCaso">Fecha y hora</span></b>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Llamada:</label>
                                                                <span class="col-xs-7 col-md-8 label bg-verde-borde eventosFont" id="textLlamada">Llamada</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Abonado:</label>
                                                                <span class="col-xs-7 col-md-4 label bg-verde-borde eventosFont" id="textAbonado">Abonado</span>
                                                                <span class="col-xs-7 col-md-4 label bg-verde-borde eventosFont" id="textDispositivo">Dispositivo</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Nombre:</label>
                                                                <span class="col-xs-7 col-md-8 label bg-verde-borde eventosFont" id="textPropNombre">Nombre</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Dirección:</label>
                                                                <span class="col-xs-7 col-md-8 label bg-verde-borde eventosFont" id="textPropDireccion">Dirección</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Ciudad:</label>
                                                                <span class="col-xs-7 col-md-4 label bg-verde-borde eventosFont" id="textCiudadTelefono">Ciudad</span>
                                                                <span class="col-xs-7 col-md-4 label bg-verde-borde eventosFont" id="textBarrioTelefono">Barrio</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Llamante:</label>
                                                                <span class="col-xs-7 col-md-8 label bg-verde-borde" id="textLlamante">Llamante</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-4">Dirección:</label>
                                                                <span class="col-xs-7 col-md-8 label bg-verde-borde" id="textDireccionLlamante">Dirección</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-8">
                                                        <div class="row">
                                                            <div class="col-xs-12 col-md-5">
                                                                <label class="col-xs-5 col-md-5">Usuario:</label>
                                                                <span class="col-xs-7 col-md-7 label bg-verde-borde" id="textUsuario">Usuario</span>
                                                            </div>
                                                            <div class="col-xs-12 col-md-4 show_grid-xs text-right">
                                                                <button type="button" class="btn bg-teal btn-xs" data-toggle="modal"
                                                                        data-target="#ModalComentariosAdicionales" data-popup="tooltip" title=""
                                                                        data-placement="bottom" data-original-title="Clic para crear comentarios adicionales">
                                                                    Comentarios Adicionales
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 space">
                                                                <label class="col-xs-12 col-md-3">Descripción hechos</label>
                                                                <div class="col-xs-12 col-md-9">
                                                                    <div class="row">
                                                                        <textarea rows="8" class="form-control"
                                                                                  readonly="readonly" id="textComentarios"></textarea>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-3">Caso:</label>

                                                                <span class="col-xs-7 col-md-2 label bg-verde-borde eventosFont" id="textCaso1">Código</span>
                                                                <span class="col-xs-7 col-md-7 label bg-verde-borde eventosFont" id="textDescCaso1">Nombre Caso</span>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-3">Caso:</label>
                                                                <span class="col-xs-7 col-md-2 label bg-verde-borde eventosFont" id="textCaso2">Código</span>
                                                                <span class="col-xs-7 col-md-7 label bg-verde-borde eventosFont" id="textDescCaso2">Nombre Caso</span>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-3">Dirección:</label>
                                                                <span class="col-xs-7 col-md-7 label bg-verde-borde eventosFont" id="textDireccion">Dirección</span>
                                                                <div class="col-xs-12 col-md-2 text-center show_grid-xs">
                                                                    <button type="button" class="btn bg-teal btn-xs" data-popup="tooltip" title=""
                                                                            data-placement="bottom" data-original-title="Clic para actualizar dirección"
                                                                            onclick="CargarBarriosComunas()">
                                                                        Actualizar
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12 form-compact">
                                                                <label class="col-xs-5 col-md-3">Barrio:</label>
                                                                <span class="col-xs-7 col-md-5 label bg-verde-borde eventosFont" id="textBarrio">Barrio</span>
                                                                <span class="col-xs-7 col-md-4 label bg-verde-borde eventosFont" id="textCiudad">Ciudad</span>
                                                            </div>
                                                        </div>
                                                        <div class="row form-compact hidden" id="contenedorCasoReal">
                                                            <div class="col-md-12">
                                                                <label class="col-md-12">Caso Real:</label>
                                                                <div class="col-xs-3 col-md-5 text-left ">
                                                                    <input type="text" id="txtCasoId" name="txtCasoId" class="form-control" placeholder="Código" />
                                                                </div>
                                                                <div class="col-xs-7 col-md-5 text-left form-group">
                                                                    <input type="text" id="txtCaso" name="txtCaso" class="form-control" readonly placeholder="Descripción" tabindex="-1" />
                                                                    <span class="label bg-primary-300 table-xs" id="mensajeCaso"></span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /panel form 1 -->
                                    <!-- Panel form 2 -->
                                    <div class="col-md-12">
                                        <legend class="text-semibold">
                                            Recursos de atención
                                            <a class="control-arrow" data-toggle="collapse" data-target="#panel2Eventos">
                                                <i class="icon-circle-down2"></i>
                                            </a>
                                        </legend>
                                        <div class="collapse in" id="panel2Eventos">
                                            <div class="col-xs-12 col-lg-3">
                                                <div class="collapse in" id="panel3">
                                                    <div id="exTab3">
                                                        <ul class="nav nav-tabs nav-tabs-highlight">
                                                            <li class="active" id="tabMediosDisponibles"><a href="#mediosDisponibles" data-toggle="tab">Recursos de Atención</a></li>
                                                            <li id="anotacionesPatrulla" class="hidden"><a href="#panelAnotaciones" data-toggle="tab">Anotaciones</a></li>
                                                        </ul>Anotarcio
                                                        <div class="tab-content">
                                                            <div class="tab-pane active col-lg-12 col-md-12 row" id="mediosDisponibles">
                                                                <!--------------------------------------CONTENIDO TAB------------------------------------->
                                                                <div class="panel panel-flat">

                                                                    <div class="panel-body">
                                                                        <label>Id/Ubicación</label>
                                                                        <div class="form-compact">

                                                                            <div class="col-xs-12 col-lg-9">
                                                                                @Html.Hidden("CADUNITUR_UNDEFUERZA")
                                                                                @Html.Hidden("CADUNITUR_UNDECODIGO")
                                                                                @Html.Hidden("CADPATRU_CODIGO")
                                                                                @Html.Hidden("CONSECUTIVO")
                                                                                @Html.Editor("ID_RADIOUBICANEW", new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba Id" } })
                                                                            </div>
                                                                            <div class="col-xs-12 col-lg-4">
                                                                                <button type="button" class="btn bg-teal btn-xs" data-popup="tooltip" title=""
                                                                                        data-placement="bottom" data-original-title="Clic para grabar Id/Ubicación"
                                                                                        onclick="GrabarIdUbicacion()">
                                                                                    <i class="icon-checkmark4"></i>
                                                                                </button>
                                                                            </div>
                                                                        </div>
                                                                        <table class="table table-hover table-bordered table-xxs datatable-basic form-compact" id="tablaMediosDisponibles">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th></th>

                                                                                    <th>Desc Recurso</th>
                                                                                    <th>Eta</th>
                                                                                    <th>Cuenta</th>
                                                                                    <th>Id. Radio/Ubic.</th>
                                                                                    <th>Desc Unidad</th>

                                                                                </tr>
                                                                            </thead>
                                                                            <tbody></tbody>
                                                                        </table>
                                                                        <!--RMR adicion 06/06/2020-->
                                                                        <div class="col-md-9">
                                                                            <div class="form-compact">
                                                                                <label>Cuadrante</label>
                                                                                @Html.Editor("CUADRANTE", new { htmlAttributes = new { @class = "form-control", @placeholder = "Cuadrante", @readonly = "readonly", @size = "4" } })
                                                                            </div>
                                                                        </div>
                                                                        <div class="col-md-3">
                                                                            <div class="form-compact">
                                                                                <label>Cuenta</label>
                                                                                @Html.Editor("CUENTA", new { htmlAttributes = new { @class = "form-control", @placeholder = "Nro Asignaciones", @readonly = "readonly", @size = "4" } })
                                                                            </div>
                                                                        </div>

                                                                        <!--fin RMR adicion 06/06/2020-->
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="tab-pane col-lg-12 col-md-12 row" id="panelAnotaciones">
                                                                <!--------------------------------------CONTENIDO TAB------------------------------------->
                                                                <div class="panel panel-flat">

                                                                    <div class="panel-body">

                                                                        <div class="col-md-12 ">
                                                                            <label class="control-label">Anotaciones</label>
                                                                            <input type="hidden" id="hdAnotaConsecutivo" value="0" />
                                                                            <textarea rows="3" class="form-control" id="txtAnotacionPatrulla"></textarea>
                                                                            <button class="btn bg-teal" type="button" id="btnGAnotaPatrulla"><i class="icon icon-checkmark4"></i>Guardar</button>
                                                                            <hr />
                                                                            <table class="table table-hover table-bordered table-xxs datatable-basic form-compact" id="tablaAnotacionesPatrulla">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th></th>
                                                                                        <th>Historial de Anotación</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody></tbody>
                                                                            </table>
                                                                        </div>


                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>

                                            <div class="col-xs-12 col-lg-9 ">
                                                <!--RMR 13-06-2020 adicion campos informacion adicional MEVIL-->
                                                <div class="row form-compact">
                                                    <div class="col-lg-12">
                                                        <table class="table table-hover table-bordered table-xxs datatable-basic" id="tablaInformacionAdicional">
                                                            <thead>
                                                                <tr>
                                                                    <th></th>
                                                                    <th>Coor. (X) Latitud</th>
                                                                    <th>Coor. (Y) Longitud</th>
                                                                    <th>Modalidad Caso</th>
                                                                    <th>Conducta Especial</th>
                                                                    <th>Arma Medio</th>
                                                                    <th>Tipo Moviliza Agresor</th>
                                                                </tr>
                                                            </thead>
                                                            <tr>
                                                                <th></th>
                                                                <th>@Html.Editor("Latitud", new { htmlAttributes = new { @class = "form-control", @placeholder = "Coordenada X", @readonly = "readonly", @size = "4" } })</th>
