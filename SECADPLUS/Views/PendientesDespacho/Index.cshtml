        function TraerCordenada(MedioCons) {
            var datos = { "PsitioGraba": $("#textSitiGraba").val(), "PMedioConsecutivo": MedioCons };
            $.ajax({
                type: "POST",
                url: urlGetCoordenadas,
                data: datos,
                dataType: 'json',
                cache: false,
                success: function (respuesta) {
                    if (respuesta.success) {
                        $("#Latitud").val(respuesta.Dato[0].PLatitud);
                        $("#Longitud").val(respuesta.Dato[0].PLongitud);

                    } else {
                        ModalError("Señor(a) Funcionario(a:)", "No existe el grupo, revise");
                        //  $("#txtDescripcion").val("");
                    }

                },
                error: function () {
                    $("#txtDescripcion").val("");
                    ModalError("Señor(a) Funcionario(a:)", "No existe el grupo, revise");
                }
            });
        }

        function Ins_Coordenadas() {
            $("#notificacionDocumento").empty();

            var MdCoordenadas = new FormData();
             MdCoordenadas.append('PsitioGraba', $("#textSitiGraba").val());
             MdCoordenadas.append('Nume_Llamada', $("#textLlamada").val());
             MdCoordenadas.append('PLatitud', $("#Latitud").val());
             MdCoordenadas.append('PLongitud', $("#Longitud").val());

            $.ajax({
                type: 'POST',
                url: urlInsCoordenadas,
                dataType: 'json',
                data: MdCoordenadas,
                cache: false,
                contentType: false,
                processData: false,
                enctype: 'multipart/form-data',
                beforeSend: function () {

                },
                success: function (response) {
                    if (response.success == true) {

                        $("#notificacionDocumento").empty();

                        if (response.ID > 0) {
                            $("#Nume_Llamada").val(response.ID);
                            Ins_Coordenadas(response.ID);
                        } else if (response.ID == -3) {
                            Ins_Coordenadas($("#Nume_Llamada").val());
                        }

                        ModalExitoso("Señor(a) Funcionario(a:)", response.mensaje);

                    } else {
                        $("#notificacionDocumento").empty();
                        ModalError("Señor(a) Funcionario(a:)", response.mensaje);
                    }

                },
                error: function (ex) {
                    $("#notificacionDocumento").empty();
                    ModalError("Señor(a) Funcionario(a:)", "No es posible grabar el registro, revise");
                }
            });
        }

