                                                            <input type="hidden" id="CADEVEN_NUME_EVENTO" name="CADEVEN_NUME_EVENTO" />
                                                            <input type="hidden" id="USUA_MODIFICA" name="USUA_MODIFICA" value="@Model.Usuario" />
                                                            <input type="hidden" id="FECHA_MODIFICACION" name="FECHA_MODIFICACION" value="@Model.FechaHora" />
