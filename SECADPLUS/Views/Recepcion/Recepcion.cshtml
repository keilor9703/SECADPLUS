                                                                            <label>Dirección del Caso:</label>
                                                                            <input type="text" class="form-control" id="DIRE_CASO" name="DIRE_CASO" placeholder="Escriba dirección" maxlength="80" title="Doble Click para acceder a la lista" data-toggle="tooltip" data-placement="top">
