                                                                            @Html.EditorFor(model => model.LUGE_BARRIO, new { htmlAttributes = new { @class = "form-control hide", id = "txtCiudadId", @readonly = true, placeholder = "Código", @Value = Model.lgCiudaCodigo } })
                                                                            @Html.ValidationMessageFor(model => model.LUGE_BARRIO, "", new { @class = "text-danger" })

                                                                            <div class="col-xs-12 col-md-12 text-left form-group">
                                                                                <input type="text" id="txtCiudad" name="txtCiudad" class="form-control" placeholder="Ciudad" value="@Model.Ciudad" title="Doble Click para acceder a la lista" data-toggle="tooltip" data-placement="top" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCiudad"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
