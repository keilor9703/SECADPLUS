                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" class="styled" id="personal" checked="checked" value="01">
                                                                                    1
                                                                                </label>
                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" class="styled" value="02">
                                                                                    2
                                                                                </label>
                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" class="styled" value="03">
                                                                                    3
                                                                                </label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-compact col-xs-12 col-md-12 bg-teal-100 text-center">
                                                                    <div class="row">
                                                                        <div class="col-md-6 col-lg-4">
                                                                            <label class="checkbox-inline">
                                                                                <input type="checkbox" name="todosCanales" class="styled">
                                                                                Enviar a todos los canales
                                                                            </label>
                                                                        </div>
                                                                        <div class="col-md-6 col-lg-4">
                                                                            <label class="checkbox-inline">
