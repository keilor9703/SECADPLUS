                                                                            @Html.DropDownList("PUCA_CODIGO", Model.Coordenadas, string.Empty, htmlAttributes: new { @class = "form-control chosen-select", id = "ddlCoord" })
                                                                            @Html.ValidationMessageFor(model => model.PUCA_CODIGO, "", new { @class = "text-danger" })

                                                                        </div>
                                                                    </div>


                                                                </div>
                                                                <div class="row">
