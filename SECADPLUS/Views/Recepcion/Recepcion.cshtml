                                                                    </div>
                                                                </div>
                                                                <!-- Botón -->
                                                                <div class="row form-compact space">
                                                                    <div class="col-md-7 col-lg-5 text-left">
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Solicitando Info" onclick="CerrarPedido('INFORMACION')">
                                                                            <img src="@Url.Content("~/Images/info_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Persona molestando" onclick="CerrarPedido('PERSONAMOLESTANDO')">
                                                                            <img src="@Url.Content("~/Images/molestando_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Niño molestando" onclick="CerrarPedido('NINOMOLESTADO')">
                                                                            <img src="@Url.Content("~/Images/nino_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Llamada insultando" onclick="CerrarPedido('LLAMADAINSULTANTE')">
                                                                            <img src="@Url.Content("~/Images/insultar_ico.png")" class="img-responsive" alt="">
                                                                        </button>
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="No hablan" onclick="CerrarPedido('COLGARON')">
                                                                            <img src="@Url.Content("~/Images/consultar_ico.png")" class="img-responsive" alt="">
                                                                        </button>
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Colgaron" onclick="CerrarPedido('COLGARON')">
                                                                            <img src="@Url.Content("~/Images/colgaron_ico.png")" class="img-responsive" alt="">
                                                                        </button>
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Mapa" onclick="AbrirMapa()">
                                                                            <img src="@Url.Content("~/Images/ubicacion_ico.png")" class="img-responsive" alt="">
                                                                        </button>


                                                                    </div>

                                                                    <div class="col-md-2 col-lg-2 text-center space_up">
                                                                        <button type="button" class="btn bg-warning btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Clic para limpiar el formulario" onclick="Limpiar()">
                                                                            <b><i class="icon icon-eraser"></i></b>Cancelar
                                                                        </button>

                                                                    </div>
                                                                    <div class="col-md-2 col-lg-2 text-center space_up">
                                                                        <button type="button" class="btn bg-teal btn-xs" data-toggle="modal"
                                                                                data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Clic para pasar la dirección encontrada" onclick="PasarDireccion()">
                                                                            <b><i class="icon icon-box-add"></i></b> Pasar dirección fija
                                                                        </button>
                                                                    </div>

                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="text-danger col-md-12">Caso reportado *</label>
                                                                            <div class="col-xs-4 col-md-4 text-left ">
                                                                                @Html.EditorFor(model => model.CODI_PEDIDO, new { htmlAttributes = new { @class = "form-control", id = "txtCasoId", placeholder = "Código", title = "Código principal asociado al caso. Doble click para acceder a la lista", data_toggle = "tooltip", data_placement = "top" } })

                                                                                @Html.ValidationMessageFor(model => model.CODI_PEDIDO, "", new { @class = "text-danger" })
                                                                            </div>
                                                                            <div class="col-xs-8 col-md-8 text-left form-group">
                                                                                <input type="text" id="txtCaso" name="txtCaso" class="form-control" readonly placeholder="Descripción" tabindex="-1" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCaso"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>

                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="text-danger col-md-12">Caso reportado</label>
                                                                            <div class="col-xs-4 col-md-4 text-left ">
                                                                                @Html.EditorFor(model => model.CODI_PEDIDO2, new { htmlAttributes = new { @class = "form-control", id = "txtCasoId2", placeholder = "Código", title = "Código secundario asociado al caso. Doble click para acceder a la lista", data_toggle = "tooltip", data_placement = "top" } })
                                                                                @Html.ValidationMessageFor(model => model.CODI_PEDIDO2, "", new { @class = "text-danger" })
                                                                            </div>
                                                                            <div class="col-xs-8 col-md-8 text-left form-group">
                                                                                <input type="text" id="txtCaso2" name="txtCaso2" class="form-control" readonly placeholder="Descripción" tabindex="-1" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCaso2"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
