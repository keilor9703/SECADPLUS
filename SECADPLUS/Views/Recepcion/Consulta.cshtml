@model SECADPLUS.Models.RecepcionModel
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div id="exTab3">
                        <ul class="nav nav-tabs nav-tabs-highlight" id="contenedor">
                            <li class="active" id="tabIngreso"><a href="#ingreso" data-toggle="tab" id="tabPrincipal">Ingreso Llamadas</a></li>
                            <li id="asociadas"><a href="#asociadas" data-toggle="tab"> Asociadas</a></li>
                            <li id="tabMensajes"><a href="#mensajes" data-toggle="tab">Mensajes</a></li>
                            <li id="usu24"><a href="#usu24h" data-toggle="tab">Llamada Usuario 24h</a></li>
                            <li id="tabgral"><p>Llamada Gral Sala</p></li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane active col-lg-12 col-md-12 row" id="ingreso">
                                <!--------------------------------------CONTENIDO TAB------------------------------------->
                                <div class="panel panel-flat">
                                    <div class="panel-body">
                                        <form action="#" method="post" id="formPedido">
                                            <!-- Contenido panel -->
                                            <div class="col-md-12 space_down">
                                                <fieldset>
                                                    <legend class="text-semibold">
                                                        Llamada
                                                        <a class="control-arrow" data-toggle="collapse" data-target="#panel1">
                                                            <i class="icon-circle-down2"></i>
                                                        </a>
                                                    </legend>
                                                    <div class="collapse in" id="panel1">
                                                        <div class="row">
                                                            <!--Campos ocultos para complementar la creación del pedido-->
                                                            @Html.HiddenFor(model => model.LUGE_TELEFONO, new { Value = 0 })
                                                            @Html.HiddenFor(model => model.SITIO_GRABA, new { })
                                                            @Html.HiddenFor(model => model.LUGE_CODIGO, new { Value = Model.LUGE_CODIGO })
                                                            @Html.HiddenFor(model => model.CODI_PEDIDO_REAL, new { })
                                                            @Html.HiddenFor(model => model.IMPORTANCIA, new { Value = "01" })
                                                            @Html.HiddenFor(model => model.PRIORIDAD, new { Value = "01" })
                                                            @Html.HiddenFor(model => model.TOTAL_CANALES, new { Value = "N" })
                                                            @Html.HiddenFor(model => model.TIPO_GENERO, new { Value = "CG" })
                                                            @Html.HiddenFor(model => model.CADUSUA_USUARIO, new { Value = Model.Usuario })
                                                            @Html.HiddenFor(model => model.CADPOLI_CEDU_EMPLEADO, new { Value = Model.Identificacion })
                                                            @Html.HiddenFor(model => model.CADPEDI_SITIO_GRABA, new { Value = Model.CADPEDI_SITIO_GRABA })
                                                            @Html.HiddenFor(model => model.FECHA_GRABACION, new { })
                                                            @Html.HiddenFor(model => model.FECH_CASO, new { })
                                                            @Html.HiddenFor(model => model.ENVIAR, new { Value = "N" })
                                                            <input type="hidden" id="CADPEDI_SITIOGRABA" name="CADPEDI_SITIOGRABA" />
                                                            <input type="hidden" id="CADPEDI_NUMELLAMADA" name="CADPEDI_NUMELLAMADA" />
                                                            <input type="hidden" id="CADCANA_FUERZ_ID" name="CADCANA_FUERZ_ID" value="0" />
                                                            <input type="hidden" id="CADCANA_CODIGO" name="CADCANA_CODIGO" value="0" />
                                                            <input type="hidden" id="CADEVEN_SITIO_GRABA" name="CADEVEN_SITIO_GRABA" />
                                                            <input type="hidden" id="CADEVEN_NUME_EVENTO" name="CADEVEN_NUME_EVENTO" />
                                                            <input type="hidden" id="USUA_MODIFICA" name="USUA_MODIFICA" value="@Model.Usuario" />
                                                            <input type="hidden" id="FECHA_MODIFICACION" name="FECHA_MODIFICACION" value="@Model.FechaHora" />
                                                            <div class="col-md-12 col-lg-6">
                                                                <div class="row">
                                                                    <div class="col-md-6 space_down">
                                                                        <div class="form-compact">
                                                                            <label class="col-md-5">Fecha y Hora:</label>
                                                                            <div class="input-group col-md-7">
                                                                                <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                                                                <input type="text" name="HORA_CASO" id="FechaCaso" class="form-control pickadate-accessibility"
                                                                                       placeholder="Escoja una fecha" data-popup="tooltip" title=""
                                                                                       data-placement="top" data-original-title="Escoja una fecha" value="@Model.FechaHora" readonly>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6 space_down">
                                                                        <div class="form-compact form-group">
                                                                            <label class="col-md-5">No de llamada:</label>
                                                                            @Html.EditorFor(model => model.NUME_LLAMADA, new { htmlAttributes = new { @class = "col-md-7 bg-teal-300", @Readonly = true } })
                                                                            @Html.ValidationMessageFor(model => model.NUME_LLAMADA, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6 space_down">
                                                                        <div class="form-compact">
                                                                            <label class="col-md-5">Responsable:</label>
                                                                            @Html.EditorFor(model => model.CADUSUA_USUARIO, new { htmlAttributes = new { @class = "col-md-7 bg-teal-300  ", Value = Model.Usuario, @Readonly = true } })
                                                                            @Html.ValidationMessageFor(model => model.CADUSUA_USUARIO, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6 space_down">
                                                                        <div class="form-compact">
                                                                            <label class="col-md-5">Modo actual:</label>
                                                                            <span class="col-md-7 label bg-teal-300 label-left" id="mensajeModo">Esperando llamada...</span>
                                                                            <span class="col-md-12 label bg-teal-300 label-left" id="mensajeConexiones">@Model.Conexiones</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-lg-6">
                                                                <div class="row space_down">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label class="col-lg-4">Prioridad:</label>
                                                                            <div class="col-lg-8">
                                                                                <label class="radio-inline text-orange-300">
                                                                                    <input type="radio" name="prioridad" class="styled" id="rutina" value="01">
                                                                                    Rutina
                                                                                </label>
                                                                                <label class="radio-inline text-success">
                                                                                    <input type="radio" name="prioridad" id="inmd" class="styled" value="03">
                                                                                    Inmd.
                                                                                </label>
                                                                                <label class="radio-inline text-danger">
                                                                                    <input type="radio" name="prioridad" id="flash" class="styled" value="04">
                                                                                    Flash
                                                                                </label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">

                                                                            <label class="col-lg-4">Importancia :</label>
                                                                            <div class="col-lg-8">

                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" class="styled" id="baja" value="01">
                                                                                    1
                                                                                </label>
                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" id="media" class="styled" value="02">
                                                                                    2
                                                                                </label>
                                                                                <label class="radio-inline">
                                                                                    <input type="radio" name="importancia" id="alta" class="styled" value="03">
                                                                                    3
                                                                                </label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-compact col-xs-12 col-md-12 bg-teal-100 text-center">
                                                                    <div class="row">
                                                                        <div class="col-md-6 col-lg-4">
                                                                            <label class="checkbox-inline">
                                                                                <input type="checkbox" name="todosCanales" id="todosCanales" class="styled">
                                                                                Enviar a todos los canales
                                                                            </label>
                                                                        </div>
                                                                        <div class="col-md-6 col-lg-4">
                                                                            <label class="checkbox-inline">
                                                                                <input type="checkbox" name="mujeres" id="mujeres" class="styled">
                                                                                Hay afectación de mujeres
                                                                            </label>
                                                                        </div>
                                                                        <div class="col-md-6 col-md-offset-3 col-lg-4 col-lg-offset-0">
                                                                            <span class="label bg-danger">V60 pais abonado</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </fieldset>
                                            </div>

                                            <div class="col-md-12">
                                                <fieldset>
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <legend class="text-semibold">
                                                                Datos
                                                                <a class="control-arrow" data-toggle="collapse" data-target="#panel2">
                                                                    <i class="icon-circle-down2"></i>
                                                                </a>
                                                            </legend>
                                                            <div class="collapse in" id="panel2">

                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact" id="contenedorAbonado">
                                                                            <label class="text-danger">Abonado * </label>
                                                                            <input type="number" id="telefono" class="form-control abonado" readonly
                                                                                   placeholder="Escriba el número tel/cel" aria-required="true" value="@Model.NUME_TELEFONO">
                                                                            <input type="hidden" name="NUME_TELEFONO" id="NUME_TELEFONO" class="form-control abonado" required="required" max="9999999999" min="0"
                                                                                   placeholder="Escriba el número tel/cel" aria-required="true" value="@Model.NUME_TELEFONO">
                                                                            <span class="label bg-primary-300 table-xs" id="mensajeAbonado"></span>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label>Medio Com.</label>
                                                                            @Html.DropDownList("DISP_TELEFONICO", Model.Medios, string.Empty, htmlAttributes: new { @class = "form-control ", tabindex = "-1", id = "ddlMedios" })
                                                                            @Html.ValidationMessageFor(model => model.DISP_TELEFONICO, "", new { @class = "text-danger" })
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row form-compact">
                                                                    <div class="col-md-6">
                                                                        <label>Nombre:</label>
                                                                        <input type="text" id="txtTmpNombre" class="form-control readonly-recepcion-grey" readonly tabindex="-1" value="@Model.PROP_TELEFONO"
                                                                               placeholder="Nombre Propietario" aria-required="true">
                                                                        <input type="hidden" name="PROP_TELEFONO" id="PROP_TELEFONO" class="form-control readonly-recepcion-grey" tabindex="-1" value="@Model.PROP_TELEFONO"
                                                                               placeholder="Nombre Propietario" aria-required="true">
                                                                    </div>

                                                                    <div class="col-md-3">
                                                                        <label>Ciudad:</label>
                                                                        <input type="text" name="spBarrio" id="spCiudad" class="form-control readonly-recepcion-grey" readonly tabindex="-1"
                                                                               placeholder="Ciudad" aria-required="true">
                                                                    </div>
                                                                    <div class="col-md-3">
                                                                        <label>Barrio:</label>
                                                                        <input type="text" name="BARR_TELEFONO" id="BARR_TELEFONO" class="form-control readonly-recepcion-grey" readonly tabindex="-1" value="@Model.BARR_TELEFONO"
                                                                               placeholder="Barrio" aria-required="true">
                                                                    </div>
                                                                    <div class="col-md-3 hide">
                                                                        <label>Celda:</label>
                                                                        <input type="text" name="CELDA_MARCACION" id="CELDA_MARCACION" class="form-control readonly-recepcion-grey" readonly tabindex="-1"
                                                                               placeholder="Celda" aria-required="true">
                                                                    </div>
                                                                    <div class="col-md-12">
                                                                        <label>Dirección:</label>
                                                                        <input type="text" name="DIRE_TELEFONO" id="DIRE_TELEFONO" class="form-control readonly-recepcion-grey" readonly tabindex="-1" value="@Model.DIRE_TELEFONO"
                                                                               placeholder="Dirección" aria-required="true">
                                                                    </div>
                                                                </div>
                                                                <!-- Botón -->
                                                                <div class="row form-compact space" id="botonesControl">
                                                                    <div class="col-md-6 col-lg-4 text-left">
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Solicitando Info" onclick="CerrarPedido('INFORMACION')">
                                                                            <img src="@Url.Content("~/Images/info_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Persona molestando" onclick="CerrarPedido('PERSONAMOLESTANDO')">
                                                                            <img src="@Url.Content("~/Images/molestando_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Niño molestando" onclick="CerrarPedido('NINOMOLESTADO')">
                                                                            <img src="@Url.Content("~/Images/nino_ico.png")" class="img-responsive" alt="">
                                                                        </button>

                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Llamada insultando" onclick="CerrarPedido('LLAMADAINSULTANTE')">
                                                                            <img src="@Url.Content("~/Images/insultar_ico.png")" class="img-responsive" alt="">
                                                                        </button>
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="No hablan" onclick="CerrarPedido('COLGARON')">
                                                                            <img src="@Url.Content("~/Images/consultar_ico.png")" class="img-responsive" alt="">
                                                                        </button>
                                                                        <button type="button" class="btn inner-panel bg-success-300  btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Colgaron" onclick="CerrarPedido('COLGARON')">
                                                                            <img src="@Url.Content("~/Images/colgaron_ico.png")" class="img-responsive" alt="">
                                                                        </button>


                                                                    </div>

                                                                    <div class="col-md-2 col-lg-2 text-center space_up">
                                                                        <button type="button" class="btn bg-warning btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Clic para limpiar el formulario" onclick="Limpiar()">
                                                                            <b><i class="icon icon-eraser"></i></b>Cancelar
                                                                        </button>

                                                                    </div>
                                                                    <div class="col-md-2 col-lg-2 text-center space_up">
                                                                        <button type="button" class="btn bg-teal btn-xs" data-toggle="modal"
                                                                                data-target="#modal_form_horizontal" data-popup="tooltip" title="" data-placement="bottom" tabindex="-1"
                                                                                data-original-title="Clic para pasar la dirección encontrada" onclick="PasarDireccion()">
                                                                            <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Pasar dirección fija
                                                                        </button>
                                                                    </div>

                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="text-danger col-md-12">Caso reportado *</label>
                                                                            <div class="col-xs-4 col-md-4 text-left ">
                                                                                @Html.EditorFor(model => model.CODI_PEDIDO, new { htmlAttributes = new { @class = "form-control", id = "txtCasoId", placeholder = "Código" } })

                                                                                @Html.ValidationMessageFor(model => model.CODI_PEDIDO, "", new { @class = "text-danger" })
                                                                            </div>
                                                                            <div class="col-xs-8 col-md-8 text-left form-group">
                                                                                <input type="text" id="txtCaso" name="txtCaso" class="form-control" readonly placeholder="Descripción" tabindex="-1" value="@Model.CasoDesc" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCaso"></span>
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="text-danger col-md-12">Caso reportado</label>
                                                                            <div class="col-xs-4 col-md-4 text-left ">
                                                                                @Html.EditorFor(model => model.CODI_PEDIDO2, new { htmlAttributes = new { @class = "form-control", id = "txtCasoId2", placeholder = "Código" } })
                                                                                @Html.ValidationMessageFor(model => model.CODI_PEDIDO2, "", new { @class = "text-danger" })
                                                                            </div>
                                                                            <div class="col-xs-8 col-md-8 text-left form-group">
                                                                                <input type="text" id="txtCaso2" name="txtCaso2" class="form-control" readonly placeholder="Descripción" tabindex="-1" value="@Model.Caso2Desc" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCaso2"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="text-danger col-md-12">Cuidad caso *</label>

                                                                            @Html.EditorFor(model => model.LUGE_BARRIO, new { htmlAttributes = new { @class = "form-control hide", id = "txtCiudadId", @readonly = true, placeholder = "Código", @Value = Model.LUGE_CODIGO } })
                                                                            @Html.ValidationMessageFor(model => model.LUGE_BARRIO, "", new { @class = "text-danger" })

                                                                            <div class="col-xs-12 col-md-12 text-left form-group">
                                                                                <input type="text" id="txtCiudad" name="txtCiudad" class="form-control" placeholder="Ciudad" value="@Model.Ciudad" />
                                                                                <span class="label bg-primary-300 table-xs" id="mensajeCiudad"></span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label>P. card</label>
                                                                            @Html.DropDownList("PUCA_CODIGO", Model.Coordenadas, string.Empty, htmlAttributes: new { @class = "form-control chosen-select", id = "ddlCoord" })
                                                                            @Html.ValidationMessageFor(model => model.PUCA_CODIGO, "", new { @class = "text-danger" })

                                                                        </div>
                                                                    </div>
                                                                    
                                                                    <div class="col-md-12">
                                                                        <div class="form-compact">
                                                                            <label>Dirección del Caso:</label>
                                                                            <input type="text" class="form-control" id="DIRE_CASO" name="DIRE_CASO" placeholder="Escriba dirección" value="@Model.DIRE_CASO" maxlength="80">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact row">
                                                                            <label class="col-md-12">Barrio </label>
                                                                            <div class="col-xs-4 col-md-4 text-left ">
                                                                                @Html.EditorFor(model => model.CODI_BARRIO, new { htmlAttributes = new { @class = "form-control", @readonly = true, placeholder = "Código", @Value = Model.CODI_BARRIO } })
                                                                                @Html.ValidationMessageFor(model => model.CODI_BARRIO, "", new { @class = "text-danger" })
                                                                            </div>
                                                                            <div class="col-xs-8 col-md-8 text-left form-group">
                                                                                <input type="text" id="txtBarrio" name="txtBarrio" class="form-control" placeholder="Barrio" value="@Model.Barrio" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label>Comuna</label>
                                                                            <input type="text" id="txtComuna" class="form-control" placeholder="Escriba comuna" readonly>
                                                                        </div>
                                                                    </div>
                                                                    
                                                                    

                                                                </div>
                                                                <div class="row form-compact">
                                                                    <div class="col-md-6">
                                                                        <label>Latitud:</label>
                                                                        <input type="text" name="LATITUD_CASO" id="LATITUD_CASO" class="form-control readonly-recepcion-grey" readonly
                                                                               placeholder="Latitud" aria-required="true" value="@Model.LATITUD_CASO">
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <label>Longitud:</label>
                                                                        <input type="text" name="LONGITUD_CASO" id="LONGITUD_CASO" class="form-control readonly-recepcion-grey" readonly
                                                                               placeholder="Longitud" aria-required="true" value="@Model.LONGITUD_CASO">
                                                                    </div>
                                                                </div>
                                                                <div class="row form-compact hidden" id="validarDir">
                                                                    <div class="col-md-12 ">
                                                                        <button type="button" class="btn bg-teal btn-xs" id="btnValidarDir" data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para crear nuevas unidades" onclick="VerificarDireccion()">
                                                                            <b><i class="icon icon-eye"></i></b> Validar Dirección
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="row">
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label class="text-danger">Llamante * </label>
                                                                            <input type="text" class="form-control" placeholder="Nombre del llamante" id="NOMB_LLAMANTE" name="NOMB_LLAMANTE" value="@Model.NOMB_LLAMANTE">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="form-compact">
                                                                            <label>Dirección </label>
                                                                            <input type="text" class="form-control" placeholder="Dirección" id="DIRE_LLAMANTE" name="DIRE_LLAMANTE" value="@Model.DIRE_LLAMANTE">
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-12 col-lg-12 hide">
                                                                        <div class="form-compact ">
                                                                            <label class="text-danger">Tipo Información *</label>
                                                                            <select class="chosen-select form-control" tabindex="-1" aria-hidden="true" id="TIPO_INFORMACION" name="TIPO_INFORMACION">
                                                                                <option value="SC">Seg. Ciudadana</option>
                                                                                <option value="SD">Seg. Democratica</option>
                                                                                <option value="NA">Otros</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-12 hide">
                                                                        <div class="form-compact">
                                                                            <label>Código Coop</label>
                                                                            <input type="text" class="form-control" placeholder="Código" id="CODIGO_COOPERANTE" name="CODIGO_COOPERANTE">
                                                                        </div>
                                                                    </div>
                                                                </div>
