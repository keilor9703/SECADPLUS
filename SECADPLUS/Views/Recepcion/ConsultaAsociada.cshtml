<!-- Modal Comentarios -->
<div id="ModalComentarios" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Comentarios Adicionales</h5>
            </div>
            <div id="alertasComentarios"></div>
            <div class="modal-body ">
                <form id="formComentarios" action="" method="post">
                    <input type="hidden" id="CADPEDI_SITIOGRABA" name="CADPEDI_SITIOGRABA" value="@Model.SITIO_GRABA" />
                    <input type="hidden" id="NumeLlamada" name="CADPEDI_NUMELLAMADA" value="@Model.NUME_LLAMADA" />
                    <input type="hidden" id="CONSECUTIVO" name="CONSECUTIVO" value="0" />
                    <input type="hidden" id="CODI_PREGUNTA" name="CODI_PREGUNTA" />
                    <input type="hidden" id="RTA_PREGUNTA" name="RTA_PREGUNTA" />
                    <input type="hidden" id="USUA_USUARIO" name="USUA_USUARIO" value="@Model.Usuario" />
                    <input type="hidden" id="FECHA_GRABACION" name="FECHA_GRABACION" value="@Model.FechaHora" />
                    <div class="form-group">

                        <div class="col-md-12 obligatorio">
                            <label class="">Comentario:</label>
                            <textarea rows="4" cols="5" class="form-control" placeholder="Escriba descripción de los hechos" id="ANOTACION" name="ANOTACION" maxlength="3000"></textarea>
                        </div>
                        <div class="col-md-12">
                            <button type="button" class="btn bg-teal btn-xs" data-popup="tooltip" id="btnGuardarComentario"
                                    title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                    value="Create">
                                <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                            </button>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-12 ">
                            <table class="table table-hover table-xxs datatable-basic form-compact " id="tblComentarios">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Acciones</th>
                                        <th>Comentario</th>
                                        <th>Usuario</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
