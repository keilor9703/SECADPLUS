@Scripts.Render("~/bundle/BienesRelacionadosCreateJs")

<script>
    $(".chosen-select").chosen();
    InicializarElementos("CREAR");
    var urlLineas = '@Url.Action("GetLineasByMarca", "BienesRelacionadosEvento")';
    var urlClaseNovedad = '@Url.Action("GetClaseNovedad", "BienesRelacionadosEvento")';
    var urlActionCargaCiudades = "@(Url.Action("CargaCiudades", "BienesRelacionadosEvento"))";
    var urlsCargaBarrios = "@(Url.Action("CargarTodosLosBarrios", "BienesRelacionadosEvento"))";
    var urlsInfracciones = "@(Url.Action("CargaInfracciones", "BienesRelacionadosEvento"))";
    var urlsParqueaderos = "@(Url.Action("VerParqueaderos", "BienesRelacionadosEvento"))";
    var urlsUnidades = "@(Url.Action("ObtenerUnidades", "BienesRelacionadosEvento"))";
    var urlsMedios = "@(Url.Action("ObtenerMedios", "BienesRelacionadosEvento"))";





</script>
