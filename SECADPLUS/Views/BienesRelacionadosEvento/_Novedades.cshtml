                                                <div class="col-md-12">
                                                    @* @Html.EditorFor(model => model.VEHI_SIGLA, new { htmlAttributes = new { @class = "form-control" } })*@
                                                    @Html.DropDownList("VEHI_SIGLA", null, "", htmlAttributes: new { @class = "chosen-select" })
                                                    @Html.ValidationMessageFor(model => model.VEHI_SIGLA, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>



                        <!-- /inicio de tabla -->
                    </div>
                </div>
                <!-- Panel Entidades -->

            </div>
        </div>
    </div>

    <div class="col-md-12">
        <!-- Panel con Tablas -->
        <div class="panel panel-flat">


            <div class="panel-body">
                <fieldset class="content-group">

                    <div>
                        <div class="row">


                            <div class="col-md-12 col-lg-3">
                                <div class="form-group ">
                                    <label class="control-label">Sitio Graba:</label>
                                    <div class="row">
                                        <div class="col-md-12">
                                         @*   @Html.Editor("", new { htmlAttributes = new { @class = "form-control", @placeholder = "", @maxlength = "100", @readonly = "readonly" } })*@
                                            <input type="text" class="form-control readonly" placeholder=""  readonly="readonly"/>

                                            @Html.ValidationMessageFor(model => model.PEDI_SITIOGRABA, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-lg-3">
                                <div class="form-group ">
                                    <label class="control-label">Numero llamada:</label>
                                    <div class="row">
                                        <div class="col-md-12">
                                          @*  @Html.Editor("", new { htmlAttributes = new { @class = "form-control", @placeholder = "", @maxlength = "30", @readonly = "readonly" } })*@
                                            <input type="text" class="form-control readonly" placeholder=""  readonly="readonly"/>
                                            @Html.ValidationMessageFor(model => model.PEDI_NUMELLAMADA, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-lg-3">
                                <div class="form-group ">
                                    <label class="control-label">Usuario:</label>
                                    <div class="row">
                                        <div class="col-md-12">
                                         @*   @Html.Editor("", new { htmlAttributes = new { @class = "form-control", @placeholder = "", @maxlength = "100", @readonly = "readonly" } })*@
                                            <input type="text" class="form-control readonly" placeholder=""  readonly="readonly"/>
                                            @Html.ValidationMessageFor(model => model.USUA_TRANSACCION, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 col-lg-3">
                                <div class="form-group">
                                    <label>Fecha Transacción:</label>
                                    <div class="row">
                                        <div class="col-md-12">
                                         @*   @Html.Editor("", new { htmlAttributes = new { @class = "form-control", @placeholder = "Autogenerado", @readonly = "readonly" } })*@
                                            <input type="text" class="form-control readonly" placeholder=""  readonly="readonly"/>
                                            @Html.ValidationMessageFor(model => model.FECHA_TRANSACCION, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <br />

                        </div>




                        <div class="row">
                            <br />
                            <div class="col-xs-6 col-md-6 text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla"
                                        onclick="window.location.href ='@Url.Action("Index", "BienesRelacionadosEvento")'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Listar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                        value="Create">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </div>

                </fieldset>
            </div>
