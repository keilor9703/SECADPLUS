                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-lg-2">
                                        <div class="form-group">
                                            <label class="control-label">Modalidad:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.DropDownList("MODA_CODIGO", null, "", htmlAttributes: new { @class = "chosen-select" })
                                                        @Html.ValidationMessageFor(model => model.MODA_CODIGO, "", new { @class = "text-danger" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-lg-2">
