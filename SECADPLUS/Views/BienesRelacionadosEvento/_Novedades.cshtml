                                                                        title="" data-placement="bottom" data-original-title="Clic para buscar" onclick="CargarInfracciones()">
                                                                    <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">

