                                        <div class="form-group">
                                            <label class="control-label">Consecutivo:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    @Html.Editor("CONSECUTIVO2", new { htmlAttributes = new { @class = "form-control", @placeholder = "Autogenerado", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-lg-2">
                                        <div class="form-group obligatorio">
