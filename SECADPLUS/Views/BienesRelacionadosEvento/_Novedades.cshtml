                                                        @Html.EditorFor(model => model.FECHA_NOVEDAD, new { htmlAttributes = new { @class = "form-control daterange-basic FechaHora" } })
                                                        @Html.ValidationMessageFor(model => model.FECHA_NOVEDAD, "", new { @class = "text-danger" })




                                                    </div>


                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="col-md-12 col-lg-2">
                                        <div class="form-group">
                                            <label class="control-label">Estado Novedad:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        <select id="ESTADO_NOVEDAD" name="ESTADO_NOVEDAD" class="chosen-select">
