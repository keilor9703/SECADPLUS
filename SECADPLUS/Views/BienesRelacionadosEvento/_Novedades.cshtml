                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="form-group">
                                                        @Html.DropDownList("TIIN_CODIGO", null, "", htmlAttributes: new { @class = "chosen-select" })
                                                        @Html.ValidationMessageFor(model => model.TIIN_CODIGO, "", new { @class = "text-danger" })
                                                    </div>
