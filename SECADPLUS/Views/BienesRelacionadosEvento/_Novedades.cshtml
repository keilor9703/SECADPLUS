                                                    <input type="text" class="form-control" value="@(Model.OBSERVACIONES == null ? "" : Model.OBSERVACIONES  )" placeholder="Escriba observaciones" name="OBSERVACIONES" />
                                                    @Html.ValidationMessageFor(model => model.OBSERVACIONES, "", new { @class = "text-danger" })
                                                </div>



                                            </div>
                                        </div>
                                    </div>
