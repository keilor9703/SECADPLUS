                        Datos de Inmovilizaciones:
                        <a class="control-arrow" data-toggle="collapse" data-target="#panelInmovilizaciones">
                            <i class="icon-circle-down2"></i>
                        </a>
                    </legend>
                    <div class="collapse in" id="panelInmovilizaciones">
                        <!-- /inicio de tabla -->
