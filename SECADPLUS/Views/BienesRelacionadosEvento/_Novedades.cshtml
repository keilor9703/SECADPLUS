                                            <label class="control-label">Barrio:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="input-group">
                                                        <div class="col-md-6">
                                                            <input type="text" id="DESCR_BARRIO" name="DESCR_BARRIO" class="form-control" readonly="readonly" />
