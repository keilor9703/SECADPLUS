@model SECADEntities.SECAD.CADBIENES_NOVEDADES

@using (Html.BeginForm("CreateN", "BienesRelacionadosEvento", FormMethod.Post, new { @class = "form-compact" }))
{
    <div class="col-md-12">
        <!-- Panel con Tablas -->
        <div class="panel panel-flat">
            @*<div class="panel-heading">
                <h5 class="panel-title">Novedades:</h5>
                <div class="heading-elements">
                    <ul class="icons-list">
                        <li>
                        </li>
                        <li><a data-action="collapse"></a></li>
                    </ul>
                </div>
            </div>*@

            <div class="panel-body">
               

                    <!-- Panel Entidades -->
                    <div class="col-md-12">
                        <legend class="text-semibold">
                            Novedades
                            <a class="control-arrow" data-toggle="collapse" data-target="#panelBien1">
                                <i class="icon-circle-down2"></i>
                            </a>
                        </legend>
                        <div class="collapse in panel-body" id="panelBien1">
