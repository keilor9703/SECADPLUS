                                    <div class="col-md-12 col-lg-12">
                                        <div class="form-group">
                                            <label class="control-label">Infr Codigo:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div>
                                                        <div class="col-md-1">
                                                            <input type="text" id="INFR_CODIGO" name="INFR_CODIGO" class="form-control" readonly="readonly" />
