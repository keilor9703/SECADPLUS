                                                        </div>
                                                        <div class="col-md-9">
                                                            <input type="text" id="DESCR_PARQUEADERO" name="DESCR_PARQUEADERO" class="form-control" readonly="readonly" />

                                                        </div>
                                                        <div class="col-md-2">
                                                            <span class="input-group-btn">
                                                                <button type="button" id="_btnParqueadero" class="btn btn-success btn-mixed" data-popup="tooltip"
                                                                        title="" data-placement="bottom" data-original-title="Clic para buscar" onclick="CargarParqueaderos()">
                                                                    <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12 col-lg-4">
                                        <div class="form-group">
                                            <label class="control-label">Unidad:</label>
                                            <div class="row">
                                                <div class="col-md-12">
