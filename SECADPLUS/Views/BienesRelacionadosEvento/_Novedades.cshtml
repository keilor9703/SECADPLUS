                                                                <button type="button" id="_btnUnidad" class="btn btn-success btn-mixed" data-popup="tooltip"
                                                                        title="" data-placement="bottom" data-original-title="Clic para buscar" onclick="CargarUnidades()">
                                                                    <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                                </button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-12 col-lg-4">
                                        <div class="form-group">
                                            <label class="control-label">Medios:</label>
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div>
                                                        <div class="col-md-9">
                                                            <input type="text" id="DESCR_PATRULLA" name="DESCR_PATRULLA" class="form-control" readonly="readonly" />
