@model SECADEntities.SecadLugaresGeograficos.CADBARRIO

@{
    ViewBag.Title = "Creación de Lugares Geográficos";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
}
<!-- Content area -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Creación de Lugares Geográficos</h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>

        <div class="panel-body">

            <!-- Formulario -->
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @*<form action="#">*@
                <fieldset class="content-group">
                    <div class="row">
                        <div class="col-md-12 col-lg-4">
                            <div class="form-group obligatorio">
                                @Html.LabelFor(model => model.CODIGO, htmlAttributes: new { @class = "control-label col-md-2" })
                                @Html.EditorFor(model => model.CODIGO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el código" } })
                                @Html.ValidationMessageFor(model => model.CODIGO, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-4">
                            <div class="form-group obligatorio">
                                @Html.LabelFor(model => model.DESCRIPCION, htmlAttributes: new { @class = "control-label col-md-2" })

                                @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la descripción" } })
                                @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-4">
                            <div class="form-group">
                                <label class="obligatorio control-label" data-popup="tooltip" title="" data-placement="right"
                                       data-original-title="Seleccione código Luge">Luge Código:</label>
                                <div class="form-group">
                                    @Html.DropDownList("LUGE_CODIGO", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    @Html.ValidationMessageFor(model => model.LUGE_CODIGO, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 col-lg-4">
                            <div class="form-group">
                                <label class="obligatorio control-label" data-popup="tooltip" title="" data-placement="right"
                                       data-original-title="Seleccione código Luge">Cozo Código:</label>
                                <div class="form-group">
                                    @Html.DropDownList("COZO_CODIGO", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    @Html.ValidationMessageFor(model => model.COZO_CODIGO, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-4">
                            <div class="form-group">
                                <label class="obligatorio control-label" data-popup="tooltip" title="" data-placement="right"
                                       data-original-title="Seleccione código Luge">Cozo Luge:</label>
                                <div class="form-group">
                                    @Html.DropDownList("COZO_LUGE_CODIGO", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    @Html.ValidationMessageFor(model => model.COZO_LUGE_CODIGO, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <!-- Botones de regresar y guardar -->
                    <div class="row">
                        <div class="col-xs-6 col-md-6text-left">
                            <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                    data-original-title="Clic para regresar a la tabla" onclick="javascript: window.close();">
                                <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                            </button>
                        </div>

                        <div class="col-xs-6 col-md-6 text-right">
                            <button type="submit" value="Create" class="btn bg-teal" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para guardar cambios">
                                <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                            </button>
                        </div>
                    </div>
                    <!-- /botones de regresar y guardar -->
                </fieldset>
                @*</form>*@
            }
            <!-- /formulario -->
        </div>
    </div>
    <!-- /panel  -->

</div>
@section PostScripts{
    <script>$(".chosen-select").chosen();</script>
    @Scripts.Render("~/bundle/CheckSwitchJs");
}
<!-- /content area -->
