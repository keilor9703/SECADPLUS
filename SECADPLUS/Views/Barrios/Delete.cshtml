@model SECADEntities.SecadLugaresGeograficos.CADBARRIO


@{
    ViewBag.Title = "Borrar Lugar Geográfico";
}
<div class="content">
    @Html.Partial("_Mensajes")
    @using (Html.BeginForm())
    {
        <div class="row">
            <!-- Formulario -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Borra Lugar Geográfico</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <h4>¿Está seguro que desea borrar este elemento?</h4>
                        <hr />
                        <div class="form-group col-md-12">

                            <div class="form-control col-md-12">
                                Descripción:
                                @Html.DisplayFor(model => model.DESCRIPCION)
                            </div>
                            <div class="form-control col-md-12">
                                Código:
                                @Html.DisplayFor(model => model.CODIGO)
                            </div>
                            
                            @Html.AntiForgeryToken()
                        </div>

                    </div>
                </div>
            </div>
            <!-- /formulario -->
        </div>
        <div class="row">
            <div class="col-xs-6 col-md-6text-left">
                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                        data-original-title="Clic para regresar a la tabla" onclick="window.close();">
                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                </button>
            </div>

            <div class="col-xs-6 col-md-6 text-right">
                <button type="submit" value="Borrar" class="btn bg-teal" data-popup="tooltip"
                        title="" data-placement="bottom" data-original-title="Clic para borrar">
                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Borrar
                </button>
            </div>
        </div>
    }
</div>
