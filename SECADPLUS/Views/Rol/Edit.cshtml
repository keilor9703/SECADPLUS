@model Microsoft.AspNet.Identity.EntityFramework.IdentityRole
@{
    ViewBag.Title = "Edit";
}

<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <!-- Formulario -->
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h5 class="panel-title">Creación perfíl</h5>
                <div class="heading-elements">
                    <ul class="icons-list decad">
                        <li><a data-action="collapse"></a></li>
                    </ul>
                </div>
            </div>
            <div class="panel-body">

                
                
                @using (Html.BeginForm("Edit", "Rol", FormMethod.Post, new { @class = "form_secad" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)
                    @Html.HiddenFor(model => model.Id)
                    <fieldset class="content-group">
                        <div class="row">
                            <div class="col-xs-6 col-md-6text-left form-group obligatorio">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                <div class="col-md-12 ">
                                    <label for="RoleName" class="control-label">Nombre del Rol</label>
                                    @Html.TextBoxFor(model=>model.Name, null, new { @class = "form-control", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-6 col-md-6text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla" onclick="location.href='@Url.Action("Index")'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </fieldset>
                    
                }
            </div>
        </div>
        <!-- /formulario -->
    </div>
</div>
<!-- /área de contenido -->