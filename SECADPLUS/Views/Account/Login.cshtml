<!-- /loader DECAD -->
<!-- Formulario con validación -->



@using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form", autocomplete = "off" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_Mensajes")
<div class="panel panel-body login-form">
    <!-- Logo policia -->
    <div class="text-center">
        <img class="img-responsive center-block" src="@Url.Content("~/Images/LogoSECAD.png")" alt="..." />
        <h5 class="content-group">Ingrese sus datos</h5>
    </div>
    <!-- Usuario -->
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group has-feedback has-feedback-left ">
        <div class="col-lg-12 form-group">
            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control col-md-12 col-lg-12", autocomplete = "off", placeholder = Html.DisplayNameFor(n => n.UserName) })
            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
            <div class="form-control-feedback">
                <i class="icon-user text-muted"></i>
            </div>
        </div>
    </div>
    <!-- usuario -->
    <!-- Contraseña -->
    <div class="form-group has-feedback has-feedback-left ">
        <div class="col-lg-12 form-group">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control ", placeholder = "Clave", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            <div class="form-control-feedback">
                <i class="icon-lock2 text-muted"></i>
            </div>
        </div>
    </div>
    <!-- contraseña -->
    <!-- Selector de bases de datos -->
    <div class="form-group hidden">
        <div class="col-lg-12 form-group">
            @* <label class="color-text">Seleccione una base de datos </label>*@
            @*@Html.HiddenFor(model => model.Conexion, new { Value = "SECADMETUN" })   @*base de datos quemada*@
              @Html.DropDownListFor(model => model.Conexion, Model.ListaConexiones, new { @class = "form-control", autocomplete = "off" })
            @*@Html.ValidationMessageFor(m => m.Conexion, "", new { @class = "text-danger" })*@
        </div>
    </div>
    <!-- /selector de bases de datos -->
    <!-- Sección de recordar contraseñas -->
    <div class="form-group login-options">
        <div class="row hidden">
            <div class="col-sm-4">
                <label class="checkbox-inline">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "styled" })
                    @Html.LabelFor(m => m.RememberMe)
                </label>
            </div>
            @*<div class="col-sm-8 text-right">
                    <p>
                        @Html.ActionLink("¿Olvido su contraseña?", "ForgotPassword")
                    </p>
                </div>*@
        </div>
    </div>
    <!-- /sección de recordar contraseñas -->
    <div class="form-group">
        <div class="d-flex">
            <div>
                <a href="https://gestionacceso.policia.gov.co:8443/" target="_blank" class="link font-weight-medium"><i class="fa fa-lock me-1" style="margin-left:50px;margin-top:-9px"></i> Cambiar contrase&ntilde;a</a>
            </div>
        </div>
    </div>
    <!-- Botón de ingreso -->
    <div class="form-group">
        <div class="col-lg-12 form-group">
            <button type="submit" id="ingresar" class="btn bg-pink-400 btn-block">Ingresar <i class="icon-arrow-right14 position-right"></i></button>
        </div>
    </div>
    <!-- /botón de ingreso -->
    <!-- Mensaje final -->
    <span class="help-block text-justify no-margin">
        Est&aacute; ingresando a un sistema de informaci&oacute;n de propiedad de la <b>Polic&iacute;a Nacional</b>,
        su uso no autorizado incurre en el incumplimiento de las pol&iacute;ticas de seguridad de la Instituci&oacute;n establecidas en
        el Manual del Sistema de Gesti&oacute;n de Seguridad de la Informaci&oacute;n para la Polic&iacute;a Nacional y acarrea sanciones penales,
        disciplinarias y/o administrativas a que haya lugar; ay&uacute;denos a prevenir la divulgaci&oacute;n no autorizada,
        p&eacute;rdida y/o fuga de la informaci&oacute;n institucional.
    </span>

    <!-- /mensaje final -->
</div>
    @section scripts{
        <script>
            $(function () {
                $("#ingresar").click(function () {

                    $(".loader_decad").removeClass("hidden");
                    $(".loader_back").removeClass("hidden");
                });

            });
        </script>
    }

}