    <div class="loader_dialog">
        <div class="loader_container2 text-center">
            <img src="@Url.Content("~/Images/loader_DECAD.gif")" />
            <h4 class="text-white" id="mensajeLoader">Cargando...</h4>
        </div>
    </div>
</div>
    <div class="loader_back hidden"></div>
