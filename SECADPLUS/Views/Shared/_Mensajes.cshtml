@if (!string.IsNullOrEmpty(ViewBag.MENSAJE_EXITOSO))
{
<div class="row text-center">
    <div class="alert alert-@ViewBag.TIPO_MENSAJE alert-styled-left alert-arrow-left alert-bordered">
        <button type="button" class="close" data-dismiss="alert"><span>×</span><span class="sr-only">Close</span></button>
        <span class="text-semibold">@Html.Raw(ViewBag.MENSAJE_EXITOSO)</span>
    </div>
</div>
}
else if (!string.IsNullOrEmpty(ViewBag.ERROR_MENSAJE))
{
    <div class="row text-center">
        <div class="alert alert-warning alert-styled-left alert-arrow-left alert-bordered">
            <button type="button" class="close" data-dismiss="alert"><span>×</span><span class="sr-only">Close</span></button>
            <span class="text-semibold">@Html.Raw(ViewBag.ERROR_MENSAJE)</span>
        </div>
    </div>
}
    <div class="row text-center" id="alertaJs">
    </div>
