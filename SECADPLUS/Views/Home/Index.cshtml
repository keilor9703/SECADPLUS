    </div>
    <div class="row text-center">

        <h2 class="text-teal">
            <i class="icon-medal-star position-left icon_size-md"></i>

            <span class="text-semibold">Sitio: @ViewBag.Sitio</span>
        </h2>
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="panel panel-body border-left-xlg border-left-teal">
                    <div class="media">
                        <div class="media-left">
                            <i class="icon-earth icon_size-sm"> </i>
                        </div>
                        <div class="media-body">
                            <h6 class="media-heading">Entidad : @ViewBag.Entidad</h6>

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="panel panel-body border-left-xlg border-left-teal">
                    <div class="media">
                        <div class="media-left">
                            <i class="icon-database icon_size-sm"> </i>
                        </div>
                        <div class="media-body">
                            <h6 class="media-heading">Canal : @ViewBag.Canal </h6>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="panel panel-body border-left-xlg border-left-teal">
                    <div class="media">
                        <div class="media-left">
                            <i class="icon-user icon_size-sm"> </i>
                        </div>
                        <div class="media-body">
                            <h6 class="media-heading">
                                Usuario:
                                @if (ViewBag.USER != null)
                                {
                                    @ViewBag.USER.USUARIO
                                }
                            </h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-4 col-md-6">
                @if (!string.IsNullOrEmpty(ViewBag.Maquinas))
                {
                    <form action="@Url.Action("Index","Home")" method="post">
                        <div class="col-md-12 form-group">
                            <div class="col-md-10 col-md-offset-1">
                                @Html.DropDownListFor(model => model.MaquinaSeleccionada, Model.ListaMaquinas, htmlAttributes: new { @class = "chosen-select", id = "ddlMaquina" })
                            </div>
                            <div class="col-md-1">
                                <button type="submit" class="btn btn-xs bg-teal" id="btnSeleccionar"> Seleccionar</button>
                            </div>
                        </div>
                    </form>

                }
                else
                {
                    <div class="panel panel-body border-left-xlg border-left-teal">
                        <div class="media">
                            <div class="media-left">
                                <i class="icon-user-check icon_size-sm"> </i>
                            </div>
                            <div class="media-body">
                                <h6 class="media-heading">Nombre de la máquina: @ViewBag.Maquina</h6>
                            </div>
                        </div>
                    </div>
                }

            </div>
            <div class="col-lg-4 col-md-6">
                <div class="panel panel-body border-left-xlg border-left-teal">
                    <div class="media">
                        <div class="media-left">
                            <i class="icon-file-text icon_size-sm"> </i>
                        </div>
                        <div class="media-body">
                            <h6 class="media-heading">Lectura para v:/@ViewBag.ACD .TXT</h6>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="panel panel-body border-left-xlg border-left-teal">
                    <div class="media">
                        <div class="media-left">
                            <i class="icon-calendar3 icon_size-sm"> </i>
                        </div><div class="media-body">
                            <h6 class="media-heading">Fecha y Hora del Servidor: @ViewBag.FechaHora</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row form-compact">
            @if (Model.ListaACD != null)
            {
                <div class="col-md-12 form-group">
                    <div class="col-md-2 col-md-offset-4">
                        @Html.DropDownListFor(model => model.ACDseleccionado, Model.ListaACD, string.Empty, htmlAttributes: new { @class = "chosen-select", id = "listaAcd" })
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-xs bg-teal" id="btnCambiarAcd"> Cambiar ACD</button>
                    </div>
                </div>
            }

        </div>

    </div>

</div>
