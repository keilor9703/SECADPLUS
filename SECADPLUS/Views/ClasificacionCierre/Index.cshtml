@model IEnumerable<SECADEntities.SECAD.CADCLASIFICACION_CIERRE>

@{
    ViewBag.Title = "Clasiicación de Cierre";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ChosenJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat form-compact">
                <div class="panel-heading">
                    <h5 class="panel-title">Clasificaciones de Cierre para: @ViewBag.nombreEntidad</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button id="btnNuevo" onclick="location.href='@Url.Action("Create", "ClasificacionCierre", new { idSitio=ViewBag.idSitio ,idEntidad = ViewBag.idEntidad, nombreEntidad = ViewBag.nombreEntidad })'" class="btn btn-success btn-xs" data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para nueva clasificación de cierre">
                                    Nuevo<b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="_tblEntidades">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td></td>
                                <td>
                                    <ul class="icons-list">
                                        <li class="dropdown">
                                            <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat
                                                                dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                                                <i class="icon-menu9"></i>
                                            </button>
                                            <ul class="dropdown-menu secad dropdown-menu-left">
                                                <li>
                                                    <button class="btn btn-xs btn-default " type="button" data-popup="tooltip"
                                                            title="" data-placement="bottom" data-original-title="Clic para editar @item.DESCRIPCION"
                                                            onclick="window.location.href ='@Url.Action("Edit","ClasificacionCierre",new { id=item.CODIGO,idSitio=ViewBag.idSitio, idEntidad = item.ID_FUERZA, nombreEntidad=item.CADFUERZA.DESCRIPCION })'">
                                                        <i class="icon-pencil"></i> Editar
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="btn btn-xs btn-default " type="button" data-popup="tooltip"
                                                            title="" data-placement="bottom" data-original-title="Clic para eliminar @item.DESCRIPCION"
                                                            onclick="EliminarElemento('@Url.Action("Eliminar","ClasificacionCierre",new { id=item.CODIGO,idSitio=ViewBag.idSitio, idEntidad = item.ID_FUERZA, nombreEntidad=item.CADFUERZA.DESCRIPCION })')">
                                                        <i class="icon-trash"></i> Borrar
                                                    </button>
                                                </li>
                                            </ul>
                                        </li>
                                    </ul>
                                </td>
                                <td>@Html.DisplayFor(modelItem => item.CODIGO)</td>
                                <td>@Html.DisplayFor(modelItem => item.DESCRIPCION)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- /inicio de tabla -->
            </div>
            <!-- /panel con Tablas -->
        </div>
    </div>
    <div class="row">
        <div class="col-xs-6 col-md-6text-left">
            <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                    data-original-title="Clic para regresar a las entidades" onclick="location.href=('@Url.Action("Index", "Entidades", new { id= ViewBag.idEntidad, idSitioGrabacion= ViewBag.idSitio, nombre = ViewBag.nombreEntidad })')">
                <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar a Entidades
            </button>
        </div>
    </div>
</div>
<!-- /área de contenido -->
@section PostScripts{

    @Scripts.Render("~/bundle/EntidadesControllerJs")
    @Scripts.Render("~/bundle/ModalsJs")
}
