@model SECADEntities.SECAD.CADCARACTERISTICA

@{
    ViewBag.Title = "Editar Caracteristicas";
}

<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Editar Caracteristicas:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "form-compact" }))
                {

                    <div class="panel-body">
                        <fieldset class="content-group">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.TIBI_CODIGO)
                            @Html.HiddenFor(model => model.CODIGO)
                            @Html.Hidden("id")
                            @Html.Hidden("nom")
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Tipo de Bien:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.Editor("TIPO_BIEN", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-4">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Caracteristicas:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba caracteristicas" } })
                                                @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-4">
                                    <div class="form-group">
                                        <label>Tipo:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.TIPO, new { htmlAttributes = new { @class = "form-control", @maxlength = 1, @placeholder = "Escriba tipo" } })
                                                @Html.ValidationMessageFor(model => model.TIPO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-4">
                                    <div class="form-group ">
                                        <label>Tamaño:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.TAMANO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba tamaño" } })
                                                @Html.ValidationMessageFor(model => model.TAMANO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla"
                                        onclick="window.location.href ='@Url.Action("Index", "ElementosMaestras", new { id = Model.TIBI_CODIGO, nom = @ViewBag.nom })'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                        value="Save">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <!-- /formulario -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
