@*@model IEnumerable<SECADEntities.SECAD.CADREFERENCIASSECAD>*@

@{
    ViewBag.Title = "Llamadas General Sala";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Llamadas Recepcionadas:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaGral">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nume Llamada</th>
                            <th>Nume Teléfono</th>
                            <th>Hora</th>
                            <th>Código1</th>
                            <th>Mpio</th>
                            <th>Dire Caso</th>
                            <th>Barrio</th>
                            <th>Comentario</th>
                            <th>Tipo Pedido</th>
                            <th>Cali Pedido</th>
                            <th>Estado Llamada</th>
                            <th>Tipo Genero</th>
                            <th>Receptor</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->

@section PostScripts{
    <script>
        var globalSitio = @ViewBag.globalSitio;
        var urlTablaGralSala = '@Url.Action("VerPedidosEfectivosRecibidos", "LlamadasGralSala")';
        
        
    </script>

    @Scripts.Render("~/bundle/LlamadasGralSalaJs")

}