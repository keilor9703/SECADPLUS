@*@model IEnumerable<SECADEntities.SECAD.CADREFERENCIASSECAD>*@

@{
    ViewBag.Title = "Referencias Generales del SECAD123";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    @Html.Partial("_NavegacionAdmonGeneral")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Referencias Generales del SECAD123:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nueva referencia"
                                        onclick="window.location.href ='@Url.Action("Create")'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nueva referencia
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tabla">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Abreviatura</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
<script type="text/javascript">
    var urlTabla = '@Url.Action("GetReferenciasSECAD", "ReferenciasSECAD")';
    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////
</script>
@Scripts.Render("~/bundle/ReferenciasSECADJs")