@model SECADEntities.SECAD.CADFUERZA

@{
    ViewBag.Title = "Crea Entidad";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/CalendarioJs")
    @Scripts.Render("~/bundle/EntidadesControllerJs")
    @Scripts.Render("~/bundle/CheckSwitchJs")

}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Crea Entidad Disponible SECAD 123 del Sitio de Grabación temporal: @ViewBag.SITIO_GRABA_nombre </h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
        @using (Html.BeginForm("Create", "Entidades", FormMethod.Post, new { @class = "form-compact", enctype = "multipart/form-data" }))
        {
            <div class="panel-body">
                <!-- Formulario -->
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <fieldset class="content-group">
                    <div class="row">
                        <div class="col-md-9">
                            <div class="col-lg-12 col-md-12">
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ID, "Código", htmlAttributes: new { @class = "control-label " })
                                        @Html.EditorFor(model => model.ID, new { htmlAttributes = new { @class = "form-control", @placeholder = "El código se generará automáticamente", type = "number", @readonly = "readonly" } })
                                        @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group">
                                        <div class="form-group">
                                            @Html.LabelFor(model => model.DESCRIPCION, "Descripción", htmlAttributes: new { @class = "control-label " })
                                            @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la descripción", required = true }, maxlength = "60" })
                                            @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.ABREVIATURA, "Abreviatura", htmlAttributes: new { @class = "control-label " })
                                        @Html.EditorFor(model => model.ABREVIATURA, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la abreviatura", maxlength = "10" } })
                                        @Html.ValidationMessageFor(model => model.ABREVIATURA, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12">

                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group obligatorio">
                                        @Html.LabelFor(model => model.CADUNDE_FUERZA, "Fuerza Asociada", htmlAttributes: new { @class = "control-label " })
                                        @Html.DropDownList("CADUNDE_FUERZA", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione la fuerza asociada" })
                                        @Html.ValidationMessageFor(model => model.CADUNDE_FUERZA, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group obligatorio">
                                        @Html.LabelFor(model => model.CADUNDE_CODIGO_PPAL, "Unidad Principal", htmlAttributes: new { @class = "control-label " })
                                        @Html.DropDownList("CADUNDE_CODIGO_PPAL", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione la unidad principal" })
                                        @Html.ValidationMessageFor(model => model.CADUNDE_CODIGO_PPAL, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Unidad:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="input-group">
                                                    @Html.Hidden("CADUNDE_CODIGO")
                                                    @Html.TextBox("_UNIDAD", null, htmlAttributes: new { @class = "form-control ", placeholder = "Seleccione la unidad", @readonly = true, id = "_UNIDAD" })
                                                    <span class="input-group-btn">
                                                        <button type="button" onclick="cargarUnidades()" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                                title="" data-placement="bottom" data-original-title="Clic para buscar">
                                                            <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                        </button>
                                                    </span>
                                                </div>
                                                @Html.ValidationMessageFor(model => model.CADUNDE_CODIGO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12">
                                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.DESDE, "Fecha Desde", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="col-md-12">
                                            <div class="input-group">
                                                <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                                @Html.EditorFor(model => model.DESDE, new { htmlAttributes = new { @class = "form-control pickadate-accessibility", @placeholder = "Escoja la Fecha" } })
                                                @Html.ValidationMessageFor(model => model.DESDE, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.HASTA, "Fecha Hasta", htmlAttributes: new { @class = "control-label col-md-12" })
                                        <div class="col-md-12">
                                            <div class="input-group">
                                                <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                                @Html.EditorFor(model => model.HASTA, new { htmlAttributes = new { @class = "form-control pickadate-accessibility", @placeholder = "Escoja la Fecha" } })
                                                @Html.ValidationMessageFor(model => model.HASTA, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12">
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.HORAS_TURNO, "Máximo Horas Turno", htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.HORAS_TURNO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba las horas por turno" } })
                                        @Html.ValidationMessageFor(model => model.HORAS_TURNO, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    @Html.LabelFor(model => model.VIGENTE, "Vigente", htmlAttributes: new { @class = "control-label " })
                                    <div class="form-group">

                                        @Html.CheckBox("VIGENTE", htmlAttributes: new { @class = "switch checkbox checkbox-switch", data_on_color = "success", data_size = "mini", data_off_color = "danger", data_on_text = "SÍ", data_off_text = "NO", @checked = "checked" })
                                        @Html.ValidationMessageFor(model => model.VIGENTE, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-4 col-md-4 col-lg-4">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.OBSERVACION, "Observación", htmlAttributes: new { @class = "control-label" })
                                        @Html.EditorFor(model => model.OBSERVACION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba las observaciones", maxlength = "200" } })
                                        @Html.ValidationMessageFor(model => model.OBSERVACION, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-12 col-lg-6">
                                    <div class="form-group">
                                        @Html.Hidden("SITIO_GRABA", (string)ViewBag.SITIO_GRABA)
                                        @Html.Hidden("SITIO_GRABA_nombre", (string)ViewBag.SITIO_GRABA_nombre)


                                        @Html.HiddenFor(model => model.FECH_TRANSACCION, new { htmlAttributes = new { @class = "form-control" } })


                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <figure class="text-center col-xs-8 col-sm-8 col-md-8 col-lg-8">
                                    <img class="img-thumbnail img-responsive" src="@ViewBag.foto" id="thumbnil" />
                                </figure>
                                <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8">
                                    <input type="file" class="btn file-styled-secad btn-success btn-xs col-md-12" id="uploader" name="uploader" accept="image/gif, image/jpeg, image/tiff, image/bmp" onchange="MuestraImagen(this)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <!-- /formulario -->
            </div>
            <div class="panel-footer">
                <!-- Botones de regresar y guardar -->
                <div class="row">
                    <div class="col-xs-6 col-md-6text-left">
                        <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                data-original-title="Clic para regresar a la tabla" onclick="location.href=('@Url.Action("Index", "Entidades", new { idSitioGrabacion = ViewBag.SITIO_GRABA, nombre = @ViewBag.SITIO_GRABA_nombre})')">
                            <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                        </button>
                    </div>
                    <div class="col-xs-6 col-md-6 text-right">
                        <button type="submit" value="Create" class="btn bg-teal" data-popup="tooltip"
                                title="" data-placement="bottom" data-original-title="Clic para crear">
                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                        </button>
                    </div>
                </div>
                <!-- /botones de regresar y guardar -->
            </div>
        }
    </div>
    <!-- /panel  -->
</div>
<!-- /área de contenido -->
<!-- Modal Unidades -->
<div id="ModalUnidades" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Unidades</h5>
            </div>
            <div class="modal-body form-compact">
                <table id="tablaUnidades" class="table table-hover table-xxs datatable-basic modal_table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Unidades -->

@Scripts.Render("~/bundle/FormularioJs")
@Scripts.Render("~/bundle/InputsJs")
@section PostScripts{
    <script>
        fechaActual = new Date();
        AplicarControlFecha("#DESDE", fechaActual);
        AplicarControlFecha("#HASTA", fechaActual);
        urlActionBuscaUnidades = "@(Url.Action("BuscaUnidadesPorFuerza", "Entidades"))";
        urlActionUnidadesPorUnidadPrincipal = "@(Url.Action("BuscaUnidadesPorUnidadPrincipal", "Entidades"))";
        var urlUnidad = '@Url.Action("GetUnidadesByFuerza", "Entidades")';
        var urlTablaUnidades = '@Url.Action("GetUnidades", "Entidades")';
    </script>
}
