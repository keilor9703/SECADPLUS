@model IEnumerable<SECADEntities.SECAD.V_FORM_SITIOS_GRABACION>

@{
    ViewBag.Title = "Entidades que Interactuan en CAD 123";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/TablasJs")
}
<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat form-compact">
                <div class="panel-heading">
                    <h5 class="panel-title">Seleccione el sitio de grabación para las entidades SECAD 123:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tblSitiosGrabacion">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Consecutivo</th>
                            <th>Descripción</th>
                            <th>Departamento</th>
                            <th>Ciudad/Municipio</th>
                            <th>Fuerza</th>
                            <th>Código Unidad</th>
                            <th>Unidad</th>
                            <th>Fecha de instalación</th>
                            @*<th>Código regional</th>
                    <th>Regional</th>*@
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
            <!-- /panel con Tablas -->
        </div>
    </div>
</div>
<!-- /área de contenido -->
@section PostScripts{

    @Scripts.Render("~/bundle/EntidadesControllerJs")
    @Scripts.Render("~/bundle/SitiosGrabacionJs")
    <script>
        AplicarPluginTabla("_sitiosGrabacionEntidades");
        AplicarPluginTabla("_tblEntidades");
        var UrlConsultarSitiosGrabacion = "@Url.Action("ConsultarSitiosGrabacion", "SitiosGrabacion")";
        ConsultarSitios("ENTIDADES");
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
}