@model SECADEntities.SECAD.CADCONDUCTA

@{
    ViewBag.Title = "Eliminar Título de Conductas";
}


<h3>¿Desea eliminar el registro?</h3>
<div>

    Código: @Html.DisplayFor(model => model.CODIGO)
    <br />
    Descripción: @Html.DisplayFor(model => model.DESCRIPCION)

    @using (Html.BeginForm("Delete", "MaestraConductas", new { id = Model.CODIGO, idTipo = Model.TIPO, nomTipo = @ViewBag.nomTipo }, FormMethod.Post, new { @class = "form_secad", @id = "form_eliminar" }))
    {
        @Html.AntiForgeryToken()

    }
</div>
