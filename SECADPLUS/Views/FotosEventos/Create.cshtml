@model SECADEntities.SecadEntities.CADEVENTOS_FOTOS
@{
    ViewBag.Title = "Crea Evento Fotos";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/CalendarioJs")
    @Scripts.Render("~/bundle/CrearFotosEventosJs")    
}
<!-- Content area -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Adicción de fotos del evento </h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
@using (Html.BeginForm("Crear", "FotosEventos", FormMethod.Post, new { @class = "form-compact", enctype = "multipart/form-data" }))
{

        <div class="panel-body">
            <!-- Formulario -->
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <fieldset class="content-group">
                <div class="row">
                    <div class="col-md-8">
                        <div class="col-md-12">
                            <div class="col-xs-12 col-sm-2 col-md-2 col-lg-4 ">
                                <div class="form-group">
                                    @Html.Label("Numero Evento", htmlAttributes: new { @class = "control-label" })
                                    <input id="txtNumeroEvento" name="CADEVEN_NUMEEVENTO" placeholder="" class="form-control" value="@Model.CADEVEN_NUMEEVENTO" readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-xs-12 col-sm-2 col-md-2 col-lg-4 ">
                                <div class="form-group">
                                    @Html.Label("Consecutivo", htmlAttributes: new { @class = "control-label" })
                                    <input id="txtConsecutivo" name="CONSECUTIVO" placeholder="" class="form-control" value="@Model.CONSECUTIVO" readonly="readonly" />
                                </div>
                            </div>


                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="col-md-12">
                            <div class="col-xs-12 col-sm-2 col-md-2 col-lg-8 obligatorio">
                                <div class="form-group">
                                    @Html.Label("Observaciones", htmlAttributes: new { @class = "control-label" })
                                    <textarea id="txtObservaciones" style="resize:none;height:60px" maxlength="100" name="OBSERVACION" placeholder="" class="form-control" >@Model.OBSERVACION</textarea>                     
                                    @Html.ValidationMessageFor(m => m.OBSERVACION, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                        <div class="form-group">
                            @Html.Label("Foto", htmlAttributes: new { @class = "control-label" })
                            <div class="row">
                                <figure class="text-center col-xs-5 col-sm-5 col-md-5 col-lg-5">
                                    <img class="img-thumbnail img-responsive" src="~/images/Avatar.png" id="thumbnil" style="width:100%" />
                                </figure>
                                <div class="col-xs-8 col-sm-8 col-md-8 col-lg-8">
                                    <input type="file" class="file-styled-secad btn-success btn-xs" id="uploader" name="uploader" accept="image/gif, image/jpeg, image/tiff, image/bmp" onchange="MuestraImagen(this)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

            <!-- /formulario -->
        </div>
        <div class="panel-footer">
            <!-- Botones de regresar y guardar -->
            <div class="row">
                <div class="col-xs-6 col-md-6text-left">
                    <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                            data-original-title="Clic para regresar a la tabla" onclick="location.href=('@Url.Action("FotosEventos", "FotosEventos")');">
                        <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                    </button>
                </div>
                <div class="col-xs-6 col-md-6 text-right">
                    <button type="submit" value="Crear" class="btn bg-teal" data-popup="tooltip"
                            title="" data-placement="bottom" data-original-title="Clic para crear">
                        <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                    </button>
                </div>
            </div>
            <!-- /botones de regresar y guardar -->
        </div>
}
    </div>
    <!-- /panel  -->
</div>
<!-- /área de contenido -->

@Scripts.Render("~/bundle/FormularioJs")
@Scripts.Render("~/bundle/InputsJs")
