
@{
    ViewBag.Title = "Anotaciones generales";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}


<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Tabla de Anotaciones Generales:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear anotación"
                                        onclick="window.location.href ='@Url.Action("Create")'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear anotación
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaAnotaciones">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>usuario</th>
                            <th>Consecutivo</th>
                            <th>Sitio Graba</th>
                            <th>Fecha Grabación </th>
                            <th>Anotación</th>
                            <th>Maquina</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- Área de contenido -->
<script type="text/javascript">
    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////
    var urlTabla = '@Url.Action("ObtenerAnotacionesGnr", "AnotacionesGenerales")';

</script>
@Scripts.Render("~/bundle/AnotacionesGeneralesJs")
