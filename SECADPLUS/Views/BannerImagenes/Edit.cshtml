@model SECADEntities.SecadLugaresGeograficos.CADBANNERIMAGENE

@{
    ViewBag.Title = "Edita Banner";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/CalendarioJs")
    @Scripts.Render("~/bundle/BannerControllerJs")
}
<!-- Content area -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Edita Banner: </h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
        @using (Html.BeginForm("Edit", "BannerImagenes", FormMethod.Post, new { @class = "form-compact", enctype = "multipart/form-data" }))
        {
            <div class="panel-body">
                <!-- Formulario -->
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <fieldset class="content-group">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="col-md-5 obligatorio">
                                @Html.LabelFor(model => model.NOMBREARCHIVO, "Nombre del Archivo", htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-12 ">
                                    <div class="form-group ">
                                        @Html.HiddenFor(model => model.IDBANNER, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el nombre que guardará" } })
                                        @Html.HiddenFor(model => model.FECHACREACION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el nombre que guardará" } })
                                        @Html.EditorFor(model => model.NOMBREARCHIVO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el nombre que guardará" } })
                                        @Html.ValidationMessageFor(model => model.NOMBREARCHIVO, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                @Html.LabelFor(model => model.ORDEN, "Escriba el orden de aparición", htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-12 ">
                                    <div class="form-group ">
                                        @Html.EditorFor(model => model.ORDEN, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el orden" } })
                                        @Html.ValidationMessageFor(model => model.ORDEN, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                @Html.LabelFor(model => model.ACTIVO, "Activo", htmlAttributes: new { @class = "control-label col-md-12" })
                                <div class="col-xs-12 col-sm-6 col-md-6 col-lg-2">
                                    <div class="form-group">
                                        <div class="form-group">
                                            @Html.CheckBoxFor(model => model.ACTIVO, htmlAttributes: new { @class = "switch checkbox checkbox-switch", data_on_color = "success", data_off_color = "danger", data_on_text = "ACTIVO", data_off_text = "INACTIVO", @checked = "checked" })
                                            @Html.ValidationMessageFor(model => model.ACTIVO, "", new { @class = "text-danger" })

                                        </div>
                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
                            <div class="form-group">
                                <div class="row">
                                    <figure class="col-lg-12 text-center">
                                        <img class="img-thumbnail img-responsive" src="@ViewBag.banner" id="thumbnil" style="width:100%" />
                                    </figure>
                                    <div class="col-lg-12 space_up">
                                        <input type="file" class="file-styled-secad btn-success btn-xs" id="uploader" name="uploader" accept="image/gif, image/jpeg, image/tiff" onchange="MuestraImagen(this)" />
                                    </div>
                                    <div id="nombres"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <!-- /formulario -->
            </div>
            <div class="panel-footer">
                <!-- Botones de regresar y guardar -->
                <div class="row">
                    <div class="col-xs-6 col-md-6text-left">
                        <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                data-original-title="Clic para regresar a la tabla" onclick="location.href=('@Url.Action("index", "BannerImagenes")');">
                            <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                        </button>
                    </div>
                    <div class="col-xs-6 col-md-6 text-right">
                        <button type="submit" value="Edit" class="btn bg-teal" data-popup="tooltip"
                                title="" data-placement="bottom" data-original-title="Clic para crear">
                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                        </button>
                    </div>
                </div>
                <!-- /botones de regresar y guardar -->
            </div>
        }
    </div>
    <!-- /panel  -->
</div>
@section PostScripts{

    @Scripts.Render("~/bundle/CheckSwitchJs");
}