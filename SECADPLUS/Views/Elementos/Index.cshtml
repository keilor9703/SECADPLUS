@model IEnumerable<SECADEntities.SecadEntities.CADNETELEMENTO>

@{
    ViewBag.Title = "Index";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    }

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Creación de Elementos</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip" onclick="location.href='@Url.Action("Create", "Elementos")'"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo Elemento">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo Elemento
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <table class="table table-hover table-xxs datatable-basic" id="tablaElementos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>
                                Elemento
                            </th>
                            <th>
                                Elemento Padre
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ELEMENTO_RUTA)
                            </th>
                            
                            <th>
                                @Html.DisplayNameFor(model => model.ELEMENTO_POSICION)
                            </th>
                           
                            <th>
                                Tipo Elemento
                            </th>
                            
                            <th>
                                @Html.DisplayNameFor(model => model.ELEMENTO_ICONO)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ELEMENTO_ESTADO)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.ELEMENTO_FECHA_CREACION)
                            </th>
                            
                        </tr>
                        </thead>
            </table>
            </div>
        </div>
    </div>
</div>
@section PostScripts{
    

    @Scripts.Render("~/bundle/ModalsJs")
    <script>
        var urlObtenerElementos = "@Url.Action("ObtenerElementos","Elementos")";
        CargarTablaElementos();
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
}
<!-- /área de contenido -->
