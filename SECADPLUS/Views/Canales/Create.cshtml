@model SECADEntities.SECAD.CADCANALE
@{
    ViewBag.Title = "Crea Canales";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/CalendarioJs")
}
<!-- Content area -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat form-compact">
        <div class="panel-heading">
            <h5 class="panel-title">Crea Canales para: @ViewBag.FUERZADESC</h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>
        @using (Html.BeginForm())
            {
            <div class="panel-body">
                <!-- Formulario -->
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger text-size-small" })
                <fieldset class="content-group">
                    <div class="row">
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 obligatorio">

                            @Html.LabelFor(model => model.CODIGO, htmlAttributes: new { @class = "control-label " })
                            <div class="form-group">

                                @Html.EditorFor(model => model.CODIGO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba el código" }, maxlength = "6" })
                                @Html.ValidationMessageFor(model => model.CODIGO, "", new { @class = "text-danger text-size-small" })
                            </div>

                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 obligatorio ">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.DESCRIPCION, htmlAttributes: new { @class = "control-label " })
                                @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la descripción", required = true, maxlength = "60" } })
                                @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 obligatorio">
                            <label class="control-label">Clase de Turno</label>
                            <div class="form-group ">

                                @Html.DropDownList("CLASE_TURNO", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione la clase de turno" })
                                @Html.ValidationMessageFor(model => model.CLASE_TURNO, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            <div class="form-group ">
                                <label class="">Fomulario:</label>
                                
                                @Html.EditorFor(model => model.ABREVIATURA, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la abreviatura", maxlength = "10" } })
                                @Html.ValidationMessageFor(model => model.ABREVIATURA, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 obligatorio">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.TIPO_CANAL, "Tipo de Canal", htmlAttributes: new { @class = "control-label " })
                                @Html.DropDownList("TIPO_CANAL", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione el tipo de Canal" })
                                @Html.ValidationMessageFor(model => model.TIPO_CANAL, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            <div class="form-group">
                                @Html.LabelFor(model => model.OBSERVACION, "Observación", htmlAttributes: new { @class = "control-label " })
                                @Html.EditorFor(model => model.OBSERVACION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba las observaciones", maxlength = "200" } })
                                @Html.ValidationMessageFor(model => model.OBSERVACION, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.TIPO_ATENCION, "Tipo de Caso", htmlAttributes: new { @class = "control-label " })
                                @Html.DropDownList("TIPO_ATENCION", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione el tipo de Atención" })
                                @Html.ValidationMessageFor(model => model.TIPO_ATENCION, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 obligatorio">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.CADFUERZ_ID, htmlAttributes: new { @class = "control-label " })
                                @Html.DropDownList("CADFUERZ_ID", null, string.Empty, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione la Entidad" })
                                @Html.ValidationMessageFor(model => model.CADFUERZ_ID, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>


                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.DESDE, "Fecha Desde", htmlAttributes: new { @class = "control-label " })

                                <div class="input-group">
                                    <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                    @Html.EditorFor(model => model.DESDE, new { htmlAttributes = new { @class = "form-control pickadate-accessibility", @placeholder = "Escoja la Fecha" } })
                                    @Html.ValidationMessageFor(model => model.DESDE, "", new { @class = "text-danger text-size-small" })
                                </div>

                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            <div class="form-group ">
                                @Html.LabelFor(model => model.HASTA, "Fecha Hasta", htmlAttributes: new { @class = "control-label " })

                                <div class="input-group">
                                    <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                    @Html.EditorFor(model => model.HASTA, new { htmlAttributes = new { @class = "form-control pickadate-accessibility", @placeholder = "Escoja la Fecha" } })
                                    @Html.ValidationMessageFor(model => model.HASTA, "", new { @class = "text-danger text-size-small" })
                                </div>

                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2 ">
                            @Html.LabelFor(model => model.VIGENTE, "Vigente", htmlAttributes: new { @class = "control-label " })
                            <div class="form-group">

                                @Html.CheckBox("VIGENTE", htmlAttributes: new { @class = "switch checkbox checkbox-switch", data_size = "mini", data_on_color = "success", data_off_color = "danger", data_on_text = "SÍ", data_off_text = "NO", @checked = "checked" })
                            </div>
                        </div>
                        <div class="col-xs-12 col-sm-2 col-md-2 col-lg-2}">
                            @Html.LabelFor(model => model.DISPONIBLE, "Disponible", htmlAttributes: new { @class = "control-label " })
                            <div class="form-group">

                                @Html.CheckBox("DISPONIBLE", htmlAttributes: new { @class = "switch checkbox checkbox-switch", data_size = "mini", data_on_color = "success", data_off_color = "danger", data_on_text = "SÍ", data_off_text = "NO", @checked = "checked" })
                                @Html.ValidationMessageFor(model => model.DISPONIBLE, "", new { @class = "text-danger text-size-small" })
                            </div>
                        </div>

                    </div>


                </fieldset>

                <!-- /formulario -->
            </div>
            <div class="panel-footer">
                <!-- Botones de regresar y guardar -->
                <div class="row">
                    <div class="col-xs-6 col-md-6text-left">
                        <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                data-original-title="Clic para regresar a la tabla" onclick="location.href=('@Url.Action("Index", "Canales",new { fuerzaId = ViewBag.idFuerza })')">
                            <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                        </button>
                    </div>
                    <div class="col-xs-6 col-md-6 text-right">
                        <button type="submit" value="Create" class="btn bg-teal" data-popup="tooltip"
                                title="" data-placement="bottom" data-original-title="Clic para crear">
                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                        </button>
                    </div>
                </div>
                <!-- /botones de regresar y guardar -->
            </div>
        }
    </div>
    <!-- /panel  -->
</div>
@section PostScripts{
    <script>$(".chosen-select").chosen();</script>
    @Scripts.Render("~/bundle/CheckSwitchJs");
}