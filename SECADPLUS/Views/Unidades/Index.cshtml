        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////



        var controlUnidades = true;
        urlCreacion = '@Url.Action("Create", "Unidades")';
        urlEditar = '@Url.Action("Edit","Unidades")'
        var urlEliminar = '@Url.Action("Eliminar", "Unidades")'
        urlFuerzas = "@(Url.Action("GetFuerza", "Unidades"))";
        urlAction1 = "@(Url.Action("GetNivelUno", "Unidades"))";
        urlNivelUnoActivos = "@(Url.Action("GetNivelUnoActivos", "Unidades"))";
        urlUnidades = "@(Url.Action("ObtenerNiveles", "Unidades"))";
        urlUnidadesActivos = "@(Url.Action("ObtenerNivelActivos", "Unidades"))";
        urlAction3 = "@(Url.Action("insNivelX", "Unidades"))";
        urlAction4 = "@(Url.Action("GetSiath", "Unidades"))";
        urlAction5 = "@(Url.Action("GetLugar", "Unidades"))";
        urlAction6 = "@(Url.Action("delNivelX", "Unidades"))";
        urlAction7 = "@(Url.Action("updNivelX", "Unidades"))";
        urlVerPatrullas = "@Url.Action("Index", "Patrullas")";
        var urlVerCuadrantes = "@Url.Action("VerCuadrantes", "Unidades")";
    </script>
    @Scripts.Render("~/bundle/NivelesJs");
    @if (string.IsNullOrEmpty(ViewBag.UNIDADES))
    {
        <script>
        
            ActivarModoConsulta();
        </script>        
    }
}