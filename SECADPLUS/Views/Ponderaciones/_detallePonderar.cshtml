@model IEnumerable<SECADEntities.SECAD.CADCONDCLBIPONDERADO>

@foreach (var item in Model)
{
    <tr>
        <td></td>
        <td>
            <ul class="icons-list">
                <li class="dropdown">
                    <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat
                                                                dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <i class="icon-menu9"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-left">
                        <li>
                            <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para editar"
                                    onclick="window.location.href ='@Url.Action("EditDP", new { id = item.CONSECUTIVO, idTipo = @ViewBag.idTipo, nomTipo = @ViewBag.nomTipo, idTitu = @ViewBag.idTitu, nomTitu = @ViewBag.nomTitu, idCond = @ViewBag.idCond, nomCond = @ViewBag.nomCond, idPond = @ViewBag.idPond })'">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </button>
                        </li>
                        <li>
                            <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para eliminar"
                                    onclick="EliminarRegistroGeneral('@Url.Action("EliminarDP", "Ponderaciones", new { id = item.CONSECUTIVO, idTipo = @ViewBag.idTipo, nomTipo = @ViewBag.nomTipo, idTitu = @ViewBag.idTitu, nomTitu = @ViewBag.nomTitu, idCond = @ViewBag.idCond, nomCond = @ViewBag.nomCond, idPond = @ViewBag.idPond })')">  @*onclick="window.location.href ='@Url.Action("DeleteDP", new { id = item.CONSECUTIVO, idTipo = @ViewBag.idTipo, nomTipo = @ViewBag.nomTipo, idTitu = @ViewBag.idTitu, nomTitu = @ViewBag.nomTitu, idCond = @ViewBag.idCond, nomCond = @ViewBag.nomCond, idPond = @ViewBag.idPond })'">*@
                                <i class="icon-trash"></i> Eliminar
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </td>
        <td>@Html.DisplayFor(modelItem => item.CLASE_PONDERADO)</td>
        <td>@Html.DisplayFor(modelItem => item.MODOCONDUCTA)</td>
        <td>@Html.DisplayFor(modelItem => item.VLR_MINIMO)</td>
        <td>@Html.DisplayFor(modelItem => item.VLR_MAXIMO)</td>
        <td>@Html.DisplayFor(modelItem => item.VLR_UNIDAD)</td>
        <td>@Html.DisplayFor(modelItem => item.VLR_PONDERADO)</td>
    </tr>
}
