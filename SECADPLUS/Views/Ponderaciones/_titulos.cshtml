@model IEnumerable<SECADEntities.SECAD.CADCONDUCTA>

@foreach (var item in Model)
{
    <tr>
        <td></td>
        <td>
            <ul class="icons-list">
                <li class="dropdown">
                    <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat
                                                                dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <i class="icon-menu9"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-left">
                        <li>
                            <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para ver conductas"
                                    onclick="VerConductas(@item.CODIGO, '@item.DESCRIPCION')">
                                <i class="icon-eye"></i> Ver conductas
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </td>
        <td>@Html.DisplayFor(modelItem => item.CODIGO)</td>
        <td>@Html.DisplayFor(modelItem => item.DESCRIPCION)</td>
    </tr>
}
