@model SECADEntities.SECAD.CADCONDCLASESBIEN

@{
    ViewBag.Title = "Crear Ponderar";
}

<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Crear Ponderar:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                @using (Html.BeginForm("CreateP", "Ponderaciones", FormMethod.Post, new { @class = "form-compact" }))
                {

                    <div class="panel-body">
                        <fieldset class="content-group">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.Hidden("CONSECUTIVO")
                            @Html.Hidden("TIPO_CONDUCTA")
                            @Html.Hidden("COND_CODIGO")
                            @Html.Hidden("idTipo")
                            @Html.Hidden("nomTipo")
                            @Html.Hidden("idTitu")
                            @Html.Hidden("nomTitu")
                            @Html.Hidden("idCond")
                            @Html.Hidden("nomCond")
                            <div class="row">
                                <div class="col-md-12 col-lg-12">
                                    <div class="form-group obligatorio">
                                        <label>Conducta:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.Editor("NOM_CONDUCTA", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-6">
                                    <div class="form-group">
                                        <label>Tipo de Bien:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.DropDownList("CLBI_TIBI_CODIGO", null, htmlAttributes: new { @class = "chosen-select" })
                                                @Html.ValidationMessageFor(model => model.CLBI_TIBI_CODIGO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-6">
                                    <div class="form-group">
                                        <label>Clase de Bien:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.DropDownList("CLBI_CODIGO", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                                @Html.ValidationMessageFor(model => model.CLBI_CODIGO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla"
                                        onclick="window.location.href ='@Url.Action("Index", new { idTipo = @ViewBag.idTipo, nomTipo = @ViewBag.nomTipo, idTitu = @ViewBag.idTitu, nomTitu = @ViewBag.nomTitu, idCond = @ViewBag.idCond, nomCond = @ViewBag.nomCond })'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                        value="CreateP">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <!-- /formulario -->
            </div>
        </div>
    </div>
</div>

<script>
    var urlClases = '@Url.Action("GetClasesBien", "Ponderaciones")';
</script>


<!-- /área de contenido -->
@Scripts.Render("~/bundle/FormularioJs")
@Scripts.Render("~/bundle/InputsJs")
@Scripts.Render("~/bundle/ChosenJs")
@Scripts.Render("~/bundle/PonderacionesJs")


