
@{
    ViewBag.Title = "Directorio";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}




<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")

    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Consulta Directorio Telefónico:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                              
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>            

                    <div class="panel-body">
                        @Html.AntiForgeryToken()
                        <fieldset class="content-group ">
                            <div class="row">
                       
                                @Html.Hidden("CODIGOCANAL")
                                @Html.Hidden("CODIGOFUERZA")
                                @Html.Hidden("BARR_LUGE_CODIGO")
                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Telefono", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-12">                                         
                                          <input id="telefono" type="text" class="form-control" />                                      
                                          </div>
                                    </div>
                                </div>

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group"> 
                                        @Html.Label("Propietario", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-12">
                                            <input id="propietario" type="text" class="form-control" />
                                        </div>
                                                                              
                                    </div>
                                </div>

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Nit/Cedula", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-12">
                                            <input id="nit" type="text" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Dirección", htmlAttributes: new { @class = "control-label col-md-2" })
                                        <div class="col-md-12">
                                            <input id="direccion" type="text" class="form-control" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                         

                            <div class="row">

                                <div class="form-group col-md-3 col-lg-6">
                                    <div class="form-group">
                                        @Html.Label("Barrio Segun EmpTelefonos", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9" })
                                        <div class="col-md-12">
                                            <input id="barrio" type="text" class="form-control" />
                                        </div>
                                    </div>
                                </div>    
                                <div class="col-md-6">
                                    <div class="">

                                        
                                        <br />
                                        

                                            <label class="radio-inline">
                                                <input type="radio" name="nivel" class="styled"  value="10">
                                                Nivel País
                                            </label>
                                            <label class="radio-inline">
                                                <input type="radio" name="nivel" class="styled" value="0" >
                                                Nivel Departamento
                                            </label>
                                    </div>
                                </div>                    
                            </div>
                            <div class="row">

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Codigo Municipio", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9" })
                                        <div class="col-md-12">
                                            <input id="codigoMunicipio" type="text" class="form-control" />
                                        </div>
                                    </div>
                                </div>                     
                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Municipio", htmlAttributes: new { @class = "control-label col-md-2", @readonly = "readonly" })
                                        <div class="col-md-12">
                                            <input id="municipio" type="text" class="form-control readonly" disabled="disabled" />
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group col-md-2 col-lg-2">
                                    <div class="form-group">
                                        @Html.Label(" ", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9"})
                                        <br />
                                        <div class="col-md-6 col-lg-9">
                                            <button type="button" onclick="CargaCiudades();" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                    title="" data-placement="bottom" data-original-title="Clic para buscar">
                                                <b><i class="icon-select2 position-left"></i></b>Buscar Municipio
                                            </button>
                                        </div>

                                    </div>
                                </div>   
                            </div>
                      

                          
                            <div class="row">

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Codigo Barrio Atención", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9" })
                                        <div class="col-md-12">
                                            <input id="codigoBarrAntencion" type="text" class="form-control" />
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("Barrio Atención", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9" })
                                        <div class="col-md-12">
                                            <input id="barrAtencion" type="text" class="form-control" />
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group col-md-3 col-lg-3">
                                    <div class="form-group">
                                        @Html.Label("", htmlAttributes: new { @class = "control-label col-md-6 col-lg-9", @readonly = "readonly" })
                                        <br />
                                        <div class="col-md-12">
                                            <button type="button" onclick="MostrarBarrios();" class="btn btn-mixed btn-success" data-popup="tooltip"
                                                    title="" data-placement="bottom" data-original-title="Clic para buscar">
                                                <b><i class="icon-select2 position-left"></i></b>Buscar Barrio
                                            </button>
                                        </div>

                                    </div>
                                </div>

                            </div>
                            <div class="row">

                            </div>

                        </fieldset>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="form-group col-xs-6 col-md-6 text-right">
                             <button id="btnConsultar" type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para consultar directorio">
                                <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Consultar
                            </button>
                            </div>
                        </div>
                    </div>

                



                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaDirectorio">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Numero Telefono</th>
                            <th>Propietario</th>
                            <th>Nit/Cedula</th>
                            <th>Dirección  </th>
                            <th>Barrio Segun Emp. Telefonos</th>
                            <th>Codigo Municipio</th>
                            <th>Municipio</th>
                            <th>Codigo Barrio Atención</th>
                            <th>Barrio Atención</th>


                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- Área de contenido -->


<!-- Modal Ciudades -->
<div id="ModalCiudades" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Ciudades</h5>
            </div>
            <div class="modal-body form-compact">
                <table id="tablaCiudades" class="table table-hover table-xxs datatable-basic modal_table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Ciudades -->

<!-- Modal Barrios -->
<div id="ModalBarrios" class="modal fade">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title">Barrios</h5>
            </div>
            <div class="modal-body form-compact">
                <table class="table table-hover table-xxs datatable-basic" id="_tblBarrios">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Codigo</th>
                            <th>Descripción</th>                
                        </tr>
                    </thead>
                </table>
            </div>
            <div class="modal-footer">
                <div class="row">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Barrios -->





<script type="text/javascript">

    var urlTabla = '@Url.Action("ObtenerDirectorio", "Directorio")';
    var urlActionCargaCiudades = "@(Url.Action("CargaCiudades", "Directorio"))";
    var urlsCargaBarrios = "@(Url.Action("CargarTodosLosBarrios", "Directorio"))";
    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////
</script>
@Scripts.Render("~/bundle/CheckBoxJs")
@Scripts.Render("~/bundle/DirectorioJs")

