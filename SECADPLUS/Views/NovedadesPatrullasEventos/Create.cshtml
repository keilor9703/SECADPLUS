@model  SECADEntities.SecadEntities.CADNOVEDADESPATRULLA
@{
    ViewBag.Title = "Crear Novedad";
}



@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
}






<!-- Content area -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h5 class="panel-title">Crear novedad presentada : </h5>
            <div class="heading-elements">
                <ul class="icons-list">
                    <li><a data-action="collapse"></a></li>
                </ul>
            </div>
        </div>

        @using (Html.BeginForm("Create", "NovedadesPatrullasEventos", FormMethod.Post, new { @class = "form-compact", enctype = "multipart/form-data" }))
        {

            <div class="panel-body">
                <!-- Formulario -->
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.CADMEDISP_CONSECUTIVO)


                <fieldset class="content-group">
                    <div class="row">


                        <div class="col-md-12">
                            <div class="col-md-12">
                               
                                <div class="col-xs-12 col-sm-2 col-md-2 col-lg-3 ">
                                    <label for="txt_Medios">Medios</label>
                                    <div class="input-group">
                                        <div class="col-md-8">
                                            <input type="text" id="txt_desPatrulla" name="txt_desPatrulla" class="form-control" readonly="readonly" />
                                            @Html.ValidationMessageFor(model => model.CADMEDISP_CONSECUTIVO, "", new { @class = "text-danger" })


                                        </div>
                                        <div class="col-md-4">
                                            <span class="input-group-btn">
                                                <button type="button" id="_btnMedios" class="btn btn-success btn-mixed" data-popup="tooltip"
                                                        title="" data-placement="bottom" data-original-title="Clic para buscar" onclick="AbrirModalMedios()">
                                                    <b><i class="icon-select2 position-left"></i></b>Seleccionar
                                                </button>
                                            </span>
                                        </div>
                                    </div>
                                </div>


                                <div class="col-xs-12 col-sm-2 col-md-2 col-lg-3 ">
                                    <div class="form-group">
                                        @Html.Label("Tipos Novedad" ,htmlAttributes: new { @class = "control-label" })                                      
                                             
                                           @Html.DropDownList("TIPO_NOVEDAD", null,"", htmlAttributes: new { @class = "chosen-select form-control", @id = "TIPO_NOVEDAD", @name = "TIPO_NOVEDAD" })
                                            @Html.ValidationMessageFor(model => model.TIPO_NOVEDAD, "", new { @class = "text-danger" })
                                       
                                    </div>
                                </div>



                                <div class="col-xs-12 col-sm-2 col-md-2 col-lg-3 ">
                                    <div class="form-group">
                                        @Html.Label("Hora Inicial", htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            <span class="input-group-addon"><i class="icon-calendar"></i></span>
                                            @Html.EditorFor(model => model.HORA_INICIA, new { htmlAttributes = new { @class = "form-control FechaHora", id = "fecha_inicia" } })
                                        </div>

                                        @Html.ValidationMessageFor(model => model.HORA_INICIA, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-2 col-md-2 col-lg-3 ">

                                    <div class="form-group">
                                        @Html.Label("Hora Termina", htmlAttributes: new { @class = "control-label" })
                                        <div class="input-group">
                                            <span class="input-group-addon"><i class="icon-calendar"></i></span>
                                            @Html.EditorFor(model => model.HORA_TERMINA, new { htmlAttributes = new { @class = "form-control FechaHora", id = "fecha_termina" } })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.HORA_TERMINA, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="col-xs-12 col-sm-2 col-md-2 col-lg-3 ">

                                    <div class="form-group">
                                        @Html.Label("Obeservaciones", htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.OBSERVACION, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.OBSERVACION, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                            </div>
                        </div>                   
                    </div>

              


                </fieldset>
            </div>

            <div class="panel-footer">
                <!-- Botones de regresar y guardar -->
                <div class="row">
                    <div class="col-xs-6 col-md-6text-left">
                        <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                data-original-title="Clic para regresar a la tabla" onclick="location.href=('@Url.Action("Index", "NovedadesPatrullasEventos")');">
                            <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                        </button>
                    </div>
                    <div class="col-xs-6 col-md-6 text-right">
                        <button type="submit" value="Crear" class="btn bg-teal" data-popup="tooltip"
                                title="" data-placement="bottom" data-original-title="Clic para crear">
                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                        </button>
                    </div>
                </div>
                <!-- /botones de regresar y guardar -->
            </div>

        }

    </div>



    <!-- Modal Medios -->





    <div id="ModalMedios" class="modal fade">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h5 class="modal-title">Medios</h5>
                </div>
                <div class="modal-body form-compact table-responsive">
                   
                        <table id="_tblMedios" class="table table-hover table-xxs datatable-basic table-responsive">
                            <thead class="table-responsive">
                                <tr >
                                    <th></th>
                                    <th>Acciones</th>
                                    <th>Descripción Patrulla </th>
                                    <th>Sitio Graba</th>
                                    <th>Consecutivo</th>
                                    <th>Estado Patrulla</th>
                                    <th>Tipo</th>
                                    <th>Estado</th>
                                    <th>Cuenta</th>
                                </tr>
                            </thead>
                        </table>
                  



                </div>
                
                
                 <div class="modal-footer">
                    <div class="row">
                        <div class="col-md-12">
                            <button type="button" class="btn btn-warning" data-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Medios -->
</div>






    @Scripts.Render("~/bundle/AccionesNovedadPatrullasJs")


<script>

    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////

        var urlMedios = "@Url.Action("ObtenerMedios", "NovedadesPatrullasEventos")";
        var urlObtenerSiguienteFecha = "@Url.Action("ObtenerSiguienteFecha", "NovedadesPatrullasEventos")";
        InicializarElementos("CREAR");
</script>




