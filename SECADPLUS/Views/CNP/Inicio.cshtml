                                                            <input type="checkbox" id="checkCNP" class="" disabled>
                                                        </label>
                                                        <div class="col-md-10">
                                                            @Html.HiddenFor(model => model.VALIDADO_CNP, new { @class = "form-control", id = "hdValidadoCNP" })
                                                            <input type="text" id="txtValidadoCNP" class="form-control readonly-recepcion-grey " tabindex="-1"
                                                                   placeholder="Validado CNSCC" aria-required="true">
                                                            @Html.ValidationMessageFor(model => model.VALIDADO_CNP, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>


                                                    <legend class="text-semibold">
                                                        Datos de la conducta

                                                    </legend>
                                                </div>

                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="form-group">
                                                            <label class="Labels">Artículo del Comportamiento:</label>
