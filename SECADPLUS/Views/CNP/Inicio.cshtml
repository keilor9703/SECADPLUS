                                                            @Html.DropDownList("ArticuloId", null, String.Format("Seleccione un Artículo"), htmlAttributes: new { @class = "form-control chosen-select althei", style = "width: 80%;", id = "ArticuloId", @Required = true, @placeholder = "Seleccione una opción" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label class="Labels">Numeral:</label>
                                                            @Html.DropDownList("NumeralId", new List<SelectListItem> { new SelectListItem { Value = "" } }, String.Format("Seleccione una opción"), htmlAttributes: new { @class = "form-control chosen-select althei", style = "width: 100%;", @id = "NumeralId", @Required = true, @placeholder = "Seleccione una opción" })
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label class="Labels">Literal:</label>
                                                            @Html.DropDownList("LiteralId", new List<SelectListItem> { new SelectListItem { Value = "" } }, String.Format("Seleccione una opción"), htmlAttributes: new { @class = "form-control chosen-select althei", style = "width: 100%;", @id = "LiteralId", @Required = true, @placeholder = "Seleccione una opción" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <br />

                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        <div class="col-md-12 ">
                                                            <label class="control-label">Tipo documento:</label>
                                                            <select id="slTipoDoc" class="form-control chosen-select">
                                                                <option value="">Seleccione</option>
                                                                <option value="CC">CEDULA</option>
                                                                <option value="PA">PASAPORTE</option>
                                                                <option value="CE">CEDULA EXTRANJERIA</option>
                                                                <option value="TI">TARJETA IDENTIDAD</option>
                                                                <option value="NI">NUI</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.IDPERSONA, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            @Html.EditorFor(model => model.IDPERSONA, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "Documento" } })
                                                            @Html.ValidationMessageFor(model => model.IDPERSONA, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-2 col-md-2 col-lg-2 text-left form-group">
                                                        <div class="col-md-12 ">
                                                            <br />
                                                            <button type="button" class="btn bg-teal btn-xs" id="btnRegistraduria"> Traer Dato Registraduría</button>
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.PERSONA_REGISTRADURIA, htmlAttributes: new { @class = "control-label col-md-2" })
                                                        <div class="col-md-12 ">
                                                            <input type="text" id="PERSONA_REGISTRADURIA" name="PERSONA_REGISTRADURIA" class="form-control readonly-recepcion-grey " readonly tabindex="-1"
                                                                   placeholder="Nombre Persona" aria-required="true">
                                                            <span class="label bg-primary-300 table-xs" id="mensajePersona"></span>
                                                            @Html.ValidationMessageFor(model => model.PERSONA_REGISTRADURIA, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">


                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                                        @Html.LabelFor(model => model.NOMBRE_PERSONA, htmlAttributes: new { @class = "control-label col-md-2" })
                                                        <div class="col-md-12 ">
                                                            @Html.EditorFor(model => model.NOMBRE_PERSONA, new { htmlAttributes = new { @class = "form-control", placeholder = "Nombres" } })

                                                            @Html.ValidationMessageFor(model => model.NOMBRE_PERSONA, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.APELLIDOS_PERSONA, htmlAttributes: new { @class = "control-label col-md-2" })
                                                        <div class="col-md-12 ">
                                                            @Html.EditorFor(model => model.APELLIDOS_PERSONA, new { htmlAttributes = new { @class = "form-control", placeholder = "Apellidos" } })
                                                            @Html.ValidationMessageFor(model => model.APELLIDOS_PERSONA, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        <div class="col-md-12 ">
                                                            <label class="control-label">Nro Comparendos:</label>
                                                            <input type="text" id="txtCantidadComp" class="form-control readonly-recepcion-grey " readonly tabindex="-1"
                                                                   placeholder="0" aria-required="true">
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        <div class="col-md-12 ">
                                                            <br />
                                                            <button type="button" class="btn bg-teal btn-xs" id="btnConsultarComparendos"> Ver Comparendos Anteriores</button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.USUA_GRABA, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">

                                                            <input type="text" id="USUA_GRABA" name="USUA_GRABA" class="form-control readonly-recepcion-grey " readonly tabindex="-1"
                                                                   placeholder="0" aria-required="true" value="@ViewBag.USUARIO">
                                                            @Html.ValidationMessageFor(model => model.USUA_GRABA, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.FECHA_GRABACION, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            <input type="text" id="FECHA_GRABACION" name="FECHA_GRABACION" class="form-control readonly-recepcion-grey " readonly tabindex="-1"
                                                                   placeholder="DD/MM/AAAA" aria-required="true">
                                                            @Html.ValidationMessageFor(model => model.FECHA_GRABACION, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.MAQUINA_GRABACION, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            <input type="text" id="MAQUINA_GRABACION" name="MAQUINA_GRABACION" class="form-control readonly-recepcion-grey " readonly tabindex="-1"
                                                                   placeholder="0" aria-required="true" value="@ViewBag.MAQUINA">
                                                            @Html.ValidationMessageFor(model => model.MAQUINA_GRABACION, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-10 form-group">
                                                        <button type="button" class="btn bg-teal btn-sm" data-popup="tooltip" data-placement="bottom"
                                                                title="" data-original-title="Clic para agregar preguntas"
                                                                id="btnGuardar">
                                                            <b><i class="esri-icon-plus position-lef"></i></b> Crear
                                                        </button>
                                                        <button type="button" class="btn btn-warning btn-sm" data-popup="tooltip" data-placement="bottom"
                                                                title="" data-original-title="Clic para agregar preguntas"
                                                                id="btnLimpiar">
                                                            <b><i class="esri-icon-erase position-lef"></i></b> Limpiar
                                                        </button>

                                                    </div>
                                                </div>
                                            </fieldset>
                                        }
                                        <div class="row">
                                            <fieldset>
                                                <div class="col-md-12">
                                                    <table class="table table-hover table-xxs datatable-basic form-compact" id="tblComparendos">
                                                        <thead>
                                                            <tr>
                                                                <th></th>
                                                                <th>Acciones</th>
                                                                <th>Cedula</th>
                                                                <th>Policía</th>
                                                                <th>CNSCC No. Comparendo</th>
                                                                <th>Fecha Grabación</th>
                                                                <th>Validado CNSCC</th>
                                                                <th>Nro Evento</th>
                                                            </tr>
                                                        </thead>
                                                    </table>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>

                                </div>
                                <!----------------------------------FIN CONTENIDO TAB------------------------------------->
                            </div>
                            <div class="tab-pane col-lg-12 col-md-12" id="anteriores">
                                <!--------------------------------------CONTENIDO TAB------------------------------------->
                                <div class="row">
                                    <fieldset>
                                        <div class="col-md-12">
                                            <table class="table table-hover table-xxs datatable-basic form-compact" id="tblAsociados">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>CNSCC No. Comparendo</th>
                                                        <th>Id</th>
                                                        <th>Comportamiento</th>
                                                        <th>Fecha Grabación</th>
                                                        <th>Apellidos Persona</th>
                                                        <th>Nombres Persona</th>

                                                    </tr>
                                                </thead>
                                            </table>
                                        </div>


                                    </fieldset>
                                </div>
                                <!----------------------------------FIN CONTENIDO TAB------------------------------------->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Comportamientos -->
