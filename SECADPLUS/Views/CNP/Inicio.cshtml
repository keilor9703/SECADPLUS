</div>
<!-- Modal Comportamientos -->
@section PostScripts{

    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/CheckBoxJs")
    @Scripts.Render("~/bundle/ModalsAlertJs")
    @Scripts.Render("~/bundle/CNPJs")
    <script>
        /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        //////////////////VARIABLES NECESARIAS PARA EL FUNCIONAMIENTO DEl CNP////////////////////////////////////////////////////////////////////////
        /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
        var urlConsultarPersona = "@Url.Action("ConsultarPersona", "CNP")";
        var urlValidarComparendo = "@Url.Action("ValidarComparendo", "CNP")";
        var urlCommportamientos = "@Url.Action("ConsultarComportamientos", "CNP")";
        var urlConsultarRegistraduria = "@Url.Action("ConsultarRegistraduria", "CNP")";
        var urlConsultarCantComparendos = "@Url.Action("ConsultarCantComparendos", "CNP")";
        var urlConsultarComparendos = "@Url.Action("ConsultarComparendos", "CNP")";
        var urlConsultarAsociados = "@Url.Action("ConsultarAsociados", "CNP")";
        var dcNumEvento = @ViewBag.Evento;
        var urlGetNumeral = "@Url.Action("TraerNumerales", "CNP")";
        var urlGetLiteral = "@Url.Action("TraerLiterales", "CNP", new { Area = "" })";

        window.addEventListener('load', ChosenArticulo, false);
        window.addEventListener('load', ChosenNumeral, false);
        window.addEventListener('load', ChosenLiteral, false);

        function ChosenArticulo() {
            AplicarChosen();
        }

        function AplicarChosen() {
            $(".chosen-select").chosen({ allow_single_deselect: false, width: "100%" });
            $("#ArticuloId").click(
                function (e) {
                    e.preventDefault();
                    return;
                }
            );
        }

    function ChosenNumeral() {
        AplicarChosenNume();
    }

    function AplicarChosenNume() {
        $(".chosen-select").chosen({ allow_single_deselect: false, width: "100%" });
        $("#NumeralId").click(
            function (e) {
                e.preventDefault();
                return;
            }
        );
    }

    function ChosenLiteral() {
        AplicarChosenLite();
    }

    function AplicarChosenLite() {
        $(".chosen-select").chosen({ allow_single_deselect: false, width: "100%" });
        $("#LiteralId").click(
            function (e) {
                e.preventDefault();
                return;
            }
        );
    }
        //Consultar los Artículos seleccionados
        $("#ArticuloId").change(function () {
            //var valor = document.getElementById("ArticuloId").value;

            //Limpiar la dependencia
            $("#NumeralId").empty();

            $.ajax({
                type: 'POST',
                url: urlGetNumeral,
                dataType: 'json',
                data: { V_Articulo: $("#ArticuloId").val() },

                success: function (numerales) {
                    $.each(numerales, function (i, numeral) {
                        $("#NumeralId").append('<option value="' + numeral.Value + '">' + numeral.Text + '</option>');
                    });
                    $("#NumeralId").trigger("chosen:updated");
                },
                error: function (ex) {
                    alert('Seleccione un numeral de la lista !!!');

                }
            })
        })

        //Consultar los Numerales seleccionados
        $("#NumeralId").change(function () {
            //var valor = document.getElementById("ArticuloId").value;

            //Limpiar los Literales
            $("#LiteralId").empty();

            $.ajax({
                type: 'POST',
                url: urlGetLiteral,
                dataType: 'json',
                data: { V_Numeral: $("#NumeralId").val() },

                success: function (literales) {
                    $.each(literales, function (i, literal) {
                        $("#LiteralId").append('<option value="' + literal.Value + '">' + literal.Text + '</option>');
                    });
                    $("#LiteralId").trigger("chosen:updated");
                },
                error: function (ex) {
                    alert('Seleccione un numeral de la lista !!!');

                }
            })
        })

    </script>
}
