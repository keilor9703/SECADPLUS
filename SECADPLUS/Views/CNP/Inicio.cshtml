@model SECADEntities.SecadEntities.CADEVENTOS_CNP_COMP

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")

}

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div id="exTab3">
                        <ul class="nav nav-tabs nav-tabs-highlight">
                            <li class="active" id="tabCNP"><a href="#cnp" data-toggle="tab">CNSCC</a></li>
                            <li><a href="#anteriores" data-toggle="tab" id="tabcomparendos"> Comparendos Anteriores</a></li>
                        </ul>
                        <div class="tab-content">
                            <div class="tab-pane active col-lg-12 col-md-12 row" id="cnp">
                                <!--------------------------------------CONTENIDO TAB------------------------------------->
                                <div class="panel panel-flat">
                                    <div class="panel-body">
                                        <!-- /contenido panel -->
                                        @using (Html.BeginForm("Crear", "CNP", FormMethod.Post, new { @class = "form-compact", id = "formCNP" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                            @Html.HiddenFor(model => model.CADEVEN_SITIOGRABA, new { @class = "form-control", Value = ViewBag.Sitio })
                                            @Html.HiddenFor(model => model.TIPO_IDPERSONA, new { @class = "form-control", id = "hdTipoPersona" })
                                            <fieldset class="content-group">
                                                <div class="row">
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                                        @Html.LabelFor(model => model.CADEVEN_NUMEEVENTO, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            <input type="text" readonly class="form-control" value="@ViewBag.Evento" />
                                                            @Html.HiddenFor(model => model.CADEVEN_NUMEEVENTO, new { @class = "form-control", Value = ViewBag.Evento })
                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        <div class="col-md-12 ">
                                                            <br />
                                                            <button type="button" class="btn bg-teal btn-xs" id="btnValidarComparendo"> Validar Comparendo</button>
                                                        </div>
                                                    </div>

                                                </div>
                                                <div class="row">
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
                                                        @Html.LabelFor(model => model.CADPOLI_CEDULA, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            @Html.EditorFor(model => model.CADPOLI_CEDULA, new { htmlAttributes = new { @class = "form-control", id = "txtCedula", type = "number", placeholder = "Cédula" } })
