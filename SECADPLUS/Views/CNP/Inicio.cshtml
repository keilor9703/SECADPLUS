                                                        </div>
                                                    </div>
                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                                        @Html.LabelFor(model => model.CNP_ORDEN_COMPARENDO, htmlAttributes: new { @class = "control-label col-md-12" })
                                                        <div class="col-md-12 ">
                                                            @Html.EditorFor(model => model.CNP_ORDEN_COMPARENDO, new { htmlAttributes = new { @class = "form-control", id = "txtComparendo", placeholder = "Número Comparendo" } })
                                                            @Html.ValidationMessageFor(model => model.CNP_ORDEN_COMPARENDO, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                                        @Html.LabelFor(model => model.VALIDADO_CNP, htmlAttributes: new { @class = "control-label col-md-12" })
