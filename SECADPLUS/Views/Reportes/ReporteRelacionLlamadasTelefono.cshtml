@{
    ViewBag.Title = "Reporte Relación Llamadas Teléfono";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Parámetros</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                @using (Html.BeginForm("GeneraReporteRelacionLlamadasTelefono", "Reportes", FormMethod.Post, new { @class = "form-compact", target = "_blank" }))
                {
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="form-group col-lg-12 ">
                                    <label for="Sitio">Sitio Grabación</label>
                                    <div class="input-group">
                                        @Html.DropDownList("Sitio", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="form-group col-lg-12 obligatorio">
                                    <label for="FechaInicial"> Fecha Inicial</label>
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                        @Html.Editor("FechaInicio", new { htmlAttributes = new { @class = "form-control FechaHora", @placeholder = "Escoja Fecha" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="FechaFinal"> Fecha Final</label>
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="icon-calendar22"></i></span>
                                        @Html.Editor("FechaFinal", new { htmlAttributes = new { @class = "form-control FechaHoraF", @placeholder = "Escoja Fecha" } })
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Abreviatura"> Grupo de Llamadas</label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("Abreviatura", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="form-group col-lg-12 ">
                                    <label for="CantidadLimite">Cantidad Límite >= que</label>
                                    <div class="input-group">
                                        @Html.Editor("CantidadLimite", new { htmlAttributes = new { @class = "form-control", @Value = 2, type = "number" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Firma">Firma</label>
                                    <div class="input-group col-md-12">
                                        @Html.Editor("Firma", new { htmlAttributes = new { @class = "form-control", @placeholder = "Indique el Responsable" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="CargoFirma">Cargo Firma</label>
                                    <div class="input-group col-md-12">
                                        @Html.Editor("CargoFirma", new { htmlAttributes = new { @class = "form-control", @placeholder = "Indique el Cargo" } })
                                    </div>
                                </div>
                            </div>
                        </div>                        
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip" id="btnGenerar" type="submit"
                                        title="" data-placement="bottom" data-original-title="Clic para generar el reporte">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Generar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
@section PostScripts{
   <script>
        $(".chosen-select").chosen();
        AplicarDateTimePlugin();
        urlCargarDataPlanos = '@Url.Action("CargaDatosPlanos", "Reportes")';
       /////////////////////Variables BreadCrumb/////////////////////////
       UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
       UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
       //////////////////////////////////////////////////////////////////
        function AplicarDateTimePlugin() {
            miFechaIni = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate(), 0, 0, 0, 0);
            miFechaFin = new Date(new Date().getFullYear(), new Date().getMonth(), new Date().getDate(), 23, 59, 59, 0);
            $(".FechaHora").datetimepicker({
                format: 'DD/MM/YYYY HH:mm:ss',
                defaultDate: miFechaIni,
                showClear: true
            });
            $(".FechaHoraF").datetimepicker({
                format: 'DD/MM/YYYY HH:mm:ss',
                defaultDate: miFechaFin,
                showClear: true
            });
        }
</script>
}
