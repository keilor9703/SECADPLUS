

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")

}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Parámetros de consulta</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">

                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                @using (Html.BeginForm("GeneraReporteRevistas", "Reportes", FormMethod.Post, new { @class = "form-compact" }))
                {

                    <div class="panel-body">

                        <div class="row">
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_sitio">Sitio Grabación </label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("SITIOS_GRABA", null, htmlAttributes: new { @class = "chosen-select", @id = "sitioGraba", @name = "sitioGraba" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_sitio">Entidad </label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("ENTIDADES", null, htmlAttributes: new { @class = "chosen-select", @id = "entidad", @name = "entidad" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_Ip">Consecutivo (0 - todos) </label>
                                    <div class="input-group col-md-12">
                                        <input type="text" class="form-control" name="CONSECUTIVO" value="@ViewBag.CONSECUTIVO"/>
                                    </div>
                                </div>
                            </div>                     

                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_firma">Firmado por </label>
                                    <div class="col-md-12">
                                        @Html.DropDownList("FIRMA", null,"CR. NOMBRE APELLIDO", htmlAttributes: new { @class = "chosen-select", @id = "firma", @name = "firma" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_cargoFirma"> Cargo Firmante</label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("CARGO_FIRMA", null, htmlAttributes: new { @class = "chosen-select", @id = "firma", @name = "firma" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group">
                                <div class="form-group col-lg-12">
                                    <label for="txt_elaboro">Elaborado por</label>
                                    <div class="input-group col-md-12">
                                        <input type="text" id="txt_elaboro" name="txt_elaboro" class="form-control" />
                                    </div>
                                </div>
                            </div>


                        </div>

                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip" id="btnGenerar" type="submit"
                                        title="" data-placement="bottom" data-original-title="Clic para generar el reporte">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Generar
                                </button>
                            </div>
                        </div>
                    </div>


                }

            </div>



        </div>
    </div>
</div>
@Scripts.Render("~/bundle/InputsJs")
@Scripts.Render("~/bundle/ChosenJs")

@section PostScripts{

<script>
    $(".chosen-select").chosen();
    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////
</script>
}


