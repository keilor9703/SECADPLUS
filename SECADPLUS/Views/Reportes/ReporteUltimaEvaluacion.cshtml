
@{
    ViewBag.Title = "Resumén de Evaluación del Servicio por Unidad y Personas";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Debe correrse inicialmente el formato de evaluación</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                @using (Html.BeginForm("GeneraReporteUltimaEvaluacion", "Reportes", FormMethod.Post, new { @class = "form-compact", target = "_blank" }))
                {
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group ">
                                <div class="form-group col-lg-12 obligatorio">
                                    <label for="Nota">Nota: ponderaciones en (0), significa que no se ha realizado la parametrización de ese bien 0 de esa conducta. </label>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip" id="btnGenerar" type="submit"
                                        title="" data-placement="bottom" data-original-title="Clic para generar el reporte">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Generar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
@section PostScripts{
    <script>
        $(".chosen-select").chosen();
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
        $(function () {
            AplicarDateTimePlugin();
        });

        function AplicarDateTimePlugin() {
            $(".FechaHora").datetimepicker({
                format: 'DD/MM/YYYY HH:mm:ss',
                defaultDate: new Date(),
                showClear: true
            });
        }
    </script>
}




