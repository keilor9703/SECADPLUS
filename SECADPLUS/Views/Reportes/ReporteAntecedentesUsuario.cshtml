
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")

    @Scripts.Render("~/bundle/CheckSwitchJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")


}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Parámetros de consulta</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">

                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                @using (Html.BeginForm("GeneraReporteAntecedentesUsuario", "Reportes", FormMethod.Post, new { @class = "form-compact" }))
                {

                    <div class="panel-body">
                        @Html.Hidden("hf_CodigoPadre", new { @id = "hf_CodigoPadre" })
                        <div class="row">

                            <div class="col-xs-3 col-md-3 col-lg-3 text-left form-group obligatorio">
