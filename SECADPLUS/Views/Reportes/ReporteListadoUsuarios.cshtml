@{
    ViewBag.Title = "Listado de Usuarios";
}
@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/DateTimePickerJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Parámetros</h5>
                    <div class="heading-elements">
                        <ul class="icons-list ">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                @using (Html.BeginForm("GeneraReporteListadoUsuarios", "Reportes", FormMethod.Post, new { @class = "form-compact", target = "_blank" }))
                {
                    <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Sitio"> Sitios de Grabación 0 = Todos</label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("Sitio", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Entidad"> Entidad 0 = Todas</label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("Entidad", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group ">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Condicion"> Condición X = Todos</label>
                                    <div class="input-group col-md-12">
                                        @Html.DropDownList("Condicion", null, htmlAttributes: new { @class = "chosen-select col-md-12", @placeholder = "Seleccione..." })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group obligatorio">
                                <div class="col-lg-12 col-md-12">
                                    <label for="Responsable"> Firmante</label>
                                    <div class="input-group col-md-12">
                                        @Html.Editor("Responsable", new { htmlAttributes = new { @class = "form-control", @placeholder = "Indique el Responsable" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-4 col-md-4 col-lg-4 text-left form-group obligatorio">
                                <div class="col-lg-12 col-md-12">
                                    <label for="CargoResponsable"> Cargo Firma</label>
                                    <div class="input-group col-md-12">
                                        @Html.Editor("CargoResponsable", new { htmlAttributes = new { @class = "form-control", @placeholder = "Indique el Cargo" } })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip" id="btnGenerar" type="submit"
                                        title="" data-placement="bottom" data-original-title="Clic para generar el reporte">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Generar
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
@section PostScripts{
    <script>
        $(".chosen-select").chosen();

        $(function () {
            AplicarDateTimePlugin();
        });

        function AplicarDateTimePlugin() {
            $(".FechaHora").datetimepicker({
                format: 'DD/MM/YYYY HH:mm:ss',
                defaultDate: new Date(),
                showClear: true
            });
        }
    </script>
}


