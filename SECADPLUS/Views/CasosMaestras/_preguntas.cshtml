@model IEnumerable<SECADEntities.SECAD.CADPREGUNTASCASO>

@foreach (var item in Model)
{
    <tr>
        <td></td>
        <td>
            <ul class="icons-list">
                <li class="dropdown">
                    <button type="button" class="btn btn-tabla border-success text-success-600 btn-flat
                                                                dropdown-toggle" data-toggle="dropdown" aria-expanded="true">
                        <i class="icon-menu9"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-left">
                        <li>
                            <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para editar"
                                    onclick="window.location.href ='@Url.Action("EditP", new { idCaso=item.CADCASO_CODIGO, idPreg=item.CADPREG_CODIGO, nomCaso=item.CADCASO.DESCRIPCION })'">
                                <i class="glyphicon glyphicon-edit"></i> Editar
                            </button>
                        </li>
                        <li>
                            <button class="btn btn-xs btn-default" type="button" data-popup="tooltip"
                                    title="" data-placement="bottom" data-original-title="Clic para eliminar"
                                    onclick="EliminarRegistroGeneral('@Url.Action("EliminarP", "CasosMaestras", new { idCaso=item.CADCASO_CODIGO, idPreg=item.CADPREG_CODIGO, nomCaso=item.CADCASO.DESCRIPCION })')"> @*onclick="window.location.href ='@Url.Action("DeleteP", new { idCaso=item.CADCASO_CODIGO, idPreg=item.CADPREG_CODIGO, nomCaso=item.CADCASO.DESCRIPCION })'">*@
                                <i class="icon-trash"></i> Eliminar
                            </button>
                        </li>
                    </ul>
                </li>
            </ul>
        </td>
        <td>@Html.DisplayFor(modelItem => item.CADPREGUNTA.DESCRIPCION)</td>
        <td>@Html.DisplayFor(modelItem => item.ORDEN)</td>
        @*<td>@Html.CheckBox("VIGENTE", item.VIGENTE == "S" || item.VIGENTE == "A" ? true : false, new { @onchange = "ActualizarVigente('" + @item.CADCASO_CODIGO + "', " + @item.CADPREG_CODIGO + ", this)" })</td>*@
        <td>
            @* revisar, no creo que funcione *@
            @if (item.VIGENTE == "S")
            {
                <span class="label label-success">SI</span>
            }
            else
            {
                <span class="label label-danger">NO</span>
            }
        </td>
    </tr>
}