@model SECADEntities.SECAD.CADCASO

@{
    ViewBag.Title = "Crear Casos";
}

@section scripts{
    @Scripts.Render("~/bundle/ChosenJs")
    @Scripts.Render("~/bundle/FormularioJs")
    @Scripts.Render("~/bundle/InputsJs")
}
<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Crear Casos:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                @using (Html.BeginForm("Create", "CasosMaestras", FormMethod.Post, new { @class = "form-compact" }))
                {
                    <div class="panel-body">

                        <fieldset class="content-group">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="row">
                                <div class="col-md-12 col-lg-2">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Código:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.EditorFor(model => model.CODIGO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba código", maxlength = "6" } })
                                                    @Html.ValidationMessageFor(model => model.CODIGO, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-10">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Descripción:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.DESCRIPCION, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba descripción" } })
                                                @Html.ValidationMessageFor(model => model.DESCRIPCION, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-2">
                                    <div class="form-group">
                                        <label>Importancia:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="input-group">
                                                    @Html.EditorFor(model => model.IMPORTANCIA, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba importancia", maxlength = "3" } })
                                                    @Html.ValidationMessageFor(model => model.IMPORTANCIA, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-5">
                                    <div class="form-group">
                                        <label>Prioridad:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.DropDownList("PRIORIDAD", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                                    @Html.ValidationMessageFor(model => model.PRIORIDAD, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-5">
                                    <div class="form-group">
                                        <label>Tipo Uso Caso:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @Html.DropDownList("TIPO_USO", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                                    @Html.ValidationMessageFor(model => model.TIPO_USO, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                            <div class="panel-footer">
                                <div class="row">
                                    <div class="col-xs-6 col-md-6 text-left">
                                        <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                                data-original-title="Clic para regresar a la tabla"
                                                onclick="window.location.href ='@Url.Action("Index")'">
                                            <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                        </button>
                                    </div>
                                    <div class="col-xs-6 col-md-6 text-right">
                                        <button class="btn bg-teal" data-popup="tooltip"
                                                title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                                value="Create">
                                            <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                        </button>
                                    </div>
                                </div>
                            </div>
                    </div>
                }
                <!-- /formulario -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
<script>$(".chosen-select").chosen();</script>