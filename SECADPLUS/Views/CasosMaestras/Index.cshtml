@*@model IEnumerable<SECADEntities.SECAD.CADCASO>*@
@using SECADEntities.SECAD;
@model Tuple<List<CADCASO>, List<CADPREGUNTASCASO>>

@{
    ViewBag.Title = "Casos";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/ModalsJs")
}

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    @Html.Partial("_NavegacionAdmonGeneral")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Tabla de Casos:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo caso"
                                        onclick="window.location.href ='@Url.Action("Create")'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo caso
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaCasos">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Importancia</th>
                            <th>Prioridad</th>
                            <th>Tipo Uso Caso</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
        <!-- Preguntas -->
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Procedimientos y Preguntas Asociados</h5>
                    <div class="computo_input">
                        @Html.Hidden("COD_CASO")
                        @Html.Editor("NOM_CASO", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    </div>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para asociar preguntas"
                                        onclick="IrAsociarPreguntas(_idCaso, _nomCaso)">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Asociar preguntas
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tablaPreguntas">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Pregunta</th>
                            <th>Orden</th>
                            <th>Vigente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            Html.RenderPartial("_preguntas", Model.Item2);
                        }
                    </tbody>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
        <!-- /Titulos -->
    </div>
</div>
<!-- Área de contenido -->

<script type="text/javascript">
    var _idCaso = '@ViewBag.COD_CASO';
    var _nomCaso = '@ViewBag.NOM_CASO';

    var urlTabla = '@Url.Action("GetCasos", "CasosMaestras")';
    var urlCrear = '@Url.Action("CreateP", "CasosMaestras")';
    var urlPreguntas = '@Url.Action("GetPreguntas", "CasosMaestras")';


    /////////////////////Variables BreadCrumb/////////////////////////
    UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
    UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
    //////////////////////////////////////////////////////////////////


</script>
@Scripts.Render("~/bundle/CasosMaestrasJs")
