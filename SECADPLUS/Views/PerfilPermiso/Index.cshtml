@model IEnumerable<SECADEntities.SecadEntities.CADNETPERFIL_ELE_PERMISO>

@{
    ViewBag.Title = "Index";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")

}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Permisos</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip" onclick="location.href='@Url.Action("Create", "PerfilPermiso")'"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo Registro">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo Registro
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <table class="table table-hover table-xxs datatable-basic" id="tablaRolPerfil">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>
                                Perfil
                            </th>
                                                     
                            <th>
                                Elemento
                            </th>
                            <th>
                                Permiso
                            </th>
                            <th>
                                Fecha de creaci&oacute;n
                            </th>  
                            <th>
                                Estado
                            </th>

                        </tr>
                    </thead>
                    

                </table>
            </div>
        </div>
    </div>
</div>
@section PostScripts{
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/PnotifyJs")

    <script>
        var ObtenerRegistros = "@Url.Action("ObtenerRegistros","PerfilPermiso")";
        CargarTablaPermisos();
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
   
}
