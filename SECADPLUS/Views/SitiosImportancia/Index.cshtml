@model IEnumerable<SECADEntities.SECAD.V_FORM_SITIOS_GRABACION>

@{
    ViewBag.Title = "Sitio de Importancia";
}
@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
    @Scripts.Render("~/bundle/SitiosImportantesControllerJs")
    @Scripts.Render("~/bundle/ChosenJs")

}

<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <!-- Panel inicial con inputs -->
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat" id="panelSitiosGrabacion">
                <div class="panel-heading">
                    <h5 class="panel-title">Seleccione el sitio de grabación para las entidades SECAD 123:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li><a data-action="collapse" id="btnCollapseSitio"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tblSitiosGrabacion">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Consecutivo</th>
                            <th>Descripción</th>
                            <th>Departamento</th>
                            <th>Ciudad/Municipio</th>
                            <th>Fuerza</th>
                            <th>Código Unidad</th>
                            <th>Unidad</th>
                            <th>Fecha de instalación</th>
                            @*<th>Código regional</th>
                    <th>Regional</th>*@
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
        <div id="parqueaderos" class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-flat">
                        <div class="panel-heading">
                            <h5 class="panel-title">Parqueaderos para: <span id="titleParqueaderos"></span> </h5>
                            <div class="heading-elements">
                                <ul class="icons-list decad">
                                    <li>
                                        <button id="botonParqueaderos" onclick="CargaParqueaderos(idSitio)" class="btn btn-success btn-xs " data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para Recargar el Nivel">
                                            Recargar<b><i class="icon-reload-alt position-left"></i></b>

                                        </button>
                                    </li>
                                    <li><a data-action="collapse" id="btnCollapseParqueaderos"></a></li>
                                </ul>
                            </div>
                        </div>
                        <table class="table table-hover table-xxs datatable-basic" id="tblParqueaderos">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th>Nit/Código</th>
                                    <th>Descripción</th>
                                    <th>Ciudad/Mpio</th>
                                    <th>Barrio</th>
                                    <th>Dirección</th>
                                    <th>Teléfonos</th>
                                    <th>Horario</th>
                                    <th>Sitio de Grabación</th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div id="sitiosImportantes" class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    <div class="panel panel-flat">
                        <div class="panel-heading">
                            <h5 class="panel-title">Sitios para: </h5>
                            <div class="heading-elements">
                                <ul class="icons-list decad">
                                    <li>
                                        @*<button id="btnParqueaderos" class="btn btn-success btn-xs" data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para Recargar el Nivel">
                                                Recargar<b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>

                                            </button>*@
                                    </li>
                                    <li><a data-action="collapse" id="btnCollapseSitios"></a></li>
                                </ul>
                            </div>
                        </div>
                        <table class="table table-hover table-xxs datatable-basic" id="tblSitiosImportantes">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th></th>
                                    <th>Consecutivo</th>
                                    <th>Clase de Sitio</th>
                                    <th>Descripción</th>
                                    <th>Ciudad/Mpio</th>
                                    <th>Barrio</th>
                                    <th>Dirección</th>
                                    <th>Teléfonos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- /área de contenido -->

</div>

@section PostScripts{
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/SitiosGrabacionJs")
    <script>
        var UrlConsultarSitiosGrabacion = "@Url.Action("ConsultarSitiosGrabacion", "SitiosGrabacion")";
        urlActionBuscaParqueaderos = "@(Url.Action("VerParqueaderos", "SitiosImportancia"))";
        urlActionBuscaSitios = "@(Url.Action("VerSitiosImportantes", "SitiosImportancia"))";
        AplicarPluginTabla("tblSitios");
        ConsultarSitios("IMPORTANCIA");
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
}
