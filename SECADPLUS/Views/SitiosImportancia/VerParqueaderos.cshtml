@model IEnumerable<SECADEntities.SecadLugaresGeograficos.V_PARQUEADEROS>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h5 class="panel-title">Parqueaderos para: @ViewBag.sitio.DESCRIPCION</h5>
                <div class="heading-elements">
                    <ul class="icons-list decad">
                        <li>
                            <button id="btndepartamentos" onclick="CargaParqueaderos(@ViewBag.sitio.CONSECUTIVO);" class="btn btn-success btn-xs" data-popup="tooltip" title="" data-placement="bottom" data-original-title="Clic para Recargar el Nivel">
                                Recargar<b><i class="glyphicon glyphicon-refresh position-left"></i></b>

                            </button>
                        </li>
                        <li><a data-action="collapse" id="btnCollapseParqueaderos"></a></li>
                    </ul>
                </div>
            </div>
            <table class="table table-hover table-xxs datatable-basic" id="tblParqueaderos">
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Nit/Código</th>
                        <th>Descripción</th>
                        <th>Ciudad/Mpio</th>
                        <th>Barrio</th>
                        <th>Dirección</th>
                        <th>Teléfonos</th>
                        <th>Horario</th>
                        <th>Sitio de Grabación</th>
                    </tr>
                </thead>                
            </table>
        </div>
    </div>
</div>
@section PostScripts{
    @Scripts.Render("~/bundle/TablasJs")
    <script src="~/Scripts/custom/Tools.js"></script>
}