@model SECADEntities.SecadEntities.CADVISORPARAMETRO

@{
    ViewBag.Title = "Editar Parametro Visor Mapa";
}

<!-- Área de contenido -->
<div class="content">
    <div class="row">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Editar Parametro Visor Mapa:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Formulario -->
                @using (Html.BeginForm("Edit", "MapaParametros", FormMethod.Post, new { @class = "form-compact" }))
                {

                    <div class="panel-body">
                        <fieldset class="content-group">
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.Hidden("CODIGO")
                            @Html.Hidden("strUsuario")
                            @Html.Hidden("strCondicion")
                            <div class="row">
                                <div class="col-md-12 col-lg-3">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Usuario:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="form-group">
                                                    @*@Html.Editor("USUARIO", new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })*@
                                                    @Html.DropDownList("USUARIO", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                                    @Html.ValidationMessageFor(model => model.USUARIO, "", new { @class = "text-danger" })
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-3">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Tipo de Parametro:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.DropDownList("TIPO", null, string.Empty, htmlAttributes: new { @class = "chosen-select" })
                                                @Html.ValidationMessageFor(model => model.TIPO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-6">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Nombre:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.NOMBRE, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba la descripcion del parametro" } })
                                                @Html.ValidationMessageFor(model => model.NOMBRE, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-12">
                                    <div class="form-group obligatorio">
                                        <label class="control-label">Valor Parametro:</label>
                                        <div class="row">
                                            <div class="col-md-12">
                                                @Html.EditorFor(model => model.PARAMETRO, new { htmlAttributes = new { @class = "form-control", @placeholder = "Escriba vlr tiempo o url" } })
                                                @Html.ValidationMessageFor(model => model.PARAMETRO, "", new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                    <div class="panel-footer">
                        <div class="row">
                            <div class="col-xs-6 col-md-6 text-left">
                                <button type="button" class="btn bg-teal" data-popup="tooltip" title="" data-placement="bottom"
                                        data-original-title="Clic para regresar a la tabla"
                                        onclick="window.location.href ='@Url.Action("Index")'">
                                    <b><i class="glyphicon glyphicon-arrow-left position-left"></i></b>Regresar
                                </button>
                            </div>
                            <div class="col-xs-6 col-md-6 text-right">
                                <button class="btn bg-teal" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para guardar cambios"
                                        value="Edit">
                                    <b><i class="glyphicon glyphicon-save position-left"></i></b>Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <!-- /formulario -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->
@Scripts.Render("~/bundle/FormularioJs")
@Scripts.Render("~/bundle/InputsJs")
@Scripts.Render("~/bundle/ChosenJs")
<script>
    $(".chosen-select").chosen();

    $(document).ready(function () {
        $("#TIPO").change(function () {

            if ($("#TIPO option:selected").val() == "TIEMPO_RECARGA") {
                $("#NOMBRE").val('SEGUNDOS');
                $("#NOMBRE").prop('readonly', true);
            } else if ($("#TIPO option:selected").val() == "TIEMPO_DB_CONSULTA"){
                $("#NOMBRE").val('HORAS');
                $("#NOMBRE").prop('readonly', true);
            } else {
                $("#NOMBRE").val('');
                $("#NOMBRE").prop('readonly', false);
            }

        })
    });
</script>
