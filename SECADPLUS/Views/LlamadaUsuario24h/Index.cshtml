@*@model IEnumerable<SECADEntities.SECAD.CADREFERENCIASSECAD>*@

@{
    ViewBag.Title = "Llamadas Usuario 24H";
}

@section scripts{
    @Scripts.Render("~/bundle/TablasJs")
}
<!-- Área de contenido -->
<div class="content">
    <div class="row form-compact">
        <div class="col-md-12">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Llamadas Recibidas:</h5>
                    <div class="heading-elements">
                        <ul class="icons-list">
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tabla">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nume Llamada</th>
                            <th>Hora Caso</th>
                            <th>Nume Teléfono</th>
                            <th>Tipo Pedido</th>
                            <th>Nomb Llamante</th>
                            <th>Luge Código</th>
                            <th>Dire Caso</th>
                            <th>Comentario</th>
                            <th>Codi Ped.</th>
                            <th>Est.</th>
                            <th>Usuario</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
        </div>
    </div>
</div>
<!-- /área de contenido -->

@section PostScripts{
    <script>
        var globalUsuario = '@ViewBag.globalUsuario';

        var urlTabla = '@Url.Action("VerPedidos", "LlamadaUsuario24h")';
    </script>

    @Scripts.Render("~/bundle/LlamadaUsuario24hJs")

}