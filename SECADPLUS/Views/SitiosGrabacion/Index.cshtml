@{
    ViewBag.Title = "Sitio de Grabación";
}
@section scripts{    @Scripts.Render("~/bundle/TablasJs")
}
<!-- Área de contenido -->
<div class="content">
    @Html.Partial("_Mensajes")
    <div class="row form-compact">
        <div class="col-md-12">
            <!-- Panel con Tablas -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Sitios en los cuales se ha instalado el SECAD 123</h5>
                    <div class="heading-elements">
                        <ul class="icons-list decad">
                            <li>
                                <button type="button" class="btn btn-success btn-xs" data-popup="tooltip"
                                        title="" data-placement="bottom" data-original-title="Clic para crear nuevo sitio"
                                        onclick="window.location.href ='@Url.Action("Create")'">
                                    <b><i class="glyphicon glyphicon-plus-sign position-left"></i></b>Crear nuevo sitio
                                </button>
                            </li>
                            <li><a data-action="collapse"></a></li>
                        </ul>
                    </div>
                </div>
                <!-- Inicio de tabla -->
                <table class="table table-hover table-xxs datatable-basic" id="tblSitiosGrabacion">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Acciones</th>
                            <th>Consecutivo</th>
                            <th>Descripción</th>
                            <th>Departamento</th>
                            <th>Ciudad/Municipio</th>
                            <th>Fuerza</th>
                            <th>Código Unidad</th>
                            <th>Unidad</th>
                            <th>Fecha de instalación</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                </table>
                <!-- /inicio de tabla -->
            </div>
            <!-- /panel con Tablas -->
        </div>
    </div>
</div>
@section PostScripts{
    @Scripts.Render("~/bundle/ModalsJs")
    @Scripts.Render("~/bundle/SitiosGrabacionJs")
    <script>
        var UrlConsultarSitiosGrabacion = "@Url.Action("ConsultarSitiosGrabacion", "SitiosGrabacion")";
        AplicarPluginTabla("tabla");
        ConsultarSitios();
        /////////////////////Variables BreadCrumb/////////////////////////
        UrlComplementoRuta = "@ViewBag.RutaCompGeneral";
        UrlNombreUbicacion = "@ViewBag.NombreUbicacion";
        //////////////////////////////////////////////////////////////////
    </script>
}